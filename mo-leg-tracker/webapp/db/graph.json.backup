        "updatedAt": "2026-01-19T20:17:55.522Z"
      },
      "bill:sb1173:261": {
        "billNumber": "SB 1173",
        "billPrefix": "SB",
        "billSuffix": 1173,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the number of hours of racial profiling training required during the basic training for licensed peace officers",
        "briefDescription": "This act provides that peace officers first licensed on or after August 28, 2027, shall receive at least nine, instead of six, hours in the initial academy training focused on racial profiling training, implicit bias training, and de-escalation training.",
        "lrNumber": "5407S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
