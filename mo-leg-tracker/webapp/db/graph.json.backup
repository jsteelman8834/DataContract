      "bill:sb1489:261": {
        "billNumber": "SB 1489",
        "billPrefix": "SB",
        "billSuffix": 1489,
        "session": "261",
        "chamber": "senate",
        "title": "Permits over-the-counter purchase of ivermectin and hydroxycholorquine tablets without a prescription",
        "briefDescription": "Under this act, ivermectin and hydroxychloroquine tablets suitable for human use may be sold or purchased as over-the-counter medications in Missouri without a prescription or consultation with a pharmacist or other health care professional.",
        "lrNumber": "6142S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
