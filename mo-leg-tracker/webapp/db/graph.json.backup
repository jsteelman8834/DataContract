      "bill:sb916:261": {
        "billNumber": "SB 916",
        "billPrefix": "SB",
        "billSuffix": 916,
        "session": "261",
        "chamber": "senate",
        "title": "Provides sovereign immunity for private contractors acting within the scope of a government contract",
        "briefDescription": "This act provides that private contractors and subcontractors when acting within the scope of a government contract with the Missouri Department of Transportation (\"Department\") shall have the same sovereign or governmental tort immunity as a public entity. The immunity shall commence upon the official notice to proceed and continue after the Department formally accepts the completed project.",
