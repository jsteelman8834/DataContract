        "billSuffix": 928,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to criminal offenses, including 48-hour holds, assault, domestic violence, stalking, and violations of no contact orders",
        "briefDescription": "This act modifies provisions relating to criminal offenses.",
        "lrNumber": "5463S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
