      "bill:sb971:261": {
        "billNumber": "SB 971",
        "billPrefix": "SB",
        "billSuffix": 971,
        "session": "261",
        "chamber": "senate",
        "title": "Creates, modifies, and repeals provisions relating to student transfers to nonresident districts",
        "briefDescription": "Current law authorizes students who reside in an unaccredited school district to transfer to an accredited school district in the same or an adjoining county under certain conditions.  This act repeals and modifies provisions limiting these transfers to students in unaccredited school districts.  Under the act, any student may transfer to another public school, including transfers from a student's district of residence, or \"sending district\", to a public school in a nonresident district, or \"rec",
        "lrNumber": "4698S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "157",
        "id": "bill:sb971:261",
        "createdAt": "2026-01-16T22:13:43.259Z",
        "updatedAt": "2026-01-19T20:04:30.113Z"
      },
      "bill:sb972:261": {
        "billNumber": "SB 972",
        "billPrefix": "SB",
        "billSuffix": 972,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to railroad crossings",
        "briefDescription": "This act provides that any at grade railroad crossing constructed on or after August 28, 2026, shall include advanced detection and monitoring systems, as defined in the act, that are capable of detecting and classifying objects along the crossing and its approaches; of analyzing object behavior in real time to identify safety risks; of generating real-time alerts to warn train crews, operations personnel, and other relevant parties of potential hazards; and of providing integration capability w",
        "lrNumber": "5506S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-20",
        "withdrawn": false,
        "senateBillId": "160",
        "id": "bill:sb972:261",
        "createdAt": "2026-01-16T22:13:47.256Z",
        "updatedAt": "2026-01-19T20:04:32.110Z"
      },
      "bill:sb973:261": {
        "billNumber": "SB 973",
        "billPrefix": "SB",
        "billSuffix": 973,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to certain disclosures by a real estate wholesaler",
        "briefDescription": "Under the act, before entering into a contract that transfers an interest in residential real property, a wholesaler, as defined in the act, acting as a grantee or a wholesaler's representative, shall provide to the property owner a written disclosure. Requirements for the disclosure are described in the act.",
        "lrNumber": "4981S.02I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:general_laws",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-14",
        "withdrawn": false,
        "senateBillId": "321",
        "id": "bill:sb973:261",
        "createdAt": "2026-01-16T22:13:51.282Z",
        "updatedAt": "2026-01-19T20:04:34.122Z"
      },
      "bill:sb974:261": {
        "billNumber": "SB 974",
        "billPrefix": "SB",
        "billSuffix": 974,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to compensation for services rendered in veteran benefits matters",
        "briefDescription": "This act provides that no person shall receive compensation for referring an individual to another person to advise or assist the individual with any veterans benefits matter, which is described in the act. Additionally, no person shall receive compensation for any services rendered in connection with any claim filed within the one-year presumptive period of active-duty release.",
        "lrNumber": "5639S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:veterans_and_military_affairs",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "374",
        "id": "bill:sb974:261",
        "createdAt": "2026-01-16T22:13:55.295Z",
        "updatedAt": "2026-01-19T20:04:36.118Z"
      },
      "bill:sb975:261": {
        "billNumber": "SB 975",
        "billPrefix": "SB",
        "billSuffix": 975,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to ambulance districts",
        "briefDescription": "This act modifies provisions relating to ambulance districts.",
        "lrNumber": "5215S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
