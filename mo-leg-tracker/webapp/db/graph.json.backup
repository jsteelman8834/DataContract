      "bill:sb1130:261": {
        "billNumber": "SB 1130",
        "billPrefix": "SB",
        "billSuffix": 1130,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits state colleges and universities from employing individuals or engaging contractors who hold H-1B nonimmigrant status",
        "briefDescription": "This act prohibits state colleges and universities from employing any individual who holds H-1B nonimmigrant status, defined in the act as an \"H-1B visa\".  State colleges and universities are also prohibited from engaging the services of any contractor owned by an individual who possesses an H-1B visa or that employs an individual who holds an H-1B visa.",
        "lrNumber": "4796S.01I",
