      "bill:sb1386:261": {
        "billNumber": "SB 1386",
        "billPrefix": "SB",
        "billSuffix": 1386,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Uniform Interstate Depositions and Discovery Act",
        "briefDescription": "This act establishes the Uniform Interstate Depositions and Discovery Act, which provides procedures for out-of-state subpoenas for certain forms of discovery conducted in Missouri.",
        "lrNumber": "5661S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
