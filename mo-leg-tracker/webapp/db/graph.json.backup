        "createdAt": "2026-01-16T22:24:14.465Z",
        "updatedAt": "2026-01-19T20:14:40.763Z"
      },
      "bill:sb1126:261": {
        "billNumber": "SB 1126",
        "billPrefix": "SB",
        "billSuffix": 1126,
        "session": "261",
        "chamber": "senate",
        "title": "Requires the Commissioner of Administration to report on state property that have been abandoned and authorizes the Governor to convey such properties",
        "briefDescription": "This act requires the Commissioner of Administration to submit an annual report to the General Assembly detailing each parcel of state property that has been abandoned or not utilized during the three year period ending on August 28th of such year.  The Governor is authorized to convey any such state property identified in the report.",
        "lrNumber": "4261S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:government_efficiency",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "601",
        "id": "bill:sb1126:261",
        "createdAt": "2026-01-16T22:24:18.483Z",
        "updatedAt": "2026-01-19T20:14:42.778Z"
      },
      "bill:sb1127:261": {
        "billNumber": "SB 1127",
        "billPrefix": "SB",
        "billSuffix": 1127,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to funds in the state treasury",
        "briefDescription": "This act requires the State Treasurer to submit an annual report to the General Assembly detailing each fund established in the state treasury from which a disbursement has not been made during the five year period ending on June thirtieth of such year, and whether or not any remaining moneys in such funds have been transferred to the General Revenue fund pursuant to current law. (Section 33.082)",
        "lrNumber": "4353S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:government_efficiency",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "602",
        "id": "bill:sb1127:261",
        "createdAt": "2026-01-16T22:24:22.501Z",
        "updatedAt": "2026-01-19T20:14:44.778Z"
      },
      "bill:sb1128:261": {
