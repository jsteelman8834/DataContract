      "bill:sb922:261": {
        "billNumber": "SB 922",
        "billPrefix": "SB",
        "billSuffix": 922,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the offense of unlawful possession of a firearm by a minor",
        "briefDescription": "This act creates the offense of unlawful possession of a firearm by a minor.  A person under the age of 18 commits such offense if he or she knowingly possesses a handgun or ammunition for a handgun.  This offense shall be a class A misdemeanor.",
        "lrNumber": "5462S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
