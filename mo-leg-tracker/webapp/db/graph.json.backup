      "bill:sb1349:261": {
        "billNumber": "SB 1349",
        "billPrefix": "SB",
        "billSuffix": 1349,
        "session": "261",
        "chamber": "senate",
        "title": "Creates a prohibition on licensing requirements for certain industrial mechanical maintenance work",
        "briefDescription": "This act provides that any contractor performing maintenance of mechanical systems or equipment within an industrial facility, as described in the act, shall not be required to obtain a local or state license to perform such work.",
        "lrNumber": "5044S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "261",
        "id": "bill:sb1349:261",
        "createdAt": "2026-01-16T22:39:13.545Z",
        "updatedAt": "2026-01-19T20:29:52.048Z"
      },
      "bill:sb1350:261": {
        "billNumber": "SB 1350",
        "billPrefix": "SB",
        "billSuffix": 1350,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to insurance coverage of alternatives to opioid drugs",
        "briefDescription": "This act provides that an enrollee's health benefit plan shall not deny coverage of a nonopioid prescription drug in favor of an opioid drug, require the enrollee to try an opioid drug before covering the nonopioid prescription drug, or require a higher level of cost-sharing for a nonopioid prescription drug than for an opioid drug.",
        "lrNumber": "5329S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "179",
        "id": "bill:sb1350:261",
        "createdAt": "2026-01-16T22:39:17.556Z",
        "updatedAt": "2026-01-19T20:29:54.049Z"
      },
      "bill:sb1351:261": {
        "billNumber": "SB 1351",
        "billPrefix": "SB",
        "billSuffix": 1351,
        "session": "261",
        "chamber": "senate",
        "title": "Changes the term of office for members of the Independence School District school board",
        "briefDescription": "This act changes the term of office for members of the Independence School District school board from six years to three years.",
        "lrNumber": "3832S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "180",
        "id": "bill:sb1351:261",
        "createdAt": "2026-01-16T22:39:21.572Z",
        "updatedAt": "2026-01-19T20:29:56.065Z"
      },
      "bill:sb1352:261": {
        "billNumber": "SB 1352",
        "billPrefix": "SB",
        "billSuffix": 1352,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the offense of animal abuse",
        "briefDescription": "Currently, the offense of animal abuse is a class E felony if the purposeful or intentional injury or suffering of an animal",
        "lrNumber": "5157S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "181",
        "id": "bill:sb1352:261",
        "createdAt": "2026-01-16T22:39:25.576Z",
        "updatedAt": "2026-01-19T20:29:58.071Z"
      },
      "bill:sb1353:261": {
        "billNumber": "SB 1353",
        "billPrefix": "SB",
        "billSuffix": 1353,
        "session": "261",
        "chamber": "senate",
        "title": "Requires school districts to include the amount expended for legal services in their Annual Secretary of the Board Report",
        "briefDescription": "This act requires school districts to include the amount expended for legal services in their Annual Secretary of the Board Report.  If the report does not include the amount expended for legal services, then the attorney general may investigate the violation of this subdivision and may bring a civil action, including an action for injunctive relief, against the school district.  Such action shall be brought in the county where the school district is located.",
        "lrNumber": "5162S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "506",
        "id": "bill:sb1353:261",
        "createdAt": "2026-01-16T22:39:29.603Z",
        "updatedAt": "2026-01-19T20:30:00.085Z"
      },
      "bill:sb1354:261": {
        "billNumber": "SB 1354",
        "billPrefix": "SB",
        "billSuffix": 1354,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the enforcement of child custody and visitation orders",
        "briefDescription": "Currently, a court order for the custody of, or visitation with, a child may include a provision that the sheriff or other law enforcement shall enforce the rights of any person to custody or visitation.  This act requires that such provision be included in custody or visitation orders.",
        "lrNumber": "4901S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "507",
        "id": "bill:sb1354:261",
        "createdAt": "2026-01-16T22:39:33.597Z",
        "updatedAt": "2026-01-19T20:30:02.108Z"
      },
      "bill:sb1355:261": {
        "billNumber": "SB 1355",
        "billPrefix": "SB",
        "billSuffix": 1355,
        "session": "261",
        "chamber": "senate",
        "title": "Allows for certain motor vehicles to be registered permanently",
        "briefDescription": "This act provides that nonapportioned motor vehicles may be permanently registered upon payment of seven times the applicable annual fees and presentation of all documents otherwise required by law to register the vehicle annually.",
        "lrNumber": "5189S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "508",
        "id": "bill:sb1355:261",
        "createdAt": "2026-01-16T22:39:37.612Z",
        "updatedAt": "2026-01-19T20:30:04.105Z"
      },
      "bill:sb1356:261": {
        "billNumber": "SB 1356",
        "billPrefix": "SB",
        "billSuffix": 1356,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to criminal records",
        "briefDescription": "This act requires that closed criminal records shall be destroyed within six months of being closed. Additionally, arrest records shall be closed and shall be inaccessible to the general public.",
        "lrNumber": "4755S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "659",
        "id": "bill:sb1356:261",
        "createdAt": "2026-01-16T22:39:41.618Z",
        "updatedAt": "2026-01-19T20:30:06.164Z"
      },
      "bill:sb1357:261": {
        "billNumber": "SB 1357",
        "billPrefix": "SB",
        "billSuffix": 1357,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to earned discharge from probation",
        "briefDescription": "Under current law, certain offenders may receive earned compliance credits to reduce their term of probation, parole, or conditional release. This act repeals those provisions and provides that the Division of Probation and Parole (\"Division\") shall file a notification of earned discharge from probation with the court for any defendant who has completed at least 24 months of the probation term and is compliant with the terms of supervision as ordered by the court and Division. The Division shall",
        "lrNumber": "4757S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "660",
        "id": "bill:sb1357:261",
        "createdAt": "2026-01-16T22:39:45.624Z",
        "updatedAt": "2026-01-19T20:30:08.146Z"
      },
      "bill:sb1358:261": {
        "billNumber": "SB 1358",
        "billPrefix": "SB",
        "billSuffix": 1358,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to terms of probation",
        "briefDescription": "Under current law, the term of probation for a misdemeanor violation is not to exceed two years. This act provides that the term of probation for a misdemeanor violation or municipal ordinance violation is not to exceed eighteen months.",
        "lrNumber": "4761S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "661",
        "id": "bill:sb1358:261",
        "createdAt": "2026-01-16T22:39:49.658Z",
        "updatedAt": "2026-01-19T20:30:10.111Z"
      },
      "bill:sb1359:261": {
        "billNumber": "SB 1359",
        "billPrefix": "SB",
        "billSuffix": 1359,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions relating to release of certain liabilities for unauthorized or negligent disclosure of biometric identifiers or information",
        "briefDescription": "This act provides that a private entity in possession of biometric identifiers or biometric information shall not be liable for damages for the unauthorized or negligent disclosure of biometric identifiers or biometric information if the private entity:",
        "lrNumber": "3364S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "159",
        "id": "bill:sb1359:261",
        "createdAt": "2026-01-16T22:39:53.652Z",
        "updatedAt": "2026-01-19T20:30:32.213Z"
      },
      "bill:sb1360:261": {
        "billNumber": "SB 1360",
        "billPrefix": "SB",
        "billSuffix": 1360,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Civil Liability for Employers Hiring Ex-Offenders Act, which provides liability protections for employers hiring those convicted of certain offenses",
        "briefDescription": "This act establishes the \"Civil Liability for Employers Hiring Ex-Offenders Act\" which provides that a cause of action shall not be brought against an employer, general contractor, premises owner, or other third party for hiring an employee or independent contractor who has been convicted of an offense, excluding certain violent and sexual offenses listed in the act.",
        "lrNumber": "5003S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "153",
        "id": "bill:sb1360:261",
        "createdAt": "2026-01-16T22:39:57.672Z",
        "updatedAt": "2026-01-19T20:30:34.192Z"
      },
      "bill:sb1361:261": {
        "billNumber": "SB 1361",
        "billPrefix": "SB",
        "billSuffix": 1361,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the Second Amendment Financial Privacy Act",
        "briefDescription": "This act creates the \"Second Amendment Financial Privacy Act\".",
        "lrNumber": "4697S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "165",
        "id": "bill:sb1361:261",
        "createdAt": "2026-01-16T22:40:01.692Z",
        "updatedAt": "2026-01-19T20:30:36.209Z"
      },
      "bill:sb1362:261": {
        "billNumber": "SB 1362",
        "billPrefix": "SB",
        "billSuffix": 1362,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to food labeling",
        "briefDescription": "Currently, the manufacture, sale, or delivery of misbranded foods in Missouri, as described in statute, shall be prohibited.  This act modifies the description of misbranded foods to include: (1) products containing any bioengineered substance or natural flavoring, unless the product's labeling contains a website link or QR code identifying the bioengineered substance or specific natural flavoring; (2) edible coatings on fruits or vegetables, unless the label of such food or any display placed a",
        "lrNumber": "4678S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "348",
        "id": "bill:sb1362:261",
        "createdAt": "2026-01-16T22:40:05.705Z",
        "updatedAt": "2026-01-19T20:30:38.217Z"
      },
      "bill:sb1363:261": {
        "billNumber": "SB 1363",
        "billPrefix": "SB",
        "billSuffix": 1363,
        "session": "261",
        "chamber": "senate",
        "title": "Creates new provision relating to joint employers",
        "briefDescription": "This act provides that neither a franchisee nor a franchisee's employees shall be considered employees of a franchisor for any purpose unless the franchisor exercises direct and immediate control over the hiring, termination, discipline, and direction of the employees of a franchisee.",
        "lrNumber": "5374S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "349",
        "id": "bill:sb1363:261",
        "createdAt": "2026-01-16T22:40:09.703Z",
        "updatedAt": "2026-01-19T20:30:40.258Z"
      },
      "bill:sb1364:261": {
        "billNumber": "SB 1364",
        "billPrefix": "SB",
        "billSuffix": 1364,
        "session": "261",
        "chamber": "senate",
        "title": "Requires the Governor to appoint a board of directors to oversee any statewide activities association that facilitates interscholastic activities for secondary school students",
        "briefDescription": "Under this act, any nonprofit statewide association that facilitates interscholastic activities for secondary school students and that includes at least one public school district as a fee-paying member (defined as an \"activities association\") shall be overseen by a board of three directors appointed by the Governor, by and with the advice and consent of the Senate.  The term of office of each director shall be four years.  If the General Assembly is not in session when a position on the board o",
        "lrNumber": "5502S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "350",
        "id": "bill:sb1364:261",
        "createdAt": "2026-01-16T22:40:13.775Z",
        "updatedAt": "2026-01-19T20:30:42.237Z"
      },
      "bill:sb1365:261": {
        "billNumber": "SB 1365",
        "billPrefix": "SB",
        "billSuffix": 1365,
        "session": "261",
        "chamber": "senate",
        "title": "Requires lodging establishments and short-term rental properties to provide human trafficking awareness training to its employees and report suspected human trafficking",
        "briefDescription": "This act requires employees of lodging establishments and operators of short-term rental properties to receive annual human trafficking awareness training.  The operator of the lodging establishment or short-term rental property shall be responsible for maintaining records of the training for periods of time as described in the act.  Further, each operator shall establish procedures and policies for the reporting of suspected human trafficking to the National Human Trafficking Hotline or a local",
        "lrNumber": "5179S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "226",
        "id": "bill:sb1365:261",
        "createdAt": "2026-01-16T22:40:17.775Z",
        "updatedAt": "2026-01-19T20:30:44.249Z"
      },
      "bill:sb1366:261": {
        "billNumber": "SB 1366",
        "billPrefix": "SB",
        "billSuffix": 1366,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to county treasurers",
        "briefDescription": "This act provides that the county treasurer's signature shall be the only signature authorized or permitted on any bank signature card, deposit agreement, or other authorization document for any account maintained in a county depositary for county funds under the treasurer's custody. No other county official or employee shall be authorized or required to be listed as a signer on any such account.",
        "lrNumber": "5134S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "227",
        "id": "bill:sb1366:261",
        "createdAt": "2026-01-16T22:40:21.775Z",
        "updatedAt": "2026-01-19T20:30:46.251Z"
      },
      "bill:sb1367:261": {
        "billNumber": "SB 1367",
        "billPrefix": "SB",
        "billSuffix": 1367,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to hospitals with emergency departments",
        "briefDescription": "Under this act, a hospital with an emergency department shall have at least one physician on site and on duty who is responsible for the emergency department at all times the emergency department is open.",
        "lrNumber": "5568S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "228",
        "id": "bill:sb1367:261",
        "createdAt": "2026-01-16T22:40:25.771Z",
        "updatedAt": "2026-01-19T20:30:48.247Z"
      },
      "bill:sb1368:261": {
        "billNumber": "SB 1368",
        "billPrefix": "SB",
        "billSuffix": 1368,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to weather modification",
        "briefDescription": "The act creates new provisions relating to weather modification.",
        "lrNumber": "5337S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "171",
        "id": "bill:sb1368:261",
        "createdAt": "2026-01-16T22:40:29.768Z",
        "updatedAt": "2026-01-19T20:30:50.266Z"
      },
      "bill:sb1369:261": {
        "billNumber": "SB 1369",
        "billPrefix": "SB",
        "billSuffix": 1369,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to motorcycle operation",
        "briefDescription": "This act specifies that motorcycle operators may overtake and pass vehicles in the same lane occupied by the vehicle being overtaken, or between the lanes of two vehicles being overtaken, so long as the motorcycle is traveling at a speed of not more than 10 miles per hour over the speed of traffic and not more than 25 miles per hour total.",
        "lrNumber": "3840S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "172",
        "id": "bill:sb1369:261",
        "createdAt": "2026-01-16T22:40:33.811Z",
        "updatedAt": "2026-01-19T20:31:12.371Z"
      },
      "bill:sb1370:261": {
        "billNumber": "SB 1370",
        "billPrefix": "SB",
        "billSuffix": 1370,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions regarding adult eligibility for virtual school courses and programs",
        "briefDescription": "This act establishes provisions regarding adult eligibility for virtual school courses and programs.  An \"adult student\" is defined as a Missouri resident over 21 years of age who has not yet earned a high school diploma but is within 12 academic credits or 2 school years of achieving such a diploma.",
        "lrNumber": "5182S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "509",
        "id": "bill:sb1370:261",
        "createdAt": "2026-01-16T22:40:37.797Z",
        "updatedAt": "2026-01-19T20:31:14.372Z"
      },
      "bill:sb1371:261": {
        "billNumber": "SB 1371",
        "billPrefix": "SB",
        "billSuffix": 1371,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to child custody arrangements",
        "briefDescription": "This act modifies the definition of \"joint legal custody\" as used in child custody determinations to remove references to allocating, apportioning, or decreeing a division of joint decision-making, responsibilities, and authority between the parents.  This act also modifies the definition of \"joint physical custody\" to change the amount of time with the child awarded to each parent from \"significant, but not necessarily equal\" to \"equal or substantially equal\".",
        "lrNumber": "5153S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "510",
        "id": "bill:sb1371:261",
        "createdAt": "2026-01-16T22:40:41.881Z",
        "updatedAt": "2026-01-19T20:31:16.410Z"
      },
      "bill:sb1372:261": {
        "billNumber": "SB 1372",
        "billPrefix": "SB",
        "billSuffix": 1372,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the \"No Shari'a Act\" relating to the enforceability of certain foreign laws",
        "briefDescription": "This act creates the \"No Shari'a Act\".  No court shall enforce a judgment, decree, or arbitration decision if it relies on Shari'a or any foreign law that violates the constitutional rights of any party.  A contract provision choosing foreign law shall be valid  unless enforcement would result in a violation of constitutional rights.  Finally, in family law matters, no court shall apply or enforce foreign law if inconsistent with fundamental rights or public policy.",
        "lrNumber": "5830S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "581",
        "id": "bill:sb1372:261",
        "createdAt": "2026-01-16T22:40:45.846Z",
        "updatedAt": "2026-01-19T20:31:18.387Z"
      },
      "bill:sb1373:261": {
        "billNumber": "SB 1373",
        "billPrefix": "SB",
        "billSuffix": 1373,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to voter registration",
        "briefDescription": "This act prohibits the Secretary of State and local election authorities from removing any registered voter from either the Missouri Voter Registration System or the list of registered voters unless, among other criteria, the voter has not voted in the previous five calendar years.",
        "lrNumber": "4249S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "662",
        "id": "bill:sb1373:261",
        "createdAt": "2026-01-16T22:40:49.860Z",
