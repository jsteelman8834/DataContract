        "billSuffix": 1147,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to insurance coverage for mental health treatments",
        "briefDescription": "This act provides that health benefit plans shall not impose greater cost-sharing requirements for certain treatment of behavioral or mental health conditions if a hospital is out-of-network, as provided in the act, and that the health carrier shall reimburse the out-of-network hospital for the treatment at the same rate as the hospital would be reimbursed by MO HealthNet or Medicare, whichever is greater.",
        "lrNumber": "5475S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:insurance_and_banking",
