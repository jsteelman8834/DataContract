        "updatedAt": "2026-01-19T20:34:43.162Z"
      },
      "bill:sb1425:261": {
        "billNumber": "SB 1425",
        "billPrefix": "SB",
        "billSuffix": 1425,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies a provision relating to a tax credit for new business facilities",
        "briefDescription": "Current law authorizes a tax credit for a 10-year period for business headquarters that commence operations in this state on or before December 31, 2030. This act extends such date to December 31, 2040.",
        "lrNumber": "5851S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "10335",
        "id": "bill:sb1425:261",
        "createdAt": "2026-01-16T22:44:18.555Z",
        "updatedAt": "2026-01-19T20:34:45.157Z"
      },
      "bill:sb1426:261": {
        "billNumber": "SB 1426",
        "billPrefix": "SB",
        "billSuffix": 1426,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to towing of commercial vehicles",
        "briefDescription": "This act requires the Department of Transportation to establish procedures to address nonconsensual towing, recovery, and cleanup practices related to the removal of commercial vehicles from roadways, as described in the act. Such procedures shall include a process for the filing and review of complaints against a towing company, factors the Department shall consider in determining whether a charge was fair and reasonable, requirements for information to be included on nonconsensual towing invoi",
        "lrNumber": "6034S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "10336",
        "id": "bill:sb1426:261",
        "createdAt": "2026-01-16T22:44:22.563Z",
        "updatedAt": "2026-01-19T20:34:47.178Z"
      },
      "bill:sb1427:261": {
        "billNumber": "SB 1427",
        "billPrefix": "SB",
        "billSuffix": 1427,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals certain provisions relating to water contaminants",
        "briefDescription": "Currently, it shall be unlawful for any person to operate, use or maintain any water contaminant unless the person holds an operating permit, or for a person to operate, use or maintain and discharge water contaminants from any water contaminant unless the person holds a permit. The act repeals these provisions.",
        "lrNumber": "5875S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "10337",
        "id": "bill:sb1427:261",
        "createdAt": "2026-01-16T22:44:26.574Z",
        "updatedAt": "2026-01-19T20:34:49.176Z"
      },
      "bill:sb1428:261": {
        "billNumber": "SB 1428",
        "billPrefix": "SB",
        "billSuffix": 1428,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits educational institutions from mandating COVID-19 vaccines or gene therapy treatments",
        "briefDescription": "Beginning with the 2026-27 school or academic year, this act prohibits school districts, public schools, and certain institutions of higher education, as well as employees of such entities, from requiring any employee or student to receive a COVID-19 vaccine or gene therapy in order to be physically present at any events, premises, or facilities.  A vaccine shall not be required as a condition for employment or for acceptance as a student.  Testing for COVID-19 shall not be done without the writ",
        "lrNumber": "6049S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "10338",
        "id": "bill:sb1428:261",
        "createdAt": "2026-01-16T22:44:30.590Z",
        "updatedAt": "2026-01-19T20:34:51.182Z"
      },
      "bill:sb1429:261": {
        "billNumber": "SB 1429",
        "billPrefix": "SB",
        "billSuffix": 1429,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to withholding tax returns",
        "briefDescription": "Current law requires withholding tax returns to be submitted electronically by employers with at least two hundred fifty employees. Beginning January 1, 2026, this act requires such electronic returns for employers with an amount of employees that meets or exceeds the threshold provided in federal law.",
        "lrNumber": "6181S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19769",
        "id": "bill:sb1429:261",
        "createdAt": "2026-01-16T22:44:34.615Z",
        "updatedAt": "2026-01-19T20:35:13.262Z"
      },
      "bill:sb1430:261": {
        "billNumber": "SB 1430",
        "billPrefix": "SB",
        "billSuffix": 1430,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies and creates new provisions relating to regulation of certain metals",
        "briefDescription": "The act creates and modifies provisions relating to regulation of certain metals.",
        "lrNumber": "6019S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19767",
