      "bill:sb1290:261": {
        "billNumber": "SB 1290",
        "billPrefix": "SB",
        "billSuffix": 1290,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"Missouri Healthy Schools Act\" and prohibits public schools from serving, selling, or allowing a third party to sell ultraprocessed food during the school day",
        "briefDescription": "This act establishes the \"Missouri Healthy Schools Act\" and prohibits public schools from serving, selling, or allowing a third party to sell ultraprocessed food, as such term is defined in the act, on campus during the school day.  The Department of Elementary and Secondary Education shall post on its website a standardized form public schools may use to certify compliance with the provisions of the act, along with a list of each public school that has provided such certification of compliance ",
        "lrNumber": "4339S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
