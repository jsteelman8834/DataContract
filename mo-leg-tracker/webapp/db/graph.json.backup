      "bill:sb944:261": {
        "billNumber": "SB 944",
        "billPrefix": "SB",
        "billSuffix": 944,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the salary for the attorney of the sheriff of St. Louis City",
        "briefDescription": "Current law provides that the attorney for the sheriff of the City of St. Louis shall receive compensation in the amount of not less than $3,000 and not more than $15,000 per year. This act provides that the compensation range shall be from $15,000 to $75,000 per year.",
        "lrNumber": "4889S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
