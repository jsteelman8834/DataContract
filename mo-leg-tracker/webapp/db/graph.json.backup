      "bill:sb976:261": {
        "billNumber": "SB 976",
        "billPrefix": "SB",
        "billSuffix": 976,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to candidate committees",
        "briefDescription": "Current law requires any person who registers as a lobbyist to dissolve any candidate committee the person may have in existence. This act allows any person who has registered as a lobbyist and also has a candidate committee for the purpose of seeking a county, municipal, or school board office to maintain the candidate committee, provided the person is not lobbying the county, municipality, or school board for which the candidate committee is designated to seek office.",
        "lrNumber": "5436S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "376",
        "id": "bill:sb976:261",
        "createdAt": "2026-01-16T22:14:03.319Z",
        "updatedAt": "2026-01-19T20:04:40.137Z"
      },
      "bill:sb977:261": {
        "billNumber": "SB 977",
        "billPrefix": "SB",
        "billSuffix": 977,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"No Shari'a Law\" which prohibits the application and enforceability of foreign law, legal codes, and systems",
        "briefDescription": "This act establishes the \"No Shari'a Act\" which prohibits  the application and enforceability of Shari'a law or any foreign law, legal code, or system that denies the parties the fundamental liberties, rights, and privileges guaranteed under the Constitution of the United States or the Constitution of Missouri.",
        "lrNumber": "5434S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-14",
        "withdrawn": false,
        "senateBillId": "327",
        "id": "bill:sb977:261",
        "createdAt": "2026-01-16T22:14:07.324Z",
        "updatedAt": "2026-01-19T20:04:42.139Z"
      },
      "bill:sb978:261": {
        "billNumber": "SB 978",
        "billPrefix": "SB",
        "billSuffix": 978,
        "session": "261",
        "chamber": "senate",
        "title": "Requires school districts and charter schools to provide instruction on human growth and development",
        "briefDescription": "Beginning in the 2026-27 school year and continuing in subsequent school years, any instruction on human sexuality provided by a school district or charter school shall include a human growth and development discussion.  Such discussion shall include a video illustrating the development of vital organs in early fetal development, as well as a video illustrating the process of fertilization and every stage of human development inside the uterus throughout pregnancy until birth.",
        "lrNumber": "4958S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "328",
        "id": "bill:sb978:261",
        "createdAt": "2026-01-16T22:14:11.338Z",
        "updatedAt": "2026-01-19T20:04:44.152Z"
      },
      "bill:sb979:261": {
        "billNumber": "SB 979",
        "billPrefix": "SB",
        "billSuffix": 979,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to advanced practice registered nurses",
        "briefDescription": "This act modifies provisions relating to the practice of advanced practice registered nursing. Specifically, prescription medications prescribed by advanced practice registered nurses (\"APRNs\") may include Schedule II stimulants for behavioral health patients.",
        "lrNumber": "5116S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:emerging_issues_and_professional_registration",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "329",
        "id": "bill:sb979:261",
        "createdAt": "2026-01-16T22:14:15.395Z",
        "updatedAt": "2026-01-19T20:05:06.218Z"
      },
      "bill:sb980:261": {
        "billNumber": "SB 980",
        "billPrefix": "SB",
        "billSuffix": 980,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to state funds compensating certain injured persons",
        "briefDescription": "This act modifies the Tort Victims' Compensation Fund by providing that in addition to the current requirements, an uncompensated tort victim shall be a person who is a United States citizen or a lawful permanent resident or who holds a lawful visa issued by the United States Department of State. The Department of Labor and Industrial Relations shall verify eligibility requirements prior to the authorization of any payment from the Fund.",
        "lrNumber": "5680S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:general_laws",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "624",
        "id": "bill:sb980:261",
        "createdAt": "2026-01-16T22:14:19.370Z",
        "updatedAt": "2026-01-19T20:05:08.234Z"
      },
      "bill:sb981:261": {
        "billNumber": "SB 981",
        "billPrefix": "SB",
        "billSuffix": 981,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the Crime Victims' Compensation Fund",
        "briefDescription": "This act modifies the requirements for filing a claim for compensation under the Crime Victims' Compensation Fund. Currently, the claim shall be filed no later than two years after the occurrence or the discovery of the crime eligible for compensation. This act provide that a claim shall be filed no later than two years after the later of:",
        "lrNumber": "5671S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "625",
        "id": "bill:sb981:261",
        "createdAt": "2026-01-16T22:14:23.372Z",
        "updatedAt": "2026-01-19T20:05:10.237Z"
      },
      "bill:sb982:261": {
        "billNumber": "SB 982",
        "billPrefix": "SB",
        "billSuffix": 982,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the sex offender registry",
        "briefDescription": "This act modifies provisions relating to the sex offender registry. Instead of listing certain sexual offenses, this act provides that any person who, since July 1, 1979, has been or is adjudicated for a tier I offense, tier II offense, or tier III offense in this state or in any other state, territory, the District of Columbia, foreign country, or federal, tribal or military jurisdiction shall be required to register as a sex offender. (Section 589.400)",
        "lrNumber": "5756S.02I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-21",
        "withdrawn": false,
        "senateBillId": "628",
        "id": "bill:sb982:261",
        "createdAt": "2026-01-16T22:14:27.385Z",
        "updatedAt": "2026-01-19T20:05:12.250Z"
      },
      "bill:sb983:261": {
        "billNumber": "SB 983",
        "billPrefix": "SB",
        "billSuffix": 983,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to voter registration",
        "briefDescription": "Current law requires the Secretary of State and the Director of the Department of Revenue (DOR) to enter into an agreement to match information in the voter registration database with information in the motor vehicle system. This act requires such agreement to include information pertaining to the citizenship status of those within DOR's database.",
        "lrNumber": "3376S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "99",
        "id": "bill:sb983:261",
        "createdAt": "2026-01-16T22:14:31.395Z",
        "updatedAt": "2026-01-19T20:05:14.609Z"
      },
      "bill:sb984:261": {
        "billNumber": "SB 984",
        "billPrefix": "SB",
        "billSuffix": 984,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to pharmacy benefit managers",
        "briefDescription": "This act adds definitions for the terms \"audit\" and \"entity\" for the purposes of audits of licensed pharmacies. Current law requires a one week notice for any on-site audit. This act increases such notice to fourteen days and requires the notice to specify specific prescriptions to be audited. A pharmacy shall have the right to submit amended claims within thirty days of the discovery of an error. Audits shall be limited to twenty-five prescriptions that are randomly selected, and the act provid",
        "lrNumber": "5297S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-21",
        "withdrawn": false,
        "senateBillId": "109",
        "id": "bill:sb984:261",
        "createdAt": "2026-01-16T22:14:35.397Z",
        "updatedAt": "2026-01-19T20:05:16.277Z"
      },
      "bill:sb985:261": {
        "billNumber": "SB 985",
        "billPrefix": "SB",
        "billSuffix": 985,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relative to the Secretary of State",
        "briefDescription": "This act modifies various provisions relating to the Secretary of State.",
        "lrNumber": "4160S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
