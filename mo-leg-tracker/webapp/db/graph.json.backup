        "createdAt": "2026-01-16T22:57:11.325Z",
        "updatedAt": "2026-01-19T20:39:56.266Z"
      },
      "bill:sb1501:261": {
        "billNumber": "SB 1501",
        "billPrefix": "SB",
        "billSuffix": 1501,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to direct shipping of alcoholic beverages",
        "briefDescription": "Currently, licensed wine manufacturers may receive a direct shipper license to ship up to two cases of wine a month directly to a Missouri resident for personal use.  This act permits wine manufacturers, distilled spirits manufacturers, and retailers licensed to sell intoxicating liquor with a direct shipper license to ship up to two cases of wine or one case of distilled spirits to residents in this state or any other state that permits direct shipment of alcoholic beverages to residents.  Lice",
        "lrNumber": "6503S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "74592",
