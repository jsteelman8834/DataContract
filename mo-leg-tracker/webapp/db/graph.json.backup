      "bill:sb1286:261": {
        "billNumber": "SB 1286",
        "billPrefix": "SB",
        "billSuffix": 1286,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to local permitting applications",
        "briefDescription": "This act provides that a political subdivision shall approve or deny a request for a permit or any other kind of prior approval required for the construction of new residential, commercial, or industrial buildings within thirty calendar days of the request. If a response is not received by the applicant within thirty days, the request shall be deemed approved. If the request is approved, the political subdivision shall not impose any additional requirements related to such request. If the reques",
        "lrNumber": "4967S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
