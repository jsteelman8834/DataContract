      "bill:sb1023:261": {
        "billNumber": "SB 1023",
        "billPrefix": "SB",
        "billSuffix": 1023,
        "session": "261",
        "chamber": "senate",
        "title": "Adds certain counties to the list of counties authorized to impose a sales tax for public libraries",
        "briefDescription": "Current law authorizes public library districts in certain counties to impose a sales tax of up to 0.5%. This act adds the following counties to such list of authorized counties: St. Charles, Franklin, Warren, Gasconade, Crawford, Buchanan, Iron, Madison, Maries, Miller, Christian, Greene, Jefferson, Jasper, Newton, Cass, Lafayette, Johnson, Webster, Howell, Pettis, Benton, Cooper, Randolph, Monroe, Audrain, Cape Girardeau, Barry, Lawrence, Grundy, Livingston, Saline, Pulaski, Osage, Cole, Phelp",
        "lrNumber": "5365S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "243",
        "id": "bill:sb1023:261",
        "createdAt": "2026-01-16T22:17:11.920Z",
        "updatedAt": "2026-01-19T20:07:54.950Z"
      },
      "bill:sb1024:261": {
        "billNumber": "SB 1024",
        "billPrefix": "SB",
        "billSuffix": 1024,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to opioid prescriptions",
        "briefDescription": "This act requires practitioners, before an initial opioid prescription and the third in a course of treatment, to consult with the patient as to the risks of taking opioids and alternatives to opioids.  The practitioner shall make note of the consultation in the patient's medical record.  The provisions of this act shall not apply to those in hospice or palliative care, in a long-term care facility, or receiving treatment for cancer, substance abuse, or opioid dependence.",
        "lrNumber": "4400S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "206",
        "id": "bill:sb1024:261",
        "createdAt": "2026-01-16T22:17:15.945Z",
        "updatedAt": "2026-01-19T20:07:56.950Z"
      },
      "bill:sb1025:261": {
        "billNumber": "SB 1025",
        "billPrefix": "SB",
        "billSuffix": 1025,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the elder abuse and neglect hotline",
        "briefDescription": "This act requires the elder abuse and neglect hotline operated by the Department of Health and Senior Services to be operated continuously 24 hours a day, 7 days a week.",
        "lrNumber": "4396S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "207",
        "id": "bill:sb1025:261",
        "createdAt": "2026-01-16T22:17:19.954Z",
        "updatedAt": "2026-01-19T20:07:58.958Z"
      },
      "bill:sb1026:261": {
        "billNumber": "SB 1026",
        "billPrefix": "SB",
        "billSuffix": 1026,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions regulating intoxicating cannabinoids",
        "briefDescription": "Under this act, any person or entity selling in this state any intoxicating cannabinoid shall not be prohibited from doing so by any law regulating or restricting the sale of cannabis; provided that such products are: (1) sold only to adults 21 years of age or older upon age verification; (2) compliant with testing and safety regulations; (3) compliant with packaging and labeling regulations to protect minors; and (4) compliant with other regulations promulgated by the Department of Health and S",
        "lrNumber": "4397S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "208",
        "id": "bill:sb1026:261",
        "createdAt": "2026-01-16T22:17:23.990Z",
        "updatedAt": "2026-01-19T20:08:00.970Z"
      },
      "bill:sb1027:261": {
        "billNumber": "SB 1027",
        "billPrefix": "SB",
        "billSuffix": 1027,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to the use of automated license plate reader systems",
        "briefDescription": "The act prohibits political subdivisions and state agencies from using automated license plate reader systems, or accessing or using captured license plate data of vehicles located on a public highway, with certain exceptions specified in the act.",
        "lrNumber": "5126S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "485",
        "id": "bill:sb1027:261",
        "createdAt": "2026-01-16T22:17:28.018Z",
        "updatedAt": "2026-01-19T20:08:02.981Z"
      },
      "bill:sb1028:261": {
        "billNumber": "SB 1028",
        "billPrefix": "SB",
        "billSuffix": 1028,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions regarding elementary and secondary education",
        "briefDescription": "This act establishes provisions relating to education and creates the \"Sunlight in Learning Act\" requiring certain information to be to be posted on public school websites, as well as the \"Parents' Bill of Rights Act of 2026\" outlining the rights of parents of public school students.",
        "lrNumber": "5160S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "486",
        "id": "bill:sb1028:261",
        "createdAt": "2026-01-16T22:17:32.007Z",
        "updatedAt": "2026-01-19T20:08:04.995Z"
      },
      "bill:sb1029:261": {
        "billNumber": "SB 1029",
        "billPrefix": "SB",
        "billSuffix": 1029,
        "session": "261",
        "chamber": "senate",
        "title": "Requires school districts to maintain an easily accessible online record of all money the district receives and spends",
        "briefDescription": "This act requires each school district to maintain an easily accessible online record of all money the district receives and spends.  Each public school within a school district shall prominently link to the district's financial ledger on the school's own website.",
        "lrNumber": "5566S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "487",
        "id": "bill:sb1029:261",
        "createdAt": "2026-01-16T22:17:36.017Z",
        "updatedAt": "2026-01-19T20:08:27.157Z"
      },
      "bill:sb1030:261": {
        "billNumber": "SB 1030",
        "billPrefix": "SB",
        "billSuffix": 1030,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits the enforcement of any federal regulation by a state department or agency until the enforcement is approved by the General Assembly",
        "briefDescription": "This act prohibits all state departments and agencies from enforcing any rule or regulation promulgated by any federal agency until the rule or regulation has first been approved by the Missouri General Assembly.",
        "lrNumber": "5697S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:government_efficiency",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "404",
        "id": "bill:sb1030:261",
        "createdAt": "2026-01-16T22:17:40.018Z",
        "updatedAt": "2026-01-19T20:08:29.125Z"
      },
      "bill:sb1031:261": {
        "billNumber": "SB 1031",
        "billPrefix": "SB",
        "billSuffix": 1031,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits expenditures by state departments for certain diversity initiatives",
        "briefDescription": "This act prohibits any state department to expend funds for intradepartmental programs, staffing, or other initiatives associated with \"diversity, equity, and inclusion\" or \"diversity, inclusion, and belonging\" or any other similar initiative, as described in the act. This act does not prohibit state departments from following anti-discrimination laws or complying with the federal Americans with Disabilities Act.",
        "lrNumber": "5516S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:government_efficiency",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "383",
        "id": "bill:sb1031:261",
        "createdAt": "2026-01-16T22:17:44.043Z",
        "updatedAt": "2026-01-19T20:08:31.117Z"
      },
      "bill:sb1032:261": {
        "billNumber": "SB 1032",
        "billPrefix": "SB",
        "billSuffix": 1032,
        "session": "261",
        "chamber": "senate",
        "title": "Creates an income tax deduction for certain dependents",
        "briefDescription": "Current law authorizes a taxpayer to claim a $1,200 exemption for each dependent for whom such taxpayer is entitled to a dependency exemption for federal tax purposes, provided such federal exemption is not equal to $0. This act authorizes a taxpayer to claim a $2,400 exemption during the tax year in which a taxpayer gives birth to a child for which the taxpayer is entitled to a dependency exemption for federal tax purposes, regardless of whether the federal exemption is equal to $0.",
        "lrNumber": "5404S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "384",
        "id": "bill:sb1032:261",
        "createdAt": "2026-01-16T22:17:48.061Z",
        "updatedAt": "2026-01-19T20:08:33.172Z"
      },
      "bill:sb1033:261": {
        "billNumber": "SB 1033",
        "billPrefix": "SB",
        "billSuffix": 1033,
        "session": "261",
        "chamber": "senate",
        "title": "Exempts certain farm vehicles from emissions inspection requirements",
        "briefDescription": "This act provides that motor vehicle emissions inspection requirements shall not apply to motor vehicles over 10 years old that are registered as local commercial vehicles and used for farm or farming transportation operations, or that are otherwise defined as \"covered farm vehicles\" under federal law.",
        "lrNumber": "4510S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "79",
        "id": "bill:sb1033:261",
        "createdAt": "2026-01-16T22:17:52.075Z",
        "updatedAt": "2026-01-19T20:08:35.152Z"
      },
      "bill:sb1034:261": {
        "billNumber": "SB 1034",
        "billPrefix": "SB",
        "billSuffix": 1034,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to certain water management districts",
        "briefDescription": "This act modifies provisions relating to levee and drainage districts.",
        "lrNumber": "4812S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:agriculture_food_production_and_outdoor_resources",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
