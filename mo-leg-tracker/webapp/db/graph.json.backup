        "billPrefix": "SB",
        "billSuffix": 1493,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes counties to impose a sales tax for senior services",
        "briefDescription": "This act authorizes any county to impose a sales tax for the purpose of funding senior services. Such sales tax shall not exceed 0.25%.",
        "lrNumber": "6362S.01I",
        "currentStatus": "first_read",
