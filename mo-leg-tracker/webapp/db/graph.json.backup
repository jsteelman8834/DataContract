        "id": "bill:sb1290:261",
        "createdAt": "2026-01-16T22:35:16.732Z",
        "updatedAt": "2026-01-19T20:25:53.237Z"
      },
      "bill:sb1291:261": {
        "billNumber": "SB 1291",
        "billPrefix": "SB",
        "billSuffix": 1291,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to an income tax deduction for certain farmers",
        "briefDescription": "Current law authorizes an income tax deduction for certain income received for the sale or lease of farmland to beginning farmers. This act adds a definition of \"taxpayer\" to such deduction.",
        "lrNumber": "4319S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
