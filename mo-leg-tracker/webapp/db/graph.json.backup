        "session": "261",
        "chamber": "senate",
        "title": "Designates \"Missouri\" as the official state promotional song",
        "briefDescription": "This act designates \"Missouri\", written by Musician 1st Class Kenny Ray Horton, as the official state promotional song.",
        "lrNumber": "4153S.01I",
