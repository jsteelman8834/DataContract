        "id": "bill:sb1400:261",
        "createdAt": "2026-01-16T22:42:38.215Z",
        "updatedAt": "2026-01-19T20:33:14.850Z"
      },
      "bill:sb1401:261": {
        "billNumber": "SB 1401",
        "billPrefix": "SB",
        "billSuffix": 1401,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions of the Supplemental Nutrition Assistance Program (SNAP)",
        "briefDescription": "This act repeals provisions of law allowing for individuals convicted of certain drug offenses to participate in the Supplemental Nutrition Assistance Program (SNAP) only if certain conditions are met.  Under this act, individuals convicted of a state or federal felony drug offense shall not be excluded from SNAP for such conviction.",
        "lrNumber": "5880S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "695",
        "id": "bill:sb1401:261",
        "createdAt": "2026-01-16T22:42:42.206Z",
        "updatedAt": "2026-01-19T20:33:16.844Z"
      },
      "bill:sb1402:261": {
        "billNumber": "SB 1402",
        "billPrefix": "SB",
        "billSuffix": 1402,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies a sales tax exemption for the sale of certain medical devices",
        "briefDescription": "Current law provides a sales tax exemption for certain durable medical equipment as defined on January 1, 1980 by the federal Medicare program. This act removes the reference to January 1, 1980.",
        "lrNumber": "5883S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
