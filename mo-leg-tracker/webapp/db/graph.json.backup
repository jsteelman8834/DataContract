      "bill:sb927:261": {
        "billNumber": "SB 927",
        "billPrefix": "SB",
        "billSuffix": 927,
        "session": "261",
        "chamber": "senate",
        "title": "Regulates the sale of kratom in the state",
        "briefDescription": "This act prohibits the preparation, distribution, advertisement, sale, or offering for sale of a kratom product that:  (1) is adulterated; (2)  is sold to a person under 21 years of age; (3) contains a level of 7-hydroxymitragynine in the alkaloid fraction that is greater than 2% of the alkaloid composition of the product; (4) mimics candy or is appealing to children; or (5) is combustible or intended for vaporization.  Kratom products shall contain specified labels that include disclaimers and ",
        "lrNumber": "5719S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
