        "createdAt": "2026-01-16T22:42:50.261Z",
        "updatedAt": "2026-01-19T20:33:20.854Z"
      },
      "bill:sb1404:261": {
        "billNumber": "SB 1404",
        "billPrefix": "SB",
        "billSuffix": 1404,
        "session": "261",
        "chamber": "senate",
        "title": "Requires school districts and charter schools to notify parents about the use of tutoring programs or services at least half-owned by entities outside the United States",
        "briefDescription": "This act requires school districts and charter schools to notify parents of enrolled students if the school district or charter school uses, has used in the past 12 months, or in the future intends to use a tutoring program or service that is at least 50% owned by entities outside the United States.  The notification shall disclose the majority owner of the tutoring program or service and indicate whether such owner is designated as a foreign adversary of the United States under federal regulati",
        "lrNumber": "5961S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "698",
        "id": "bill:sb1404:261",
        "createdAt": "2026-01-16T22:42:54.278Z",
        "updatedAt": "2026-01-19T20:33:22.866Z"
      },
      "bill:sb1405:261": {
        "billNumber": "SB 1405",
        "billPrefix": "SB",
        "billSuffix": 1405,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the provision relating to clinical fellowships for licensure of speech pathologists and audiologists",
        "briefDescription": "This act modifies the requirements for licensure as a speech pathologist or audiologist by providing for completion of a clinical fellowship under the direct supervision of a licensed speech-language pathologist in good standing, rather than under the direct supervision of a person licensed by the state of Missouri in the profession in which the applicant seeks to be licensed.",
        "lrNumber": "4847S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "699",
        "id": "bill:sb1405:261",
        "createdAt": "2026-01-16T22:42:58.278Z",
        "updatedAt": "2026-01-19T20:33:24.863Z"
      },
      "bill:sb1406:261": {
        "billNumber": "SB 1406",
        "billPrefix": "SB",
        "billSuffix": 1406,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Missouri Defense and Energy Independence Act",
        "briefDescription": "This act establishes the \"Missouri Defense and Energy Independence Act\".",
        "lrNumber": "5856S.01I",
