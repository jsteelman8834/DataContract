      "bill:sb871:261": {
        "billNumber": "SB 871",
        "billPrefix": "SB",
        "billSuffix": 871,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the Pregnancy-Associated Mortality Review Board",
        "briefDescription": "This act modifies the \"Pregnancy-Associated Mortality Review Board\" within the Department of Health and Senior Services.  Under this act, board membership shall include at least one member from each congressional district and membership shall be demographically diverse, including by race, ethnicity, sex, age, and rural and urban populations.  Board members are increased from no more than 18 members to no more than 22 members.",
        "lrNumber": "4285S.01I",
        "currentStatus": "in_committee",
