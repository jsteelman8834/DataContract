        "billPrefix": "SB",
        "billSuffix": 940,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to peer review committees",
        "briefDescription": "Under this act, any emergency medical services provider licensed under certain provisions of state law shall be considered a health care professional for purposes of liability and disclosure of materials produced by a peer review committee.  Any quality improvement or quality assurance activity required by such licensed individuals shall be considered an activity of a peer review committee.",
        "lrNumber": "4550S.01I",
