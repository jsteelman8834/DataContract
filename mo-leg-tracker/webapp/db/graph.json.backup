      "bill:sb999:261": {
        "billNumber": "SB 999",
        "billPrefix": "SB",
        "billSuffix": 999,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"Born-Alive Abortion Survivors Protection Act\"",
        "briefDescription": "This act creates the \"Born-Alive Abortion Survivors Protection Act\".  Under this act, a child born alive during or after an abortion or attempted abortion shall have the same rights, privileges, and immunities as any other person, citizen, and resident of Missouri, including any other live-born child.  Any licensed, registered, or certified health care provider present at the time a child is born alive during or after an abortion or attempted abortion shall exercise the same degree of profession",
        "lrNumber": "5530S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
