      "bill:sb1010:261": {
        "billNumber": "SB 1010",
        "billPrefix": "SB",
        "billSuffix": 1010,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to child protection, including child abuse and endangering a child",
        "briefDescription": "Under this act, a child shall not be considered abused or neglected for the sole reason that the child's parent, guardian, or other person responsible for the child's care, custody, and control refuses to affirm or otherwise recognize the child's sexual orientation or gender identity if that gender identity differs from the child's biological sex.  Additionally, the Children's Division shall not investigate or conduct a family assessment for the sole reason that the child's parent, guardian, or ",
        "lrNumber": "5474S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "166",
        "id": "bill:sb1010:261",
        "createdAt": "2026-01-16T22:16:20.003Z",
        "updatedAt": "2026-01-19T20:07:08.748Z"
      },
      "bill:sb1011:261": {
        "billNumber": "SB 1011",
        "billPrefix": "SB",
        "billSuffix": 1011,
        "session": "261",
        "chamber": "senate",
        "title": "Provides that certain international organizations shall have no jurisdiction in this state and creates the \"No Shari'a Act\" regarding enforcement of certain foreign laws in this state",
        "briefDescription": "This act provides that certain international organizations or bodies, such as the World Health Organization, the United Nations, and the World Economic Forum, shall have no jurisdiction or power within the state of Missouri.  No rule, regulation, policy, or mandate of any kind from such organizations shall be enforced or implemented by any state or local public body.",
        "lrNumber": "5599S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
