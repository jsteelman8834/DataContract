        "billPrefix": "SB",
        "billSuffix": 1408,
        "session": "261",
        "chamber": "senate",
        "title": "Increases the maximum speed limit from 70 to 75 miles per hour on rural interstates and freeways",
        "briefDescription": "Currently, the maximum speed limit on rural interstates and freeways of this state is seventy miles per hour.  This act increases the maximum speed limit on such roads to seventy-five miles per hour.",
        "lrNumber": "5907S.01I",
        "currentStatus": "first_read",
