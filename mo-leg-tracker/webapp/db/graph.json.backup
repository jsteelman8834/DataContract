      },
      "bill:sb1527:261": {
        "billNumber": "SB 1527",
        "billPrefix": "SB",
        "billSuffix": 1527,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals provisions relating to the Infection Control Advisory Panel",
        "briefDescription": "This act repeals provisions of law relating to the Infection Control Advisory Panel.  Currently, the Panel is required to issue and disseminate to the public certain reports and update those reports quarterly.  This act requires the Department of Health and Senior Services to develop, disseminate, and update the reports at least annually.",
        "lrNumber": "6223S.01I",
        "currentStatus": "first_read",
