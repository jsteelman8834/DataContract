        "createdAt": "2026-01-16T22:35:04.660Z",
        "updatedAt": "2026-01-19T20:25:27.153Z"
      },
      "bill:sb1288:261": {
        "billNumber": "SB 1288",
        "billPrefix": "SB",
        "billSuffix": 1288,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to employment of illegal aliens",
        "briefDescription": "This act modifies provisions governing the employment of unauthorized aliens.",
        "lrNumber": "3381S.01I",
