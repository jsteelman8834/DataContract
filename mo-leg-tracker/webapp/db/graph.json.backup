        "id": "bill:sb1260:261",
        "createdAt": "2026-01-16T22:33:16.310Z",
        "updatedAt": "2026-01-19T20:23:52.811Z"
      },
      "bill:sb1261:261": {
        "billNumber": "SB 1261",
        "billPrefix": "SB",
        "billSuffix": 1261,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to organ transplant procedures",
        "briefDescription": "Currently, the COVID-19 vaccination status of a potential organ donor or organ transplant recipient, with some exceptions, shall not be considered in any part of the organ transplant process.  This act repeals this provision of law.",
        "lrNumber": "4589S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "575",
        "id": "bill:sb1261:261",
        "createdAt": "2026-01-16T22:33:20.310Z",
        "updatedAt": "2026-01-19T20:23:54.815Z"
      },
      "bill:sb1262:261": {
        "billNumber": "SB 1262",
        "billPrefix": "SB",
        "billSuffix": 1262,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to earnings tax",
        "briefDescription": "Current law requires the earnings tax imposed in the City of St. Louis and Kansas City to be submitted to the voters for renewal every five years. This act requires such submission to voters in Kansas City to occur every ten years.",
        "lrNumber": "4582S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "576",
        "id": "bill:sb1262:261",
        "createdAt": "2026-01-16T22:33:24.335Z",
        "updatedAt": "2026-01-19T20:23:56.825Z"
      },
      "bill:sb1263:261": {
        "billNumber": "SB 1263",
        "billPrefix": "SB",
        "billSuffix": 1263,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes \"Colton's Law\" relating to certain pediatric disorders",
        "briefDescription": "This act establishes \"Colton's Law.\"  Under this act, MO HealthNet and private health insurance carriers and health benefit plans for plans delivered, issued for delivery, continued, or renewed on or after January 1, 2027, shall provide coverage for medically necessary physician-prescribed treatment for pediatric autoimmune neuropsychiatric disorders associated with streptococcal infections (PANDAS) and pediatric acute-onset neuropsychiatric syndrome (PANS).  Coverage shall include antibiotics, ",
        "lrNumber": "5544S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "497",
        "id": "bill:sb1263:261",
        "createdAt": "2026-01-16T22:33:28.334Z",
        "updatedAt": "2026-01-19T20:23:58.828Z"
      },
      "bill:sb1264:261": {
        "billNumber": "SB 1264",
        "billPrefix": "SB",
        "billSuffix": 1264,
        "session": "261",
        "chamber": "senate",
        "title": "Removes the expiration date on certain provisions relating to gender transition",
        "briefDescription": "Currently, the prohibition on the prescription or administration of cross-sex hormones or puberty-blocking drugs for the purpose of a gender transition for persons under 18 years of age expires on August 28, 2027.  This act removes that expiration date.",
        "lrNumber": "5154S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "498",
        "id": "bill:sb1264:261",
        "createdAt": "2026-01-16T22:33:32.350Z",
        "updatedAt": "2026-01-19T20:24:00.837Z"
      },
      "bill:sb1265:261": {
        "billNumber": "SB 1265",
        "billPrefix": "SB",
        "billSuffix": 1265,
        "session": "261",
        "chamber": "senate",
        "title": "Creates new provisions relating to illegal aliens",
        "briefDescription": "This act modifies various provisions relating to illegal aliens.",
        "lrNumber": "5307S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "499",
        "id": "bill:sb1265:261",
        "createdAt": "2026-01-16T22:33:36.379Z",
        "updatedAt": "2026-01-19T20:24:02.836Z"
      },
      "bill:sb1266:261": {
        "billNumber": "SB 1266",
        "billPrefix": "SB",
        "billSuffix": 1266,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Freedom to Farm Act and modifies provisions relating to the Governor's emergency powers and agricultural operations as nuisances",
        "briefDescription": "The act establishes the \"Freedom to Farm Act\" which provides that the right of farmers and ranchers to engage in farming and ranching practices for sale or personal consumption shall be free from government intervention and that practices occurring within the state shall not be infringed upon by the federal government under the regulation of interstate commerce.",
        "lrNumber": "5664S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "390",
        "id": "bill:sb1266:261",
        "createdAt": "2026-01-16T22:33:40.394Z",
        "updatedAt": "2026-01-19T20:24:04.842Z"
      },
      "bill:sb1267:261": {
        "billNumber": "SB 1267",
        "billPrefix": "SB",
        "billSuffix": 1267,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to hospital price transparency laws",
        "briefDescription": "Under this act, a hospital that is not in material compliance with federal hospital price transparency laws on the date that items or services are purchased from, or provided to a patient by, the hospital shall not initiate or pursue a collection action against the patient for a debt owed for the items or services.  The patient may file suit against the hospital for a prohibited collection and the hospital, if found to be materially out of compliance with federal price transparency laws, shall r",
        "lrNumber": "5413S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "391",
        "id": "bill:sb1267:261",
        "createdAt": "2026-01-16T22:33:44.446Z",
        "updatedAt": "2026-01-19T20:24:06.844Z"
      },
      "bill:sb1268:261": {
        "billNumber": "SB 1268",
        "billPrefix": "SB",
        "billSuffix": 1268,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to certificates of need",
        "briefDescription": "This act repeals provisions of the certificate of need law relating to hospitals, excluding long-term care beds in hospitals, and major medical equipment.",
        "lrNumber": "5411S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "392",
        "id": "bill:sb1268:261",
        "createdAt": "2026-01-16T22:33:48.413Z",
        "updatedAt": "2026-01-19T20:24:08.858Z"
      },
      "bill:sb1269:261": {
        "billNumber": "SB 1269",
        "billPrefix": "SB",
        "billSuffix": 1269,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the filing of false documents",
        "briefDescription": "This act modifies the offense of filing a false document to include those documents filed with a court, including court filings, and where such documents are frivolous, unenforceable under Missouri law, or are court filings lacking probable cause. Additionally, this act modifies the penalties from a class D felony to a class C felony for the first offense and increases the enhanced penalty for certain circumstances to a class B felony, instead of class C felony.",
        "lrNumber": "4754S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "650",
        "id": "bill:sb1269:261",
        "createdAt": "2026-01-16T22:33:52.425Z",
        "updatedAt": "2026-01-19T20:24:30.942Z"
      },
      "bill:sb1270:261": {
        "billNumber": "SB 1270",
        "billPrefix": "SB",
        "billSuffix": 1270,
        "session": "261",
        "chamber": "senate",
        "title": "Requires public schools and charter schools to provide free feminine hygiene products to female students in grades 4-12",
        "briefDescription": "This act requires public schools and charter schools that include any of grades 4-12 to make at least one type of feminine hygiene product, as provided in the act, available in each school building for use by female students at no cost.  Each school board and charter school governing body shall adopt policies establishing procedures for the distribution of feminine hygiene products and guidance regarding the safe use of such products, as well as prohibiting the resale or misuse of feminine hygie",
        "lrNumber": "4334S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "651",
        "id": "bill:sb1270:261",
        "createdAt": "2026-01-16T22:33:56.435Z",
        "updatedAt": "2026-01-19T20:24:33.009Z"
      },
      "bill:sb1271:261": {
        "billNumber": "SB 1271",
        "billPrefix": "SB",
        "billSuffix": 1271,
        "session": "261",
        "chamber": "senate",
        "title": "Creates and modifies provisions relating to lactation accommodations in public schools and charter schools",
        "briefDescription": "Current law requires school districts to adopt a written policy regarding the provision of certain accommodations for lactating employees, teachers, and students.  This act requires charter schools, in addition to school districts, to adopt such a policy and provide such accommodations.",
        "lrNumber": "4336S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
