      "bill:sb1470:261": {
        "billNumber": "SB 1470",
        "billPrefix": "SB",
        "billSuffix": 1470,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies duties and functions of the Joint Committee on Legislative Research",
        "briefDescription": "This act modifies the duties and functions of the Joint Committee on Legislative Research.  The Committee is required to provide copies of all laws in a web-based electronic format, in addition to the current paper copies that must be made available.  Currently, printed copies of laws, resolutions, constitutional amendments and measures are made available at no cost to members of the General Assembly, certain judicial entities, and certain law enforcement entities.  This act repeals this provisi",
        "lrNumber": "6122S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
