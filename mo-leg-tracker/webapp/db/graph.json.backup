      "bill:sb1409:261": {
        "billNumber": "SB 1409",
        "billPrefix": "SB",
        "billSuffix": 1409,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the \"Purple Alert System\" within the Department of Public Safety",
        "briefDescription": "This act establishes the \"Purple Alert System\" within the Department of Public Safety to aid in the identification and location of missing persons with developmental disabilities whose disappearance poses a credible threat of immediate danger or serious bodily harm to themselves.  Before July 1, 2027, the Department shall, in cooperation with other state agencies and local law enforcement agencies, develop a training program and alert system that is compatible with existing alert systems in the ",
        "lrNumber": "5020S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2025-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
