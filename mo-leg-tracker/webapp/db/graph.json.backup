        "billSuffix": 1421,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the unlawful use of unmanned aircraft in certain areas",
        "briefDescription": "This act modifies provisions relating to the unlawful use of certain unmanned aircrafts over correctional centers, open-air facilities, and mental health hospitals.",
        "lrNumber": "5940S.01I",
