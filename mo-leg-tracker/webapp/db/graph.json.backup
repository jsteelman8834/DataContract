        "createdAt": "2026-01-16T22:41:25.970Z",
        "updatedAt": "2026-01-19T20:31:58.556Z"
      },
      "bill:sb1383:261": {
        "billNumber": "SB 1383",
        "billPrefix": "SB",
        "billSuffix": 1383,
        "session": "261",
        "chamber": "senate",
        "title": "Requires the agricultural education pilot program to be implemented at all elementary schools statewide",
        "briefDescription": "This act ends the current pilot program for agricultural education in elementary schools after the 2026-27 school year and requires such program to be implemented at all elementary schools statewide beginning in the 2027-28 school year.  Provisions of state law requiring the State Board of Education to form a work group to develop academic performance standards shall not apply to this act.",
        "lrNumber": "4325S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "666",
        "id": "bill:sb1383:261",
        "createdAt": "2026-01-16T22:41:29.991Z",
        "updatedAt": "2026-01-19T20:32:00.565Z"
      },
      "bill:sb1384:261": {
        "billNumber": "SB 1384",
        "billPrefix": "SB",
        "billSuffix": 1384,
        "session": "261",
        "chamber": "senate",
        "title": "Creates and modifies provisions relating to elementary and secondary education",
        "briefDescription": "Under this act, charter schools and private schools that participate in the Missouri Empowerment Scholarship Accounts Program (defined as \"private schools\") shall be subject to the same procurement processes, wage standards, and contractual obligations as school districts.  (Sections 160.405 and 166.706)",
        "lrNumber": "4639S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "667",
        "id": "bill:sb1384:261",
        "createdAt": "2026-01-16T22:41:34.335Z",
        "updatedAt": "2026-01-19T20:32:02.563Z"
      },
      "bill:sb1385:261": {
        "billNumber": "SB 1385",
        "billPrefix": "SB",
        "billSuffix": 1385,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to workers' compensation",
        "briefDescription": "This act modifies various provisions relating to workers' compensation.",
        "lrNumber": "5742S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
