        "createdAt": "2026-01-16T22:31:19.856Z",
        "updatedAt": "2026-01-19T20:21:54.433Z"
      },
      "bill:sb1232:261": {
        "billNumber": "SB 1232",
        "billPrefix": "SB",
        "billSuffix": 1232,
        "session": "261",
        "chamber": "senate",
        "title": "Ensures cloud computing capabilities on state information technology",
        "briefDescription": "This act requires all state departments, in making purchases for any information technology or a major information resources project, to ensure that the technology or project is capable of being deployed and run on a cloud computing service. When making a purchase for any information technology or a major information resources project, a department may determine that, due to integration limitations with legacy systems, security risks, or costs, the department is unable to purchase the technology",
        "lrNumber": "4492S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "128",
