      "bill:sb1541:261": {
        "billNumber": "SB 1541",
        "billPrefix": "SB",
        "billSuffix": 1541,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits certain mental health professionals from engaging in conversion therapy for minors",
        "briefDescription": "Under this act, any licensed psychologist, behavior analyst, professional counselor, social worker, or marital and family therapist may have his or her application for licensure or renewal denied, or may have a complaint filed with the Administrative Hearing Commission, if such person engages in conversion therapy with a minor. The term \"conversion therapy\" shall mean any practice or treatment intended to change an individual's sexual orientation or gender identity.",
        "lrNumber": "4843S.01I",
