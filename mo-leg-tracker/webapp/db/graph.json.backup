      "bill:sb1236:261": {
        "billNumber": "SB 1236",
        "billPrefix": "SB",
        "billSuffix": 1236,
        "session": "261",
        "chamber": "senate",
        "title": "Requires physicians to make certain disclosures to patients of benefits received from manufacturers",
        "briefDescription": "This act requires physicians to provide to each patient at the patient's office visit a written and verbal notice of the Open Payments database operated by the Centers for Medicare and Medicaid Services pursuant to the federal Physician Payments Sunshine Act, as well as notice of any payments the physician is recorded as receiving relating to any pharmaceutical item, drug, or vaccine that the physician is recommending, including any benefits received from the manufacturer of such item, drug, or ",
        "lrNumber": "5649S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "339",
        "id": "bill:sb1236:261",
        "createdAt": "2026-01-16T22:31:39.940Z",
        "updatedAt": "2026-01-19T20:22:04.462Z"
      },
      "bill:sb1237:261": {
        "billNumber": "SB 1237",
        "billPrefix": "SB",
        "billSuffix": 1237,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions regarding income taxes, including the imposition of a 4% flat income tax",
        "briefDescription": "Current law imposes a graduated income tax rate and authorizes reductions in the top rate of income tax contingent on certain state revenue collections, with an eventual top rate of 4.5%. This act provides that, for all tax years beginning on or after January 1, 2027, there shall be a flat income tax rate of 4% on all taxable income.",
        "lrNumber": "5471S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "340",
        "id": "bill:sb1237:261",
        "createdAt": "2026-01-16T22:31:43.945Z",
        "updatedAt": "2026-01-19T20:22:06.478Z"
      },
      "bill:sb1238:261": {
        "billNumber": "SB 1238",
        "billPrefix": "SB",
        "billSuffix": 1238,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to instruction on the positive impacts of religion on American history",
        "briefDescription": "This act requires teachers of American history at public schools and charter schools to provide instruction on the positive impacts of religion on American history.  The act lists certain historical accounts that shall be included in such instruction, including the organization of the pilgrims as a church; the religious background of the signers of the Declaration of Independence; George Washington's direction regarding chaplains in the army; Benjamin Franklin's appeal for prayer at the constitu",
        "lrNumber": "5692S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "516",
        "id": "bill:sb1238:261",
        "createdAt": "2026-01-16T22:31:47.974Z",
        "updatedAt": "2026-01-19T20:22:08.507Z"
      },
      "bill:sb1239:261": {
        "billNumber": "SB 1239",
        "billPrefix": "SB",
        "billSuffix": 1239,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a sales tax exemption for food",
        "briefDescription": "Current law taxes retail sales of food, as defined in current law, at a rate of one percent. This act provides that retail sales of food shall be exempt from state sales taxes.",
        "lrNumber": "4351S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "606",
        "id": "bill:sb1239:261",
        "createdAt": "2026-01-16T22:31:52.004Z",
        "updatedAt": "2026-01-19T20:22:30.554Z"
      },
      "bill:sb1240:261": {
        "billNumber": "SB 1240",
        "billPrefix": "SB",
        "billSuffix": 1240,
        "session": "261",
        "chamber": "senate",
        "title": "Eliminates the individual income tax",
        "briefDescription": "Current law imposes an income tax on all Missouri taxable income. For all tax years beginning on or after January 1, 2027, this act eliminates the Missouri individual income tax.",
        "lrNumber": "4352S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "607",
        "id": "bill:sb1240:261",
        "createdAt": "2026-01-16T22:31:56.002Z",
        "updatedAt": "2026-01-19T20:22:32.561Z"
      },
      "bill:sb1241:261": {
        "billNumber": "SB 1241",
        "billPrefix": "SB",
        "billSuffix": 1241,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes an income tax deduction for tipped income",
        "briefDescription": "For all tax years beginning on or after January 1, 2026, this act authorizes an income tax deduction for the first $25,000 in tipped income, as defined in the act, earned by a taxpayer.",
        "lrNumber": "4964S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
