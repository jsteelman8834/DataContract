        "billPrefix": "SB",
        "billSuffix": 939,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the governing bodies of certain public institutions of higher education",
        "briefDescription": "Under this act, no more than half of the governing body members of the following institutions of higher education shall reside in the county in which the institution's main campus is located:",
        "lrNumber": "4764S.01I",
