        "chamber": "senate",
        "title": "Modifies provisions relating to providing explicit sexual material to a student",
        "briefDescription": "This act provides that any library district or school district that employs a person who has been found guilty of the offense of providing explicit sexual material to a student shall no longer be eligible to receive any state funds.",
        "lrNumber": "4695S.01I",
        "currentStatus": "referred",
