        "billSuffix": 1235,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the offense of tampering with a judicial officer and the offense of tampering with a judicial proceeding",
        "briefDescription": "This act makes the following persons ineligible for parole, probation, or conditional release:",
        "lrNumber": "5340S.01I",
