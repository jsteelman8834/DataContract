      "bill:sb1077:261": {
        "billNumber": "SB 1077",
        "billPrefix": "SB",
        "billSuffix": 1077,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the Missouri Religious Liberty Act, which prohibits certain orders regarding religious groups or places of worship",
        "briefDescription": "This act creates the Missouri Religious Liberty Act. No public official shall issue an order that has the effect of limiting or prohibiting religious groups, or places of worship, from holding religious services or meetings. This act shall not apply to religious groups using places of worship to knowingly commit or plan to commit act of violence or harm.",
        "lrNumber": "4946S.01I",
        "currentStatus": "referred",
