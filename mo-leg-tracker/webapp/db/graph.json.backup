        "id": "bill:sb1089:261",
        "createdAt": "2026-01-16T22:21:36.858Z",
        "updatedAt": "2026-01-19T20:12:28.218Z"
      },
      "bill:sb1090:261": {
        "billNumber": "SB 1090",
        "billPrefix": "SB",
        "billSuffix": 1090,
        "session": "261",
        "chamber": "senate",
        "title": "Requires charter schools to obtain a certificate of need issued by the State Board of Education in order to be eligible to operate",
        "briefDescription": "Under this act, no charter school established on or after August 28, 2026, shall be eligible to operate in Missouri without the State Board of Education's issuance of a certificate of need for such charter school as provided in the act.  A certificate of need shall be required only for proposed charter schools that are not established as of August 28, 2026, and shall not be required for charter renewals or transfers of sponsorship.  The act shall not be construed to exempt charter schools from s",
        "lrNumber": "3848S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "527",
        "id": "bill:sb1090:261",
        "createdAt": "2026-01-16T22:21:40.875Z",
        "updatedAt": "2026-01-19T20:12:30.237Z"
      },
      "bill:sb1091:261": {
        "billNumber": "SB 1091",
        "billPrefix": "SB",
        "billSuffix": 1091,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a child tax credit",
        "briefDescription": "For all tax years beginning on or after January 1, 2027, this act authorizes a taxpayer to claim a tax credit for each qualified child, defined as a dependent of the taxpayer for federal tax purposes who is under 18 years of age, did not provide more than half of the costs of his or her own support, and lived with the taxpayer for more than half of the taxpayer. In order to qualify for a tax credit, a taxpayer shall have a Missouri adjusted gross income of $75,000 or less if filing single, or $1",
        "lrNumber": "4832S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "565",
        "id": "bill:sb1091:261",
        "createdAt": "2026-01-16T22:21:44.899Z",
        "updatedAt": "2026-01-19T20:12:32.235Z"
      },
      "bill:sb1092:261": {
        "billNumber": "SB 1092",
        "billPrefix": "SB",
        "billSuffix": 1092,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the length of supervision for certain social work supervisors",
        "briefDescription": "This act modifies the definitions of a \"qualified advanced macro supervisor,\" \"qualified baccalaureate supervisor,\" and \"qualified clinical supervisor\" to provide that such person is a licensed social worker who has practiced social work for which he or she is supervising the applicant for a minimum of three, instead of five, years.",
        "lrNumber": "4990S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:emerging_issues_and_professional_registration",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "566",
        "id": "bill:sb1092:261",
        "createdAt": "2026-01-16T22:22:02.274Z",
        "updatedAt": "2026-01-19T20:12:34.242Z"
      },
      "bill:sb1093:261": {
        "billNumber": "SB 1093",
        "billPrefix": "SB",
        "billSuffix": 1093,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the offense of endangering the welfare of a child",
        "briefDescription": "This act provides that a person commits the offense of endangering the welfare of a child when a person knowingly fails to secure a readily available firearm in the presence of a child under 17 years of age or in a residence where a child under 17 years of age resides.  This offense shall be a class D felony, unless the offense causes physical harm or death to a child then it shall be a higher penalty.",
        "lrNumber": "4590S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "567",
        "id": "bill:sb1093:261",
        "createdAt": "2026-01-16T22:22:06.072Z",
        "updatedAt": "2026-01-19T20:12:36.260Z"
      },
      "bill:sb1094:261": {
        "billNumber": "SB 1094",
        "billPrefix": "SB",
        "billSuffix": 1094,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to elections",
        "briefDescription": "This act modifies provisions relating to elections, specifically provisions governing bond elections and publication of notice for elections.",
        "lrNumber": "4171S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "425",
        "id": "bill:sb1094:261",
        "createdAt": "2026-01-16T22:22:10.062Z",
        "updatedAt": "2026-01-19T20:12:38.268Z"
      },
      "bill:sb1095:261": {
        "billNumber": "SB 1095",
        "billPrefix": "SB",
        "billSuffix": 1095,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the candidate filing period for local elections",
        "briefDescription": "Under current law, the period for filing a declaration of candidacy in certain political subdivisions and special districts is from 8:00 a.m. on the 17th Tuesday prior to the election until 5:00 p.m. on the 14th Tuesday prior to the election. This act changes that period to 8:00 a.m. on the 16th Tuesday prior to the election until 5:00 p.m. on the 13th Tuesday prior to the election, unless the 13th Tuesday prior to an election falls on a holiday, then the closing of filing shall be at 5:00 p.m. ",
        "lrNumber": "4485S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "426",
        "id": "bill:sb1095:261",
        "createdAt": "2026-01-16T22:22:14.068Z",
        "updatedAt": "2026-01-19T20:12:40.268Z"
      },
      "bill:sb1096:261": {
        "billNumber": "SB 1096",
        "billPrefix": "SB",
        "billSuffix": 1096,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a sales tax exemption for certain property sold at auction",
        "briefDescription": "This act authorizes a state and local sales tax exemption for sales of tangible personal property, excluding motor vehicles, trailers, boats, or outboard motors, that is sold a second or additional time at an auction.",
        "lrNumber": "4777S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "427",
        "id": "bill:sb1096:261",
        "createdAt": "2026-01-16T22:22:18.088Z",
        "updatedAt": "2026-01-19T20:12:42.281Z"
      },
      "bill:sb1097:261": {
        "billNumber": "SB 1097",
        "billPrefix": "SB",
        "billSuffix": 1097,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits the establishment of new charter schools in St. Louis City beginning August 28, 2026",
        "briefDescription": "Beginning August 28, 2026, this act prohibits the establishment of new charter schools in St. Louis City.  The provisions of the act shall not apply to the renewal of charter contracts or transfers of sponsorship for any charter school established in St. Louis City prior to August 28, 2026.",
        "lrNumber": "4391S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "209",
        "id": "bill:sb1097:261",
        "createdAt": "2026-01-16T22:22:22.090Z",
        "updatedAt": "2026-01-19T20:12:44.292Z"
      },
      "bill:sb1098:261": {
        "billNumber": "SB 1098",
        "billPrefix": "SB",
        "billSuffix": 1098,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to term limits for local government officers",
        "briefDescription": "This act provides that county officers, mayors, and members of any school board in this state shall serve no more than twelve years total. Any term of a person elected before August 28, 2026, shall not be counted or any term of less than two years of a person completing the term of another shall not be counted.",
        "lrNumber": "5183S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "488",
        "id": "bill:sb1098:261",
        "createdAt": "2026-01-16T22:22:26.114Z",
        "updatedAt": "2026-01-19T20:12:46.308Z"
      },
      "bill:sb1099:261": {
        "billNumber": "SB 1099",
        "billPrefix": "SB",
        "billSuffix": 1099,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions protecting Second Amendment rights",
        "briefDescription": "This act provides that all federal acts, laws, executive orders, administrative orders, rules, and regulations that restrict the people's right to keep and bear certain types of arms shall not be recognized or enforced by this state.",
        "lrNumber": "5753S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "489",
        "id": "bill:sb1099:261",
        "createdAt": "2026-01-16T22:22:30.124Z",
        "updatedAt": "2026-01-19T20:13:08.407Z"
      },
      "bill:sb1100:261": {
        "billNumber": "SB 1100",
        "billPrefix": "SB",
        "billSuffix": 1100,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits certain corporations from acquiring residential real estate in this state",
        "briefDescription": "This act prohibits corporations, as that term is defined in the act, from acquiring, directly or indirectly, any residential real estate in this state. Provisions are included allowing the Attorney General to enforce this act in any circuit court with proper jurisdiction. Exemptions are included to state that banks and other financial institutions are not precluded from offering or issuing mortgages for the acquisition of residential real estate.",
        "lrNumber": "5572S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:general_laws",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "490",
        "id": "bill:sb1100:261",
        "createdAt": "2026-01-16T22:22:34.137Z",
        "updatedAt": "2026-01-19T20:13:10.393Z"
      },
      "bill:sb1101:261": {
        "billNumber": "SB 1101",
        "billPrefix": "SB",
        "billSuffix": 1101,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to emergency powers",
        "briefDescription": "This act provides that funds from the Missouri Disaster Fund may be used for an emergency or the designation of a disaster area, as defined in the act, declared by the governor in his or her emergency declaration.",
        "lrNumber": "5695S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "405",
        "id": "bill:sb1101:261",
        "createdAt": "2026-01-16T22:22:38.165Z",
        "updatedAt": "2026-01-19T20:13:12.401Z"
      },
      "bill:sb1102:261": {
        "billNumber": "SB 1102",
        "billPrefix": "SB",
        "billSuffix": 1102,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the restoration of certain firearm rights",
        "briefDescription": "Under current law, a person who has been convicted of a felony may not hold public office, may not vote if the felony was related to an election crime, and may not possess a firearm.",
        "lrNumber": "5401S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "385",
        "id": "bill:sb1102:261",
        "createdAt": "2026-01-16T22:22:42.180Z",
        "updatedAt": "2026-01-19T20:13:14.417Z"
      },
      "bill:sb1103:261": {
        "billNumber": "SB 1103",
        "billPrefix": "SB",
        "billSuffix": 1103,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to lifetime protection orders",
        "briefDescription": "This act provides that a court shall have jurisdiction at the time of sentencing to enter a lifetime protection order restraining or enjoining the defendant from contacting the victim if the defendant has been found guilty of a dangerous felony.  The protection order shall be effective immediately and shall be served on the defendant at the time of sentencing.  Such order shall be valid for the defendant's lifetime unless:",
        "lrNumber": "5130S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "386",
        "id": "bill:sb1103:261",
        "createdAt": "2026-01-16T22:22:46.191Z",
        "updatedAt": "2026-01-19T20:13:16.415Z"
      },
      "bill:sb1104:261": {
        "billNumber": "SB 1104",
        "billPrefix": "SB",
        "billSuffix": 1104,
        "session": "261",
        "chamber": "senate",
        "title": "Specifies that drivers shall stop at railroad crossings for \"any on-track equipment\" in addition to trains",
        "briefDescription": "This act specifies that drivers shall stop at railroad crossings for \"any on-track equipment\" in addition to trains.",
        "lrNumber": "4512S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "144",
        "id": "bill:sb1104:261",
        "createdAt": "2026-01-16T22:22:50.195Z",
        "updatedAt": "2026-01-19T20:13:18.431Z"
      },
      "bill:sb1105:261": {
        "billNumber": "SB 1105",
        "billPrefix": "SB",
        "billSuffix": 1105,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Rural Workforce Housing Investment Act",
        "briefDescription": "This act establishes the \"Rural Workforce Housing Investment Act\", which is a grant program established in the Department of Economic Development for the purpose of supporting the development of workforce housing in rural communities.",
        "lrNumber": "4491S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "84",
        "id": "bill:sb1105:261",
        "createdAt": "2026-01-16T22:22:54.218Z",
        "updatedAt": "2026-01-19T20:13:20.429Z"
      },
      "bill:sb1106:261": {
        "billNumber": "SB 1106",
        "billPrefix": "SB",
        "billSuffix": 1106,
        "session": "261",
        "chamber": "senate",
        "title": "Relating to the acquisition of real property by certain business entities",
        "briefDescription": "This act prohibits foreign corporations, as that term is defined in the act, from acquiring, directly or indirectly, any residential real estate in this state. Provisions are included allowing the Attorney General to enforce this act in any circuit court with proper jurisdiction.",
        "lrNumber": "4150S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:general_laws",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "95",
        "id": "bill:sb1106:261",
        "createdAt": "2026-01-16T22:22:58.224Z",
        "updatedAt": "2026-01-19T20:13:22.443Z"
      },
      "bill:sb1107:261": {
        "billNumber": "SB 1107",
        "billPrefix": "SB",
        "billSuffix": 1107,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to compensation for assisting or advising in veteran benefits matters",
        "briefDescription": "This act provides that no person shall receive compensation for advising or assisting, or referring to another person for such purposes, any individual with regard to any veterans benefits matter, as described in the act, unless such individual provides a written agreement containing the terms of the fees, provides certain disclosures, and complies with requirements under federal law. Additionally, no person shall advertise for such services without including a disclosure as specified in the act",
        "lrNumber": "5071S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:veterans_and_military_affairs",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "193",
        "id": "bill:sb1107:261",
        "createdAt": "2026-01-16T22:23:02.240Z",
        "updatedAt": "2026-01-19T20:13:24.445Z"
      },
      "bill:sb1108:261": {
        "billNumber": "SB 1108",
        "billPrefix": "SB",
        "billSuffix": 1108,
        "session": "261",
        "chamber": "senate",
        "title": "Regulates human and pet cemeteries",
        "briefDescription": "This act defines human and pet cemeteries as cemeteries for purposes of licensing and endowed care under state law.  A \"human and pet cemetery\" is defined in the act as a tract of real estate separate from a cemetery in which both human remains and animal remains may be interred and memorialized at the discretion of the lot holder.",
        "lrNumber": "4776S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:agriculture_food_production_and_outdoor_resources",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "194",
        "id": "bill:sb1108:261",
        "createdAt": "2026-01-16T22:23:06.237Z",
        "updatedAt": "2026-01-19T20:13:26.446Z"
      },
      "bill:sb1109:261": {
        "billNumber": "SB 1109",
        "billPrefix": "SB",
        "billSuffix": 1109,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals provisions relating to the caseload of public defenders",
        "briefDescription": "Under current law, a judge can order that a case be placed on a waiting list for defender services if the judge determines the public defender will be unable to provide effective assistance of counsel due to caseload issues.",
        "lrNumber": "5073S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "195",
        "id": "bill:sb1109:261",
        "createdAt": "2026-01-16T22:23:10.260Z",
        "updatedAt": "2026-01-19T20:13:48.524Z"
      },
      "bill:sb1110:261": {
        "billNumber": "SB 1110",
        "billPrefix": "SB",
        "billSuffix": 1110,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the composition of the State Tax Commission",
        "briefDescription": "Current law provides that the State Tax Commission shall be composed of three members, with no more than two members from the same political party.  This act increases the number of commissioners to five, with no more than three members from the same political party.",
        "lrNumber": "5408S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:select_committee_on_property_taxes_and_the_state_tax_commission",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "641",
        "id": "bill:sb1110:261",
        "createdAt": "2026-01-16T22:23:14.268Z",
        "updatedAt": "2026-01-19T20:13:50.548Z"
      },
      "bill:sb1111:261": {
        "billNumber": "SB 1111",
        "billPrefix": "SB",
        "billSuffix": 1111,
        "session": "261",
        "chamber": "senate",
        "title": "Increases the homestead exemption",
        "briefDescription": "Current bankruptcy law provides for a homestead exemption provided the value of the homestead does not exceed $15,000.  This act increases the value to $50,000.",
        "lrNumber": "5561S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:insurance_and_banking",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "642",
        "id": "bill:sb1111:261",
        "createdAt": "2026-01-16T22:23:18.297Z",
        "updatedAt": "2026-01-19T20:13:52.532Z"
      },
      "bill:sb1112:261": {
        "billNumber": "SB 1112",
        "billPrefix": "SB",
        "billSuffix": 1112,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a sales tax exemption for breast pump supplies",
        "briefDescription": "This act authorizes a sales tax exemption for breast pump supplies, as such term is defined in the act.",
        "lrNumber": "5419S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "643",
        "id": "bill:sb1112:261",
        "createdAt": "2026-01-16T22:23:22.308Z",
        "updatedAt": "2026-01-19T20:13:54.540Z"
      },
      "bill:sb1113:261": {
        "billNumber": "SB 1113",
        "billPrefix": "SB",
        "billSuffix": 1113,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to insurance coverage of genetic screenings for cancer risk",
        "briefDescription": "This act requires health benefit plans to provide coverage for genetic testing and genetic counseling, as defined in the act, of individuals who are at increased risk of potentially harmful mutations to their genes due to a personal or family history of cancer.",
        "lrNumber": "3361S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:insurance_and_banking",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "679",
        "id": "bill:sb1113:261",
        "createdAt": "2026-01-16T22:23:26.371Z",
        "updatedAt": "2026-01-19T20:13:56.544Z"
      },
      "bill:sb1114:261": {
        "billNumber": "SB 1114",
        "billPrefix": "SB",
        "billSuffix": 1114,
        "session": "261",
        "chamber": "senate",
        "title": "Requires health benefit plans to cover prostheses for hair loss due to cancer treatment",
        "briefDescription": "This act requires health benefit plans to provide coverage for prostheses and scalp hair prostheses worn for hair loss suffered as a result of cancer treatment.",
        "lrNumber": "3359S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:insurance_and_banking",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "680",
        "id": "bill:sb1114:261",
        "createdAt": "2026-01-16T22:23:30.334Z",
        "updatedAt": "2026-01-19T20:13:58.548Z"
      },
      "bill:sb1115:261": {
        "billNumber": "SB 1115",
        "billPrefix": "SB",
        "billSuffix": 1115,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to street light maintenance districts",
        "briefDescription": "This act moves elections for street light maintenance district board members from the November general election to the April general municipal election.  The act modifies language to note that the election of new board members shall take place biennially, as is currently provided by law.  The act also provides that nominations shall be filed with the election authority, rather than that they may be filed with the secretary of the board. (Section 235.140.1)",
        "lrNumber": "3815S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "681",
        "id": "bill:sb1115:261",
        "createdAt": "2026-01-16T22:23:34.336Z",
        "updatedAt": "2026-01-19T20:14:00.567Z"
      },
      "bill:sb1116:261": {
        "billNumber": "SB 1116",
        "billPrefix": "SB",
        "billSuffix": 1116,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to nuclear energy projects",
        "briefDescription": "The act establishes the \"Missouri Nuclear Energy Advancement Act\".",
        "lrNumber": "5241S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:commerce_consumer_protection_energy_the_environment",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "135",
        "id": "bill:sb1116:261",
        "createdAt": "2026-01-16T22:23:38.350Z",
        "updatedAt": "2026-01-19T20:14:02.581Z"
      },
      "bill:sb1117:261": {
        "billNumber": "SB 1117",
        "billPrefix": "SB",
        "billSuffix": 1117,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions relating to the civil and criminal liability of disclosure of intimate digital depictions",
        "briefDescription": "This act establishes \"The Taylor Swift Act\" which establishes a cause of action against a person who discloses a digital depiction, as defined in this act, of an individual who is under eighteen years of age or an intimate digital depiction, as defined in this act, of an individual and who knows or recklessly disregards the fact that the individual has not consented to such disclosure as provided in the act. The depicted individual may recover damages as described in the act along with injunctiv",
        "lrNumber": "4960S.03I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "136",
        "id": "bill:sb1117:261",
        "createdAt": "2026-01-16T22:23:42.362Z",
        "updatedAt": "2026-01-19T20:14:04.580Z"
      },
      "bill:sb1118:261": {
        "billNumber": "SB 1118",
        "billPrefix": "SB",
        "billSuffix": 1118,
