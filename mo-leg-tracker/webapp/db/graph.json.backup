        "billPrefix": "SB",
        "billSuffix": 1273,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions relating to school property",
        "briefDescription": "Under this act, cities, counties, and school districts (defined as \"political subdivisions\") shall not adopt or enforce any ordinance, policy, resolution, deed restriction, property use restriction, or other such restriction that prevents property they sell, lease, or transfer from being used for any lawful educational purpose by a charter school.",
        "lrNumber": "5019S.02I",
