      },
      "bill:sb1503:261": {
        "billNumber": "SB 1503",
        "billPrefix": "SB",
        "billSuffix": 1503,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the use of fees from watercraft certifications",
        "briefDescription": "Currently, the first $2 million of fees collected for watercraft certification shall be deposited into the state general revenue fund.  All fees in excess of $2 million are deposited into the Water Patrol Division Fund.",
        "lrNumber": "6484S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
