      "bill:sb1075:261": {
        "billNumber": "SB 1075",
        "billPrefix": "SB",
        "billSuffix": 1075,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the \"Food is Medicine Act\"",
        "briefDescription": "This act creates the \"Food is Medicine Act\".  Under this act, the Department of Social Services shall submit a waiver to the Centers for Medicare and Medicaid Services for a \"Food is Medicine\" program.  The program shall be designed to improve health outcomes for MO HealthNet participants with nutrition-related chronic diseases through nutrition services and to reduce the need for medical care for those participants.  Covered nutrition services may include case management, nutrition counseling, ",
        "lrNumber": "4239S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
