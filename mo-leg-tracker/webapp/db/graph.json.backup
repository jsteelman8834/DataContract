      "bill:sb963:261": {
        "billNumber": "SB 963",
        "billPrefix": "SB",
        "billSuffix": 963,
        "session": "261",
        "chamber": "senate",
        "title": "Requires school districts and charter schools to offer students who are 17 1/2 years old the opportunity to register to vote",
        "briefDescription": "At least twice during each school year, this act requires school districts and charter schools to offer students who are at least 17 1/2 years old the opportunity to register to vote.  The first opportunity shall occur during school hours on the fourth Tuesday in September.  The second opportunity shall occur at a later time and shall be conducted by the local election authority in whose jurisdiction the school district or charter school is located.  The school district or charter school shall c",
        "lrNumber": "4324S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
