        "createdAt": "2026-01-16T22:31:23.881Z",
        "updatedAt": "2026-01-19T20:21:56.442Z"
      },
      "bill:sb1233:261": {
        "billNumber": "SB 1233",
        "billPrefix": "SB",
        "billSuffix": 1233,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to licensing of accountants",
        "briefDescription": "This act modifies the requirements for licensing of accountants. This act provides that an applicant for examination shall provide proof that the applicant has obtained a baccalaureate degree or a post-baccalaureate degree, instead of proof of completion of at least 120 semester hours of college education.",
        "lrNumber": "5607S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
