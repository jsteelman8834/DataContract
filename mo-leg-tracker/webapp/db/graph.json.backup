      },
      "bill:sb1247:261": {
        "billNumber": "SB 1247",
        "billPrefix": "SB",
        "billSuffix": 1247,
        "session": "261",
        "chamber": "senate",
        "title": "Provides that certified registered nurse anesthetists may select, issue orders for, and administer certain controlled substances",
        "briefDescription": "This act provides that a certified registered nurse anesthetist (\"CRNA\") may select, issue orders for, and administer certain controlled substances for and while providing anesthesia care to a patient in a licensed facility pursuant to state law. This act shall not be construed as authorizing a CRNA to prescribe such controlled substances and a CRNA shall not be required to obtain a certificate of controlled substance prescriptive authority from the Board of Nursing in order to exercise this pre",
        "lrNumber": "4729S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "264",
        "id": "bill:sb1247:261",
        "createdAt": "2026-01-16T22:32:24.107Z",
        "updatedAt": "2026-01-19T20:22:46.603Z"
      },
      "bill:sb1248:261": {
        "billNumber": "SB 1248",
        "billPrefix": "SB",
        "billSuffix": 1248,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions with respect to acquisition of real property by foreign interests",
        "briefDescription": "This act creates new provisions prohibiting the acquisition and ownership of real property by certain foreign interests.",
        "lrNumber": "5077S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "458",
        "id": "bill:sb1248:261",
        "createdAt": "2026-01-16T22:32:28.119Z",
        "updatedAt": "2026-01-19T20:22:48.644Z"
      },
      "bill:sb1249:261": {
        "billNumber": "SB 1249",
        "billPrefix": "SB",
        "billSuffix": 1249,
        "session": "261",
        "chamber": "senate",
        "title": "Allows the Director of Public Safety to deny certain individuals a peace officer license or entry into basic training courses",
        "briefDescription": "This act provides that the Director of the Department of Public Safety shall have cause to deny any application for a peace officer license or entry into a basic training course when the applicant previously had a peace officer license revoked or surrendered or when the applicant is not a citizen of the United States.",
        "lrNumber": "5118S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "459",
        "id": "bill:sb1249:261",
        "createdAt": "2026-01-16T22:32:32.127Z",
        "updatedAt": "2026-01-19T20:23:10.674Z"
      },
      "bill:sb1250:261": {
        "billNumber": "SB 1250",
        "billPrefix": "SB",
        "billSuffix": 1250,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to spousal maintenance",
        "briefDescription": "Under this act, spousal maintenance shall terminated upon the payor reaching full retirement age, as defined in the act, unless otherwise agreed to by both parties.  The payor shall provide the payee reasonable notice in advance of retirement and six months notice shall be presumed to be reasonable.",
        "lrNumber": "5489S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "460",
        "id": "bill:sb1250:261",
        "createdAt": "2026-01-16T22:32:36.139Z",
        "updatedAt": "2026-01-19T20:23:12.709Z"
      },
      "bill:sb1251:261": {
        "billNumber": "SB 1251",
        "billPrefix": "SB",
        "billSuffix": 1251,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to alternative county highway commissions",
        "briefDescription": "Currently, counties that have adopted an alternative form of county highway commission may only abolish it by a vote of the people. This act specifies that it may also be abolished by a vote of the county's governing body. If the alternative form of county highway commission is abolished, the act provides that the county shall adopt either the standard form of county highway commission, or a system of road districts and overseers as provided by law.",
        "lrNumber": "4292S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "300",
        "id": "bill:sb1251:261",
        "createdAt": "2026-01-16T22:32:40.161Z",
        "updatedAt": "2026-01-19T20:23:14.681Z"
      },
      "bill:sb1252:261": {
        "billNumber": "SB 1252",
        "billPrefix": "SB",
        "billSuffix": 1252,
        "session": "261",
        "chamber": "senate",
        "title": "Provides for vehicles operated by canine search and rescue teams to be treated as emergency vehicles",
        "briefDescription": "This act provides for motor vehicles and equipment operated by canine search and rescue teams to be treated as emergency vehicles.",
        "lrNumber": "4284S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "301",
        "id": "bill:sb1252:261",
        "createdAt": "2026-01-16T22:32:44.164Z",
        "updatedAt": "2026-01-19T20:23:16.693Z"
      },
      "bill:sb1253:261": {
        "billNumber": "SB 1253",
        "billPrefix": "SB",
        "billSuffix": 1253,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the penalties for the offense of assault on a law enforcement animal",
        "briefDescription": "This act provides that the offense of assault on a law enforcement animal is a class E felony, instead of a class A misdemeanor. Additionally, this act provides that it shall be a class D felony, instead of a class E felony, if the law enforcement animal is seriously injured to the point of requiring veterinary care or treatment or a class C felony, instead of a class D felony, if the assault results in the death of such animal.",
        "lrNumber": "4032S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "302",
        "id": "bill:sb1253:261",
        "createdAt": "2026-01-16T22:32:48.171Z",
        "updatedAt": "2026-01-19T20:23:18.705Z"
      },
      "bill:sb1254:261": {
        "billNumber": "SB 1254",
        "billPrefix": "SB",
        "billSuffix": 1254,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies and creates provisions regarding licensed medical professionals",
        "briefDescription": "This act modifies and establishes various provisions relating to licensed medical professionals.",
        "lrNumber": "5488S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "475",
        "id": "bill:sb1254:261",
        "createdAt": "2026-01-16T22:32:52.522Z",
        "updatedAt": "2026-01-19T20:23:20.706Z"
      },
      "bill:sb1255:261": {
        "billNumber": "SB 1255",
        "billPrefix": "SB",
        "billSuffix": 1255,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to licensing for mobile food units",
        "briefDescription": "This act provides that any license or permit issued by Jackson County to a mobile food unit or operator shall be sufficient to allow such mobile food unit to operate in all municipalities within the county. Any licensing or permitting requirement imposed by a municipality that is more strict than the licensing or permitting requirements imposed by the county shall be null and void.",
        "lrNumber": "3833S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "168",
        "id": "bill:sb1255:261",
        "createdAt": "2026-01-16T22:32:56.210Z",
        "updatedAt": "2026-01-19T20:23:22.765Z"
      },
      "bill:sb1256:261": {
        "billNumber": "SB 1256",
        "billPrefix": "SB",
        "billSuffix": 1256,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the Uniform Commercial Code",
        "briefDescription": "This act modifies various provisions relating to the Uniform Commercial Code.",
        "lrNumber": "3830S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "177",
        "id": "bill:sb1256:261",
        "createdAt": "2026-01-16T22:33:00.227Z",
        "updatedAt": "2026-01-19T20:23:24.737Z"
      },
      "bill:sb1257:261": {
        "billNumber": "SB 1257",
        "billPrefix": "SB",
        "billSuffix": 1257,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to drivers' duty to secure child passengers",
        "briefDescription": "This act specifies that children under the age of 2 years riding in motor vehicles shall be secured in rear-facing child passenger restraint systems; except that the child may be secured in a front-facing system once the child reaches the highest rear-facing weight or height established by the restraint system's manufacturer.",
        "lrNumber": "3852S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "534",
        "id": "bill:sb1257:261",
        "createdAt": "2026-01-16T22:33:04.249Z",
        "updatedAt": "2026-01-19T20:23:26.720Z"
      },
      "bill:sb1258:261": {
        "billNumber": "SB 1258",
        "billPrefix": "SB",
        "billSuffix": 1258,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the retirement allowance multiplier for certain members of the Public School Retirement System",
        "briefDescription": "Current law provides that the normal retirement allowance multiplier for a member of the Public School Retirement System of Missouri is 2.5% of the member's final average salary for each year of the membership service, except if the member has 32 years or more of service, then the multiplier shall be 2.55%. This act provides that for those members with 33 years of service or more the multiplier factor shall be 2.6%.",
        "lrNumber": "3903S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "535",
        "id": "bill:sb1258:261",
        "createdAt": "2026-01-16T22:33:08.270Z",
        "updatedAt": "2026-01-19T20:23:28.728Z"
      },
      "bill:sb1259:261": {
        "billNumber": "SB 1259",
        "billPrefix": "SB",
        "billSuffix": 1259,
        "session": "261",
        "chamber": "senate",
        "title": "Allows campaign funds to be used for eligible childcare costs",
        "briefDescription": "This act permits contributions made to any committee organized under Missouri campaign finance law to be used for any childcare expenses, as described in the act, that result directly from campaigning for office or in connection with the duties of public office that would not have been otherwise incurred but for those activities.",
        "lrNumber": "4107S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "536",
        "id": "bill:sb1259:261",
        "createdAt": "2026-01-16T22:33:12.282Z",
        "updatedAt": "2026-01-19T20:23:50.812Z"
      },
      "bill:sb1260:261": {
        "billNumber": "SB 1260",
        "billPrefix": "SB",
        "billSuffix": 1260,
        "session": "261",
        "chamber": "senate",
        "title": "Requires child care facilities to adopt allergy policies",
        "briefDescription": "This act changes \"epinephrine auto-injector\" to \"epinephrine delivery device\" throughout statute.",
        "lrNumber": "4650S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2025-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
