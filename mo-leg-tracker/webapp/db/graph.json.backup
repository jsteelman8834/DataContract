      "bill:sb1132:261": {
        "billNumber": "SB 1132",
        "billPrefix": "SB",
        "billSuffix": 1132,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies procedures for counting ballots",
        "briefDescription": "Current law permits and regulates the usage of automatic tabulating equipment, electronic voting machines, and voting machines in elections. This act repeals those provisions and, except as provided below, requires all ballots to be cast in paper form and hand-counted, as stipulated in law.",
        "lrNumber": "4599S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
