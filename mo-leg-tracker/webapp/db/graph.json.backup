        "billSuffix": 938,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies certain provisions relating to land surveying",
        "briefDescription": "Under the act, a user fee of five dollars, instead of four dollars as currently provided, shall be charged and collected by every recorder of deeds as a condition precedent to the recording of any instrument.",
        "lrNumber": "5423S.01I",
        "currentStatus": "referred",
