      "bill:sb1063:261": {
        "billNumber": "SB 1063",
        "billPrefix": "SB",
        "billSuffix": 1063,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes an income tax deduction for certain survivor benefits",
        "briefDescription": "Current law authorizes an income tax deduction for retirement benefits received by a taxpayer as a result of service in the Armed Forces of the United States. This act also allows for the deduction of any survivor benefits derived from such service.",
        "lrNumber": "4328S.01I",
        "currentStatus": "referred",
