      "bill:sb1413:261": {
        "billNumber": "SB 1413",
        "billPrefix": "SB",
        "billSuffix": 1413,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals certain provisions relating to contingency fee contracts with private attorneys retained by the state",
        "briefDescription": "Currently, the fee that a private attorney retained by the state is entitled to receive is limited based on a percentage of the amount that is recovered. Current law also provides that the total fee payable to all retained private attorneys in any matter that is the subject of a contingency fee contract shall not exceed $10 million. Furthermore, contingency fees shall only be payable from moneys received from judgments or settlement agreements and shall be based on any amount attributable to a f",
        "lrNumber": "5890S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
