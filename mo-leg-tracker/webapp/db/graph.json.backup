        "id": "bill:sb1075:261",
        "createdAt": "2026-01-16T22:20:40.671Z",
        "updatedAt": "2026-01-19T20:11:19.996Z"
      },
      "bill:sb1076:261": {
        "billNumber": "SB 1076",
        "billPrefix": "SB",
        "billSuffix": 1076,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits the seizure of certain property for delinquent taxes",
        "briefDescription": "This act prohibits the seizure of personal property and certain real property that is used as the owner's primary residence solely because the owner of such property owes taxes on such property.",
        "lrNumber": "4833S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:select_committee_on_property_taxes_and_the_state_tax_commission",
