        "billPrefix": "SB",
        "billSuffix": 1059,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to certain homeowners' association restrictions",
        "briefDescription": "Current law prohibits any deed restriction, covenant, or other binding agreement adopted by a homeowners' association from prohibiting ownership or pasturing of up to six chickens on a lot that is 0.2 acre or larger.  This act makes a technical change to such provision.",
        "lrNumber": "5683S.01I",
