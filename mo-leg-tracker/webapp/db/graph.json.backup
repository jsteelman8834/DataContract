      "bill:sb1088:261": {
        "billNumber": "SB 1088",
        "billPrefix": "SB",
        "billSuffix": 1088,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the classification of certain residential real property",
        "briefDescription": "This act modifies the definition of \"residential property\" for the purposes of the taxation of real property by providing that such definition shall include single family homes that are owned by a sole proprietor, individual, partnership, or limited liability company and leased, in whole or in part, for a term of less than thirty consecutive days.",
        "lrNumber": "4427S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:select_committee_on_property_taxes_and_the_state_tax_commission",
        "effectiveDate": "2026-08-28",
