      },
      "bill:sb1387:261": {
        "billNumber": "SB 1387",
        "billPrefix": "SB",
        "billSuffix": 1387,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to autopsies",
        "briefDescription": "This act requires coroners and medical examiners, in cases of certain sudden and unexplained deaths involving individuals under 20 years of age, to include microscopic and toxicology studies and a review of the individual's medical and vaccination records in the autopsy.  Additionally, the coroner or medical examiner shall report such cases to the Sudden Unexpected Infant Death (SUID) and Sudden Death in the Young (SDY) Case Registry established by the Centers for Disease Control and Prevention ",
        "lrNumber": "5645S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "354",
        "id": "bill:sb1387:261",
        "createdAt": "2026-01-16T22:41:46.024Z",
        "updatedAt": "2026-01-19T20:32:08.587Z"
      },
      "bill:sb1388:261": {
        "billNumber": "SB 1388",
        "billPrefix": "SB",
        "billSuffix": 1388,
        "session": "261",
        "chamber": "senate",
        "title": "Provides for the county prosecuting attorney system to be converted to a circuit court district attorney system",
        "briefDescription": "This act provides for the county prosecuting attorney system to be converted to a circuit court district attorney system. District attorneys shall be first elected for terms of four years during the 2028 general election in each judicial circuit for counties that elect to be part of the system. In the 2032 general election, district attorneys shall be elected for each judicial circuit. The district attorney shall be a resident of the judicial circuit for one year before being elected and shall r",
        "lrNumber": "5764S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "553",
        "id": "bill:sb1388:261",
        "createdAt": "2026-01-16T22:41:50.044Z",
        "updatedAt": "2026-01-19T20:32:10.590Z"
      },
      "bill:sb1389:261": {
        "billNumber": "SB 1389",
        "billPrefix": "SB",
        "billSuffix": 1389,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes a cause of action against business for violations of privacy in changing facilities or restrooms",
        "briefDescription": "This act provides that any individual may bring a cause of action against a business entity that has a policy allowing for individuals of one biological sex into changing facilities or restrooms designated for use by the opposite biological sex and in which the individual's privacy or expectation of privacy was violated in a changing facility or restroom that matched the individual's biological sex by an individual of the opposite biological sex. The prevailing plaintiff shall be entitled to rec",
        "lrNumber": "5761S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "554",
        "id": "bill:sb1389:261",
        "createdAt": "2026-01-16T22:41:54.059Z",
        "updatedAt": "2026-01-19T20:32:32.692Z"
      },
      "bill:sb1390:261": {
        "billNumber": "SB 1390",
        "billPrefix": "SB",
        "billSuffix": 1390,
        "session": "261",
        "chamber": "senate",
        "title": "WITHDRAWN",
        "briefDescription": "WITHDRAWN",
        "lrNumber": "5765S.01I",
        "currentStatus": "withdrawn",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2025-12-05",
        "withdrawn": false,
        "senateBillId": "555",
        "id": "bill:sb1390:261",
        "createdAt": "2026-01-16T22:41:58.082Z",
        "updatedAt": "2026-01-19T20:32:34.708Z"
      },
      "bill:sb1391:261": {
        "billNumber": "SB 1391",
        "billPrefix": "SB",
        "billSuffix": 1391,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the appointment of counsel for postconviction relief of sentences of death",
        "briefDescription": "This act modifies provisions relating to the appointment of counsel for postconviction relief of sentences of death. Current law provides that when a motion to set aside a sentence of death is filed, the court shall find on the record whether the movant is indigent and if so, the court shall appoint two counsel. This act instead provides that when a circuit court imposes a judgment and sentence of death, the circuit court shall find on the record whether the defendant is indigent. If finding so,",
        "lrNumber": "5762S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "556",
        "id": "bill:sb1391:261",
        "createdAt": "2026-01-16T22:42:02.090Z",
        "updatedAt": "2026-01-19T20:32:36.703Z"
      },
      "bill:sb1392:261": {
        "billNumber": "SB 1392",
        "billPrefix": "SB",
        "billSuffix": 1392,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the offense of murder in the first degree",
        "briefDescription": "This act provides that a person commits the offense of murder in the first degree if he or she knowingly delivers or distributes fentanyl or carfentanil and death results from the use of such substances. This offense is a class A felony, and if the person is over the age of 18, the punishment shall be either death or imprisonment for life without eligibility for probation or parole.",
        "lrNumber": "5763S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "557",
        "id": "bill:sb1392:261",
        "createdAt": "2026-01-16T22:42:06.107Z",
        "updatedAt": "2026-01-19T20:32:38.711Z"
      },
      "bill:sb1393:261": {
        "billNumber": "SB 1393",
        "billPrefix": "SB",
        "billSuffix": 1393,
        "session": "261",
        "chamber": "senate",
        "title": "Increases the number of circuit and associate circuit judges in the 11th Judicial Circuit, consisting of St. Charles County",
        "briefDescription": "Currently, there are six circuit judges and nine associate circuit judges in the 11th Judicial District, located in St. Charles County. This act provides for an additional two circuit judges and one associate circuit judge. The new judges shall be elected in 2028 with terms beginning January 1, 2029. The new associate circuit judge position shall not be included in the automatic increases in the number of associate judge positions provided by the statutory formula based on population.",
        "lrNumber": "5766S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "558",
        "id": "bill:sb1393:261",
        "createdAt": "2026-01-16T22:42:10.114Z",
        "updatedAt": "2026-01-19T20:32:40.733Z"
      },
      "bill:sb1394:261": {
        "billNumber": "SB 1394",
        "billPrefix": "SB",
        "billSuffix": 1394,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the commissioners of the Public Service Commission",
        "briefDescription": "Currently, the Public Service Commission shall consist of five members.",
        "lrNumber": "5872S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "692",
        "id": "bill:sb1394:261",
        "createdAt": "2026-01-16T22:42:14.123Z",
        "updatedAt": "2026-01-19T20:32:42.761Z"
      },
      "bill:sb1395:261": {
        "billNumber": "SB 1395",
        "billPrefix": "SB",
        "billSuffix": 1395,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the unauthorized practice of law as it relates to the use of artificial intelligence",
        "briefDescription": "Unless duly licensed in this state to practice law or law business, it is the unauthorized practice of law for any person, association, partnership, limited liability company, or corporation to provide papers, pleadings, or documents to be used in connection with pending or prospective court or administrative proceedings that are produced or generated through the use of artificial intelligence.",
        "lrNumber": "5254S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "691",
        "id": "bill:sb1395:261",
        "createdAt": "2026-01-16T22:42:18.148Z",
        "updatedAt": "2026-01-19T20:32:44.736Z"
      },
      "bill:sb1396:261": {
        "billNumber": "SB 1396",
        "billPrefix": "SB",
        "billSuffix": 1396,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals and creates new provisions relating to discounts by electrical corporations",
        "briefDescription": "The act repeals certain provisions and creates new provisions relating to discounts by electrical corporations.",
        "lrNumber": "5853S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "688",
        "id": "bill:sb1396:261",
        "createdAt": "2026-01-16T22:42:22.154Z",
        "updatedAt": "2026-01-19T20:32:46.751Z"
      },
      "bill:sb1397:261": {
        "billNumber": "SB 1397",
        "billPrefix": "SB",
        "billSuffix": 1397,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies and creates new provisions relating to water regulation",
        "briefDescription": "Under the act, a person who has contracted for the right to store water in a reservoir owned by the United States Army Corps of Engineers shall have exclusive rights to any return flows from the reservoir. The rights shall be subject to regulatory requirements imposed by the state and to the availability of unused storage capacity within the reservoir.",
        "lrNumber": "5858S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "689",
        "id": "bill:sb1397:261",
        "createdAt": "2026-01-16T22:42:26.187Z",
        "updatedAt": "2026-01-19T20:32:48.754Z"
      },
      "bill:sb1398:261": {
        "billNumber": "SB 1398",
        "billPrefix": "SB",
        "billSuffix": 1398,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the definition of \"renewable energy resources\" as used in the \"Renewable Energy Standard\"",
        "briefDescription": "The act modifies the definition of \"renewable energy resources\" as used in the \"Renewable Energy Standard\" to include energy derived from nuclear energy sources and hydrogen.",
        "lrNumber": "5828S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "690",
        "id": "bill:sb1398:261",
        "createdAt": "2026-01-16T22:42:30.180Z",
        "updatedAt": "2026-01-19T20:32:50.748Z"
      },
      "bill:sb1399:261": {
        "billNumber": "SB 1399",
        "billPrefix": "SB",
        "billSuffix": 1399,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Unemployment Administration Adjustment Fund",
        "briefDescription": "This act requires each employer liable for contributions pursuant to the unemployment compensation law to pay an annual unemployment administration adjustment in an amount equal to five one-hundredths of one percent of such employer's total taxable wages for the twelve-month period ending the preceding June 30.  Each employer liable to pay an unemployment administration adjustment shall be notified of the amount due under this act by March thirty-first of each year and such amount shall be consi",
        "lrNumber": "5295S.03I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "694",
        "id": "bill:sb1399:261",
        "createdAt": "2026-01-16T22:42:34.194Z",
        "updatedAt": "2026-01-19T20:33:12.838Z"
      },
      "bill:sb1400:261": {
        "billNumber": "SB 1400",
        "billPrefix": "SB",
        "billSuffix": 1400,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the damages available for the unauthorized practice of law",
        "briefDescription": "This act provides that any person, association, partnership, limited liability company, or corporation who commits the unauthorized practice of law may be sued for treble the amount of actual damages resulting from the unauthorized practice by the person or entity paying for the service.",
        "lrNumber": "5901S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
