        "billPrefix": "SB",
        "billSuffix": 1414,
        "session": "261",
        "chamber": "senate",
        "title": "Conveys certain state property",
        "briefDescription": "The act authorizes the conveyance of certain state property located in Cole County to the City of Jefferson.",
        "lrNumber": "5937S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
