        "updatedAt": "2026-01-19T20:25:55.233Z"
      },
      "bill:sb1292:261": {
        "billNumber": "SB 1292",
        "billPrefix": "SB",
        "billSuffix": 1292,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to emergency transportation of patients to abortion facilities",
        "briefDescription": "Under this act, no provider of ambulance service within Missouri shall provide a patient emergency medical transportation to an abortion facility, or otherwise be directed to provide such transportation.",
        "lrNumber": "4147S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
