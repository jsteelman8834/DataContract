      },
      "bill:sb1519:261": {
        "billNumber": "SB 1519",
        "billPrefix": "SB",
        "billSuffix": 1519,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Respiratory Care Interstate Compact",
        "briefDescription": "This act establishes the Respiratory Care Interstate Compact (\"Compact\"), which allows for the interstate practice of respiratory therapy. The Compact sets forth the requirements to be met in order for a state to join and maintain membership in the Compact. Additionally, the Compact provides the requirements for a respiratory therapist to obtain and exercise the ability to practice in the remote participating states.",
        "lrNumber": "5905S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
