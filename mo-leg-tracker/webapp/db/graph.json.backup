      },
      "bill:sb1189:261": {
        "billNumber": "SB 1189",
        "billPrefix": "SB",
        "billSuffix": 1189,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to juvenile detention centers",
        "briefDescription": "Currently, circuit judges of a judicial circuit may establish a place of juvenile detention for the counties within the circuit court. This act provides that a county commission or governing body of a county may provide for juvenile detention in coordination with all other counties within the same circuit court or with all counties of the same circuit court and all counties of an adjoining circuit court. The county commission or governing body shall approve an ordinance, order, or resolution aut",
        "lrNumber": "4668S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-26",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "102",
        "id": "bill:sb1189:261",
        "createdAt": "2026-01-16T22:28:31.272Z",
        "updatedAt": "2026-01-19T20:19:09.784Z"
      },
      "bill:sb1190:261": {
        "billNumber": "SB 1190",
        "billPrefix": "SB",
        "billSuffix": 1190,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to medical malpractice actions against health care providers for gender transition services",
        "briefDescription": "This act provides that in actions against health care providers where the act of neglect complained of is related to the provision of gender transition surgeries or gender transition services or the prescription or administration of cross-sex hormones or puberty-blocking drugs, the action shall be brought within 15 years from the date of discovery of the injury and of the causal relationship between the injury and actions of the health care provider.",
        "lrNumber": "5445S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "586",
        "id": "bill:sb1190:261",
        "createdAt": "2026-01-16T22:28:35.296Z",
        "updatedAt": "2026-01-19T20:19:11.825Z"
      },
      "bill:sb1191:261": {
        "billNumber": "SB 1191",
        "billPrefix": "SB",
        "billSuffix": 1191,
        "session": "261",
        "chamber": "senate",
        "title": "Exempts certain families from income tax",
        "briefDescription": "For all tax years beginning on or after January 1, 2027, this act exempts from state income taxes all taxpayers with three or more children for which the taxpayer is entitled to a dependency exemption for federal income tax purposes.",
        "lrNumber": "4456S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "106",
        "id": "bill:sb1191:261",
        "createdAt": "2026-01-16T22:28:39.306Z",
        "updatedAt": "2026-01-19T20:19:13.809Z"
      },
      "bill:sb1192:261": {
        "billNumber": "SB 1192",
        "billPrefix": "SB",
        "billSuffix": 1192,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits higher education accrediting agencies from considering diversity, equity, and inclusion practices",
        "briefDescription": "This act prohibits agencies that accredit public institutions of higher education from considering diversity, equity, and inclusion (DEI) practices or procedures, as defined in the act, when making accreditation decisions.  Accrediting agencies are also prohibited from collecting information related to DEI or including any DEI-related requirements in their accreditation decisions.  Additionally, accrediting agencies shall implement policies ensuring that decision-makers involved in accreditation",
        "lrNumber": "4636S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "253",
        "id": "bill:sb1192:261",
        "createdAt": "2026-01-16T22:28:43.312Z",
        "updatedAt": "2026-01-19T20:19:15.821Z"
      },
      "bill:sb1193:261": {
        "billNumber": "SB 1193",
        "billPrefix": "SB",
        "billSuffix": 1193,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits expenditures by state departments for certain diversity initiatives",
        "briefDescription": "This act prohibits any state department from expending funds, allocating funds, or making any other gift or expense for intradepartmental programs, staffing, or other initiatives associated with \"diversity, equity, and inclusion\" or \"diversity, inclusion, and belonging\" or any other similar initiative, as described in the act. This act does not prohibit state departments from following anti-discrimination laws or complying with the federal Americans with Disabilities Act.",
        "lrNumber": "4842S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "248",
        "id": "bill:sb1193:261",
        "createdAt": "2026-01-16T22:28:47.345Z",
        "updatedAt": "2026-01-19T20:19:17.828Z"
      },
      "bill:sb1194:261": {
        "billNumber": "SB 1194",
        "billPrefix": "SB",
        "billSuffix": 1194,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes new accountability measures for public schools, charter schools, school districts, and the Department of Elementary and Secondary Education",
        "briefDescription": "This act repeals provisions relating to annual report cards for elementary and secondary schools and establishes new accountability measures for all public schools, charter schools, school districts, and the Missouri Department of Elementary and Secondary Education (DESE).",
        "lrNumber": "5809S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "582",
        "id": "bill:sb1194:261",
        "createdAt": "2026-01-16T22:28:51.349Z",
        "updatedAt": "2026-01-19T20:19:19.848Z"
      },
      "bill:sb1195:261": {
        "billNumber": "SB 1195",
        "billPrefix": "SB",
        "billSuffix": 1195,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes fire protection districts to transfer surplus property",
        "briefDescription": "This act authorizes the board of directors of a fire protection district to distribute surplus supplies or property to volunteer fire protection associations, other fire protection districts, fire departments, or to eligible donees, as described in the act.",
        "lrNumber": "4428S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "590",
        "id": "bill:sb1195:261",
        "createdAt": "2026-01-16T22:28:55.381Z",
        "updatedAt": "2026-01-19T20:19:21.850Z"
      },
      "bill:sb1196:261": {
        "billNumber": "SB 1196",
        "billPrefix": "SB",
        "billSuffix": 1196,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to grants for certain workforce training programs",
        "briefDescription": "This act requires the Governor, in consultation with the Missouri Workforce Development Board, to approve workforce training programs that are eligible for federal Workforce Pell Grants if they prepare students for a high-skill industry sector or occupation, a high-wage industry sector or occupation, or an in-demand industry sector or occupation, as such terms are defined in the act.",
        "lrNumber": "5629S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "591",
        "id": "bill:sb1196:261",
        "createdAt": "2026-01-16T22:28:59.374Z",
        "updatedAt": "2026-01-19T20:19:23.860Z"
      },
      "bill:sb1197:261": {
        "billNumber": "SB 1197",
        "billPrefix": "SB",
        "billSuffix": 1197,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts the \"Alexander Whalen Safe Highways Act\" pertaining to wrong-way vehicle detection systems",
        "briefDescription": "This act establishes the \"Alexander Whalen Safe Highways Act\", requiring the Department of Transportation to implement wrong-way vehicle detection systems (WWVDSs), as defined in the act.  Implementation shall begin no later than March 1, 2027, and shall prioritize certain interchanges, as specified in the act.",
        "lrNumber": "4863S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "455",
        "id": "bill:sb1197:261",
        "createdAt": "2026-01-16T22:29:03.388Z",
        "updatedAt": "2026-01-19T20:19:25.885Z"
      },
      "bill:sb1198:261": {
        "billNumber": "SB 1198",
        "billPrefix": "SB",
        "billSuffix": 1198,
        "session": "261",
        "chamber": "senate",
        "title": "Requires public schools to provide instruction in human growth and development",
        "briefDescription": "Under this act, all public schools shall provide instruction in human growth and development as part of their curriculum.  Topics to be covered include human biology related to pregnancy, human development inside the womb, and visual materials including a high-definition ultrasound video illustrating early organ development and a computer-generated animation depicting fertilization and each stage of fetal growth through birth.  The curriculum shall be presented to students in grades 1-6 in an ag",
        "lrNumber": "4867S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "456",
        "id": "bill:sb1198:261",
        "createdAt": "2026-01-16T22:29:07.396Z",
        "updatedAt": "2026-01-19T20:19:27.886Z"
      },
      "bill:sb1199:261": {
        "billNumber": "SB 1199",
        "billPrefix": "SB",
        "billSuffix": 1199,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits certain diversity initiatives in public bodies",
        "briefDescription": "This act prohibits any department, division, or other entity of the state, or any political subdivision from expending funds for intradepartmental programs, staffing, or other initiatives associated with \"diversity, equity, and inclusion\" or \"diversity, inclusion, and belonging\" or any other similar initiative, as described in the act. This act does not prohibit state departments from following anti-discrimination laws or complying with the federal Americans with Disabilities Act.",
        "lrNumber": "5092S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "457",
        "id": "bill:sb1199:261",
        "createdAt": "2026-01-16T22:29:11.429Z",
        "updatedAt": "2026-01-19T20:19:49.979Z"
      },
      "bill:sb1200:261": {
        "billNumber": "SB 1200",
        "billPrefix": "SB",
        "billSuffix": 1200,
        "session": "261",
        "chamber": "senate",
        "title": "Removes the expiration date on certain provisions relating to gender transition",
        "briefDescription": "Currently, a health care provider shall not knowingly prescribe or administer cross-sex hormones or puberty-blocking drugs for the purpose of a gender transition for children.  This provision of law does not apply to those children who were prescribed or administered such drugs prior to August 28, 2023.",
        "lrNumber": "4146S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "298",
        "id": "bill:sb1200:261",
        "createdAt": "2026-01-16T22:29:15.438Z",
        "updatedAt": "2026-01-19T20:19:52.013Z"
      },
      "bill:sb1201:261": {
        "billNumber": "SB 1201",
        "billPrefix": "SB",
        "billSuffix": 1201,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies election offenses",
        "briefDescription": "This act repeals a law that prohibits a voter from allowing the ballot they are casting to be seen by any person with the intent of letting it be known how the voter is about to vote or has voted.",
        "lrNumber": "4113S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "355",
        "id": "bill:sb1201:261",
        "createdAt": "2026-01-16T22:29:19.458Z",
        "updatedAt": "2026-01-19T20:19:54.002Z"
      },
      "bill:sb1202:261": {
        "billNumber": "SB 1202",
        "billPrefix": "SB",
        "billSuffix": 1202,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the assessment of certain broadband communications equipment",
        "briefDescription": "This act provides that the definition of \"tangible personal property\" shall, for the purposes of property taxation, include machinery and equipment used to provide broadband communications service, as described in the act. (Section 137.010)",
        "lrNumber": "5493S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "299",
        "id": "bill:sb1202:261",
        "createdAt": "2026-01-16T22:29:23.464Z",
        "updatedAt": "2026-01-19T20:19:56.005Z"
      },
      "bill:sb1203:261": {
        "billNumber": "SB 1203",
        "billPrefix": "SB",
        "billSuffix": 1203,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to taxation",
        "briefDescription": "This act modifies provisions relating to taxation.",
        "lrNumber": "4343S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "368",
        "id": "bill:sb1203:261",
        "createdAt": "2026-01-16T22:29:27.471Z",
        "updatedAt": "2026-01-19T20:19:58.021Z"
      },
      "bill:sb1204:261": {
        "billNumber": "SB 1204",
        "billPrefix": "SB",
        "billSuffix": 1204,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to prohibited discriminatory practices",
        "briefDescription": "Current law prohibits discrimination based on sex in various sectors, including housing, employment, and public accommodations. This act creates a definition for the term \"sex\" to mean the two categories of humans, male and female, into which individuals are divided based on an individual's reproductive biology at birth and the individual's genome. The term \"sex\" shall not be construed to include sexual orientation or gender identity.",
        "lrNumber": "4315S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "369",
        "id": "bill:sb1204:261",
        "createdAt": "2026-01-16T22:29:31.502Z",
        "updatedAt": "2026-01-19T20:20:00.016Z"
      },
      "bill:sb1205:261": {
        "billNumber": "SB 1205",
        "billPrefix": "SB",
        "billSuffix": 1205,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the carrying of weapons by the Attorney General",
        "briefDescription": "This act adds the Attorney General and staff of the Attorney General to an exception to the offense of unlawful use of a weapon.",
        "lrNumber": "5576S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "631",
        "id": "bill:sb1205:261",
        "createdAt": "2026-01-16T22:29:35.505Z",
        "updatedAt": "2026-01-19T20:20:02.033Z"
      },
      "bill:sb1206:261": {
        "billNumber": "SB 1206",
        "billPrefix": "SB",
        "billSuffix": 1206,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to documents presented for recording",
        "briefDescription": "Current law provides for a flat $25 fee for recording certain plats of certain size, with an additional fee for additional pages. This act modifies the fee schedule by providing fees for the recording of various plats based on the size of the drawing.",
        "lrNumber": "5477S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "621",
        "id": "bill:sb1206:261",
        "createdAt": "2026-01-16T22:29:39.515Z",
        "updatedAt": "2026-01-19T20:20:04.047Z"
      },
      "bill:sb1207:261": {
        "billNumber": "SB 1207",
        "billPrefix": "SB",
        "billSuffix": 1207,
        "session": "261",
        "chamber": "senate",
        "title": "Requires the Missouri Higher Education Loan Authority to file its annual financial report with the Joint Committee on Education",
        "briefDescription": "Current law requires the Missouri Higher Education Loan Authority to file an annual financial report with the Director of the Department of Higher Education and Workforce Development.  Under this act, such report shall also be filed with the Joint Committee on Education.",
        "lrNumber": "5829S.01I",
        "currentStatus": "first_read",
