      "bill:sb1081:261": {
        "billNumber": "SB 1081",
        "billPrefix": "SB",
        "billSuffix": 1081,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to compensation made by motor vehicle franchisors to franchisees",
        "briefDescription": "Current law requires motor vehicle franchisors to compensate franchisees for the preparation, delivery, and warranty service required of the franchisee by the franchisor, with such compensation to be \"reasonable and adequate\". This act provides that such compensation shall be no less than the amount the retail customer pays for the same services with regard to rate and time. In the event that a schedule of compensation has not been agreed to for warranty repairs, or said schedule does not define",
        "lrNumber": "5617S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "595",
        "id": "bill:sb1081:261",
        "createdAt": "2026-01-16T22:21:04.755Z",
        "updatedAt": "2026-01-19T20:11:52.114Z"
      },
      "bill:sb1082:261": {
        "billNumber": "SB 1082",
        "billPrefix": "SB",
        "billSuffix": 1082,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to a tax credit for donated food",
        "briefDescription": "Current law authorizes a tax credit for donations of cash or food to local food pantries, local soup kitchens, and local homeless shelters in an amount equal to fifty percent of the value of the donation. For all tax years beginning on or after January 1, 2026, this act also authorizes a tax credit for donations of cash or food to local food banks, as defined in the act, and increases the tax credit amount to seventy percent of the value of the donation.",
        "lrNumber": "5426S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "117",
        "id": "bill:sb1082:261",
        "createdAt": "2026-01-16T22:21:08.767Z",
        "updatedAt": "2026-01-19T20:11:54.108Z"
      },
      "bill:sb1083:261": {
        "billNumber": "SB 1083",
        "billPrefix": "SB",
        "billSuffix": 1083,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to requirements for applicants for a respiratory care license",
        "briefDescription": "Currently, an applicant for a respiratory care license is required to submit written evidence of credentials from the cognitive competency testing organization authorized by the Missouri Board for Respiratory Care or current licensure or registration as a respiratory care practitioner in another jurisdiction that meets or exceeds Missouri licensure standards. This act instead provides that the applicant shall submit:",
        "lrNumber": "4018S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:emerging_issues_and_professional_registration",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "116",
        "id": "bill:sb1083:261",
        "createdAt": "2026-01-16T22:21:12.785Z",
        "updatedAt": "2026-01-19T20:11:56.135Z"
      },
      "bill:sb1084:261": {
        "billNumber": "SB 1084",
        "billPrefix": "SB",
        "billSuffix": 1084,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to state funds for regional planning commissions",
        "briefDescription": "Under current law, state funds for the East-West Gateway Coordinating Council and for the Mid-America Regional Council are not to exceed $65,000 and state funds for other regional planning commissions shall not exceed $25,000. This act changes the sums to $130,000 and $50,000.",
        "lrNumber": "4602S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "115",
        "id": "bill:sb1084:261",
        "createdAt": "2026-01-16T22:21:16.802Z",
        "updatedAt": "2026-01-19T20:11:58.147Z"
      },
      "bill:sb1085:261": {
        "billNumber": "SB 1085",
        "billPrefix": "SB",
        "billSuffix": 1085,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits public school staff members from encouraging students in their social transition to being perceived as a member of the opposite biological sex",
        "briefDescription": "This act prohibits public school staff members from encouraging minor students in their \"social transition\", defined as engaging in certain activities with the goal of helping a student become perceived as a member of the opposite biological sex.",
        "lrNumber": "4425S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
