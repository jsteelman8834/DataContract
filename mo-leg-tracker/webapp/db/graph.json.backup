      },
      "bill:sb1551:261": {
        "billNumber": "SB 1551",
        "billPrefix": "SB",
        "billSuffix": 1551,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes certain third class cities to impose a transient guest tax",
        "briefDescription": "This act authorizes any third class city with a city manager form of government to impose a transient guest tax at a rate not to exceed 5%. If the city elects to collect the tax rather than enter into an agreement for the Department of Revenue to collect the tax, then the city shall only use such tax revenues for the promotion of tourism. After the payment of initial bonds, the governing body of the city may submit the question of repealing the transient guest tax to the voters.",
        "lrNumber": "6711S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-13",
