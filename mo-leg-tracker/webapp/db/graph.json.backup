        "createdAt": "2026-01-16T22:21:20.830Z",
        "updatedAt": "2026-01-19T20:12:00.144Z"
      },
      "bill:sb1086:261": {
        "billNumber": "SB 1086",
        "billPrefix": "SB",
        "billSuffix": 1086,
        "session": "261",
        "chamber": "senate",
        "title": "Permits over-the-counter purchase of ivermectin and hydroxychloroquine tablets without a prescription",
        "briefDescription": "Under this act, ivermectin and hydroxychloroquine tablets suitable for human use may be sold or purchased as over-the-counter medications in Missouri without a prescription or consultation with a pharmacist or other health care professional.",
        "lrNumber": "4230S.01I",
