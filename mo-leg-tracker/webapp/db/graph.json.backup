        "billSuffix": 1169,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the offense of unlawful use of weapons",
        "briefDescription": "This act provides that a person shall be guilty of the offense of unlawful use of weapons if he or she carries openly or concealed on his or her person a firearm in the City of St. Louis. It shall be a class A misdemeanor for the first offense and a class E felony for any second or subsequent offenses.",
        "lrNumber": "4787S.01I",
        "currentStatus": "first_read",
