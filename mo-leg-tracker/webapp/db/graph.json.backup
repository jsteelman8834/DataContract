        "createdAt": "2026-01-16T22:58:31.538Z",
        "updatedAt": "2026-01-19T20:41:16.702Z"
      },
      "bill:sb1521:261": {
        "billNumber": "SB 1521",
        "billPrefix": "SB",
        "billSuffix": 1521,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to notifications for increased property assessments",
        "briefDescription": "Current law requires assessors to provide notice to taxpayers when the valuation of the taxpayer's real property has increased. This act requires an assessor to provide any third party documents, reports, or other data that was relied upon in the computation of assessed value.",
        "lrNumber": "6462S.01I",
