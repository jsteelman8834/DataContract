      "bill:sb1525:261": {
        "billNumber": "SB 1525",
        "billPrefix": "SB",
        "billSuffix": 1525,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to public health services",
        "briefDescription": "This act authorizes the Department of Health and Senior Services to contract with a Missouri affiliate of a national public health association or public health institute, or a similar or successor entity, in order to assist in carrying out its duties to promote the health and well-being of Missouri residents.  Such contracts may include efforts to assist in the delivery of health services throughout the state and the administration of grant funds and related programs.  The Department and the des",
        "lrNumber": "6235S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "214884",
        "id": "bill:sb1525:261",
        "createdAt": "2026-01-16T22:58:51.629Z",
        "updatedAt": "2026-01-19T20:41:26.736Z"
      },
      "bill:sb1526:261": {
        "billNumber": "SB 1526",
        "billPrefix": "SB",
        "billSuffix": 1526,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals provisions relating to asbestos testing reports collected by the Department of Health and Senior Services",
        "briefDescription": "This act repeals provisions of current law relating to asbestos testing reports collected by the Department of Health and Senior Services and training provided by the Department.",
        "lrNumber": "6222S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
