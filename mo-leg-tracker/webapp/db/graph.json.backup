        "billPrefix": "SB",
        "billSuffix": 1472,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes the city of Osage Beach to establish an entertainment district",
        "briefDescription": "This act authorizes the city of Osage Beach to establish an entertainment district in which licensed establishments may sell intoxicating liquor by the drink for consumption within the entertainment district during certain hours as provided in the act. Establishments shall apply for an entertainment district special license and shall pay an annual license fee of $300.",
        "lrNumber": "6427S.01I",
