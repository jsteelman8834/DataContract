      "bill:sb1274:261": {
        "billNumber": "SB 1274",
        "billPrefix": "SB",
        "billSuffix": 1274,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to notarization requirements for certain mental health detentions",
        "briefDescription": "This act modifies notarization requirements for applications for detention for evaluation and treatment at a mental health facility.  Under this act, no notarization shall be required for the application or any affidavits, declarations, or other supporting documents filed under certain provisions of law, including when filed in court by an adult, when a peace officer takes a person into custody for detention at the facility for a period of 96 hours, when a person presents themselves at the facil",
