        "createdAt": "2026-01-16T22:57:31.395Z",
        "updatedAt": "2026-01-19T20:40:06.308Z"
      },
      "bill:sb1506:261": {
        "billNumber": "SB 1506",
        "billPrefix": "SB",
        "billSuffix": 1506,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes criminal and civil liability for altered sexual depictions of identifiable persons",
        "briefDescription": "This act establishes the offense of generating, soliciting, or promoting or possessing with the intent to promote an altered sexual depiction, as defined in the act, of an identifiable person. A person commits such offense if the person:",
        "lrNumber": "6400S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
