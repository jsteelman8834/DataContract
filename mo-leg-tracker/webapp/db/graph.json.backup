      "bill:sb890:261": {
        "billNumber": "SB 890",
        "billPrefix": "SB",
        "billSuffix": 890,
        "session": "261",
        "chamber": "senate",
        "title": "Requires state departments to report on obsolete administrative entities, repeals certain administrative entities and repeals and reassigns duties for certain other administrative entities",
        "briefDescription": "SCS/SB 890 -  This act requires each state department with oversight of an administrative entity to submit an annual report to the General Assembly detailing any administrative entity that has not convened a public meeting or conducted public business during the three year period ending on August 28th of such year.",
        "lrNumber": "4254S.01I",
