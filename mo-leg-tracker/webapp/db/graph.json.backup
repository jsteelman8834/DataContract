      },
      "bill:sb1490:261": {
        "billNumber": "SB 1490",
        "billPrefix": "SB",
        "billSuffix": 1490,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to athletic trainers",
        "briefDescription": "Currently, insurers shall issue payments to certain health care providers within 30 days of receipt by the insurer of all documents needed to determine the claim.  This act adds athletic trainers to that list of providers.",
        "lrNumber": "5887S.01I",
        "currentStatus": "first_read",
