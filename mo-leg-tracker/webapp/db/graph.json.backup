      "bill:sb896:261": {
        "billNumber": "SB 896",
        "billPrefix": "SB",
        "billSuffix": 896,
        "session": "261",
        "chamber": "senate",
        "title": "Creates new provisions relating to elections",
        "briefDescription": "The act creates new provisions relating to funds used for election administration. Specifically, government entities, as that term is defined in the act, are prohibited from soliciting, accepting, or using any funds or in-kind goods or services for election administration if those funds or in-kind goods or services are donated directly or indirectly by any person other than a government entity.  An election officer may, however, solicit, accept, or use funds or in-kind goods or services of de mi",
        "lrNumber": "5016S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
