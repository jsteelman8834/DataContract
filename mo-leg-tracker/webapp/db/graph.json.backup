      "bill:sb1458:261": {
        "billNumber": "SB 1458",
        "billPrefix": "SB",
        "billSuffix": 1458,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the collection of DNA samples in criminal cases",
        "briefDescription": "Currently, any person found guilty of a felony offense shall have a fingerprint and DNA sample collected. Additionally, any person over seventeen years of age arrested for certain felony offenses as well as burglary in the first and second degrees must have a fingerprint and DNA sample collected.  This act provides that every person seventeen years of age and older who is arrested for any felony offense as well as the offense of burglary in the second degree must have a fingerprint and DNA sampl",
        "lrNumber": "6299S.01I",
