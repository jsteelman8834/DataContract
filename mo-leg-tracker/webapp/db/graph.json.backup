        "createdAt": "2026-01-16T22:44:10.527Z",
        "updatedAt": "2026-01-19T20:34:41.155Z"
      },
      "bill:sb1424:261": {
        "billNumber": "SB 1424",
        "billPrefix": "SB",
        "billSuffix": 1424,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to credit unions",
        "briefDescription": "This act modifies provisions relating to credit unions. Current law provides that membership shares in a credit union shall have a par value of $25-100. This act changes the par value to $1-100.",
        "lrNumber": "6097S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
