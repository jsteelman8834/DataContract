        "billSuffix": 897,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to prior authorization of health care services",
        "briefDescription": "This act provides that health care providers shall not be required to obtain prior authorization for a health care service unless the health carrier or utilization review entity determines that in the most recent evaluation period, as defined in the act, less than 90% of the prior authorization requests submitted by that provider for that health care service were approved or would have been approved.",
        "lrNumber": "4611S.01I",
