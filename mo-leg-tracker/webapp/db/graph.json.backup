        "createdAt": "2026-01-16T22:58:15.488Z",
        "updatedAt": "2026-01-19T20:40:48.566Z"
      },
      "bill:sb1517:261": {
        "billNumber": "SB 1517",
        "billPrefix": "SB",
        "billSuffix": 1517,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to property taxes",
        "briefDescription": "This act modifies provisions relating to property taxes.",
