        "billSuffix": 1294,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to criminal offenses, including classification of offenses, minimum prison terms, and conditional release",
        "briefDescription": "This act modifies various provisions relating to criminal offenses, including penalties and minimum prison sentences.",
        "lrNumber": "5551S.01I",
