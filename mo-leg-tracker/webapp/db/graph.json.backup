        "createdAt": "2026-01-16T22:41:21.966Z",
        "updatedAt": "2026-01-19T20:31:56.553Z"
      },
      "bill:sb1382:261": {
        "billNumber": "SB 1382",
        "billPrefix": "SB",
        "billSuffix": 1382,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits the carrying of concealed firearms in any public library",
        "briefDescription": "Under current law, carrying concealed firearms is prohibited in certain areas. This act adds that concealed firearms are prohibited in any public library.",
        "lrNumber": "4465S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
