      "bill:sb1246:261": {
        "billNumber": "SB 1246",
        "billPrefix": "SB",
        "billSuffix": 1246,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to self-defense",
        "briefDescription": "This act modifies provisions relating to the use of self-defense.",
        "lrNumber": "4728S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
