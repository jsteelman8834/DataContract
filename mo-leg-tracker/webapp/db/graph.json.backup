      "bill:sb1459:261": {
        "billNumber": "SB 1459",
        "billPrefix": "SB",
        "billSuffix": 1459,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the \"Anti-Red Flag Gun Seizure Act\"",
        "briefDescription": "This act establishes the \"Anti-Red Flag Gun Seizure Act\" which provides that any federal order of protection or other federal judicial or executive order which directs the seizure of a firearm or prohibits the possession of a firearm, except as provided for in the act, shall not be enforced in this state.",
        "lrNumber": "6247S.03I",
