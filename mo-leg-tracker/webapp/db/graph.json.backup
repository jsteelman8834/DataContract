      },
      "bill:sb1065:261": {
        "billNumber": "SB 1065",
        "billPrefix": "SB",
        "billSuffix": 1065,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to utility facility relocation",
        "briefDescription": "The act modifies and creates new provisions relating to utility facility relocation.",
