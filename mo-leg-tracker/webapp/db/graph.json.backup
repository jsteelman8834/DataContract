      "bill:sb1053:261": {
        "billNumber": "SB 1053",
        "billPrefix": "SB",
        "billSuffix": 1053,
        "session": "261",
        "chamber": "senate",
        "title": "Removes availability of attorney fees under the Missouri Human Rights Act when a public employer is involved",
        "briefDescription": "The Missouri Human Rights Act (MHRA) currently allows a prevailing party in any civil action brought pursuant to that chapter to be awarded court costs and reasonable attorney fees. This act only permits court costs and reasonable attorney fees in cases not involving a public employer, as that term is defined in the act.",
        "lrNumber": "4699S.01I",
