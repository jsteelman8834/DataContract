        "billSuffix": 986,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to elections",
        "briefDescription": "This act modifies various provisions relating to elections.",
        "lrNumber": "5099S.02I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
