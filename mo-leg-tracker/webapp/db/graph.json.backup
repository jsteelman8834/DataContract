        "senateBillId": "143",
        "id": "bill:sb1034:261",
        "createdAt": "2026-01-16T22:17:56.081Z",
        "updatedAt": "2026-01-19T20:08:37.162Z"
      },
      "bill:sb1035:261": {
        "billNumber": "SB 1035",
        "billPrefix": "SB",
        "billSuffix": 1035,
        "session": "261",
        "chamber": "senate",
        "title": "Creates a county option to enact \"right-to-work\" laws",
        "briefDescription": "This act prohibits employers from requiring employees to become or refrain from becoming a member of a labor organization or pay dues or other charges required of labor organization members as a condition of employment.",
        "lrNumber": "4493S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "81",
        "id": "bill:sb1035:261",
        "createdAt": "2026-01-16T22:18:00.114Z",
        "updatedAt": "2026-01-19T20:08:39.172Z"
      },
      "bill:sb1036:261": {
        "billNumber": "SB 1036",
        "billPrefix": "SB",
        "billSuffix": 1036,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the Missouri Works program",
        "briefDescription": "This act modifies the Missouri Works program by modifying several definitions. The definition of \"average wage\" is modified by dividing aggregate new payroll by the aggregate actual hours worked for new jobs multiplied by 2,080. A definition is added for \"gross wages\" and \"taxable wages\". The definition of \"new payroll\" is modified to include amounts paid by a qualified company for health insurance premiums if such qualified company pays 100% of the health insurance premiums of its full-time emp",
        "lrNumber": "4320S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:government_efficiency",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "92",
        "id": "bill:sb1036:261",
        "createdAt": "2026-01-16T22:18:04.116Z",
        "updatedAt": "2026-01-19T20:08:41.191Z"
      },
      "bill:sb1037:261": {
        "billNumber": "SB 1037",
        "billPrefix": "SB",
        "billSuffix": 1037,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to public health services",
        "briefDescription": "This act authorizes the Department of Health and Senior Services to contract with a designated Missouri affiliate of the National Network of Public Health Institutes, or a similar or successor entity, in order to assist in carrying out its duties to promote the health and well-being of Missouri residents.  Such contracts may include efforts to assist in the delivery of health services throughout the state and the administration of grant funds and related programs.  The Department and the designa",
        "lrNumber": "4152S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:families_seniors_and_health",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "93",
        "id": "bill:sb1037:261",
        "createdAt": "2026-01-16T22:18:08.128Z",
        "updatedAt": "2026-01-19T20:08:43.200Z"
      },
      "bill:sb1038:261": {
        "billNumber": "SB 1038",
        "billPrefix": "SB",
        "billSuffix": 1038,
        "session": "261",
        "chamber": "senate",
        "title": "Requires all employers to enroll and actively participate in a federal work authorization program",
        "briefDescription": "Current law requires only public employers to enroll and actively participate in a federal work authorization program, while all other employers are permitted, but not required, to enroll and participate. This act requires all employers to enroll and actively participate in a federal work authorization program. Furthermore, the act includes penalties for failure to enroll and actively participate in a federal work authorization program, as follows:",
        "lrNumber": "4149S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:general_laws",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "94",
        "id": "bill:sb1038:261",
        "createdAt": "2026-01-16T22:18:12.145Z",
        "updatedAt": "2026-01-19T20:08:45.210Z"
      },
      "bill:sb1039:261": {
        "billNumber": "SB 1039",
        "billPrefix": "SB",
        "billSuffix": 1039,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions relating to alternative dispute resolution",
        "briefDescription": "This act establishes provisions relating to procedures for alternative dispute resolution (\"ADR\") processes. A court may refer, by either rule or order, any individual civil case or category of civil cases to any nonbinding ADR process. Within 30 days of referral, the parties may:",
        "lrNumber": "5070S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "190",
        "id": "bill:sb1039:261",
        "createdAt": "2026-01-16T22:18:16.168Z",
        "updatedAt": "2026-01-19T20:09:07.379Z"
      },
      "bill:sb1040:261": {
        "billNumber": "SB 1040",
        "billPrefix": "SB",
        "billSuffix": 1040,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a sales tax for special educational services",
        "briefDescription": "This act authorizes the board of education of a metropolitan school district to impose a sales tax for the purpose of funding special educational services in the district. The tax shall not exceed 0.25%.",
        "lrNumber": "4779S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "191",
        "id": "bill:sb1040:261",
        "createdAt": "2026-01-16T22:18:20.160Z",
        "updatedAt": "2026-01-19T20:09:09.391Z"
      },
      "bill:sb1041:261": {
        "billNumber": "SB 1041",
        "billPrefix": "SB",
        "billSuffix": 1041,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a property tax for special educational services",
        "briefDescription": "This act authorizes the board of education of a metropolitan school district to impose a tax on real property located in the district for the purpose of funding special educational services in the district. The tax shall not exceed three cents per one hundred dollars assessed valuation.",
        "lrNumber": "4780S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "192",
        "id": "bill:sb1041:261",
        "createdAt": "2026-01-16T22:18:24.200Z",
        "updatedAt": "2026-01-19T20:09:11.405Z"
      },
      "bill:sb1042:261": {
        "billNumber": "SB 1042",
        "billPrefix": "SB",
        "billSuffix": 1042,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the offense of unlawful possession of a handgun",
        "briefDescription": "This act creates the offense of unlawful possession of a handgun if the person is a minor and knowingly possesses a handgun. This offense shall be punishable by a fine not to exceed $100, imprisonment in a juvenile detention facility for a period not to exceed 10 days, or both.",
        "lrNumber": "4459S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "638",
        "id": "bill:sb1042:261",
        "createdAt": "2026-01-16T22:18:28.202Z",
        "updatedAt": "2026-01-19T20:09:13.407Z"
      },
      "bill:sb1043:261": {
        "billNumber": "SB 1043",
        "billPrefix": "SB",
        "billSuffix": 1043,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the criminal offense of masked intimidation",
        "briefDescription": "This act creates the offense of masked intimidation.  A person commits the offense if the person intentionally harasses, intimidates, or threatens any other person or group of persons while hiding or concealing their face with a mask or other article with the intent to place that other person or persons in reasonable fear for their physical safety.  A person who commits this offense shall be guilty of a class E felony for the first offense, a class D felony for the second offense, and a class C ",
        "lrNumber": "5730S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "639",
        "id": "bill:sb1043:261",
        "createdAt": "2026-01-16T22:18:32.227Z",
        "updatedAt": "2026-01-19T20:09:15.403Z"
      },
      "bill:sb1044:261": {
        "billNumber": "SB 1044",
        "billPrefix": "SB",
        "billSuffix": 1044,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a tax credit for providing services to homeless persons",
        "briefDescription": "For all tax years beginning on or after January 1, 2027, this act allows eligible taxpayers to receive a tax credit for providing certain services to homeless persons. An eligible taxpayer is defined as a qualified provider of employment services to homeless persons, a qualified provider of employment to homeless persons, or a qualified provider of housing to homeless persons. The amount of the tax credit shall not exceed $10,000 per tax year, and the total amount of tax credits authorized under",
        "lrNumber": "4350S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
