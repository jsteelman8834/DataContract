        "updatedAt": "2026-01-19T20:21:10.319Z"
      },
      "bill:sb1220:261": {
        "billNumber": "SB 1220",
        "billPrefix": "SB",
        "billSuffix": 1220,
        "session": "261",
        "chamber": "senate",
        "title": "Creates new provisions relating to criminal offenses",
        "briefDescription": "This act creates the offense of coerced criminal abortion by means of fraud if a person knowingly and intentionally engages in the use of an abortion-inducing drug on a pregnant woman without her knowledge or consent with the intent to cause an abortion. The offense is a class B felony.",
        "lrNumber": "4900S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "494",
        "id": "bill:sb1220:261",
        "createdAt": "2026-01-16T22:30:35.707Z",
        "updatedAt": "2026-01-19T20:21:12.326Z"
      },
      "bill:sb1221:261": {
        "billNumber": "SB 1221",
        "billPrefix": "SB",
        "billSuffix": 1221,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"Born-Alive Abortion Survivors Protection Act\"",
        "briefDescription": "This act creates the \"Born-Alive Abortion Survivors Protection Act\".  Under this act, a child born alive during or after an abortion or attempted abortion shall have the same rights, privileges, and immunities as any other person, citizen, and resident of Missouri, including any other live-born child.",
        "lrNumber": "5152S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "495",
        "id": "bill:sb1221:261",
        "createdAt": "2026-01-16T22:30:39.708Z",
        "updatedAt": "2026-01-19T20:21:14.354Z"
      },
      "bill:sb1222:261": {
        "billNumber": "SB 1222",
        "billPrefix": "SB",
        "billSuffix": 1222,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to intervention in actions involving abortion",
        "briefDescription": "This act establishes that pro-life individuals and organizations, as defined in the act, may intervene in actions in which a provision of the Missouri Constitution, statute, or rule involves the regulation of abortion or where the rights of an unborn child is at issue.",
        "lrNumber": "5151S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "496",
        "id": "bill:sb1222:261",
        "createdAt": "2026-01-16T22:30:43.703Z",
        "updatedAt": "2026-01-19T20:21:16.358Z"
      },
      "bill:sb1223:261": {
        "billNumber": "SB 1223",
        "billPrefix": "SB",
        "billSuffix": 1223,
        "session": "261",
        "chamber": "senate",
        "title": "Requires disclosure for certain products produced, sold, or distributed in Missouri",
        "briefDescription": "This act requires any product to be conspicuously labeled \"Potential Gene Therapy Product\" if the product has been created to act as, or otherwise exposed to processes resulting in the product acting as, a gene therapy or that could impact, alter, or introduce genetic material or a genetic change into the user or individuals exposed to the product, unless the product is reasonably known to be a gene therapy product, in which case the product shall be labeled \"Gene Therapy Product\".",
        "lrNumber": "5673S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "389",
        "id": "bill:sb1223:261",
        "createdAt": "2026-01-16T22:30:47.909Z",
        "updatedAt": "2026-01-19T20:21:18.355Z"
      },
      "bill:sb1224:261": {
        "billNumber": "SB 1224",
        "billPrefix": "SB",
        "billSuffix": 1224,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to searches and seizures on private property by public entities",
        "briefDescription": "This act modifies provisions relating to searches and seizures of private property by public entities.",
        "lrNumber": "5724S.01I",
