      "bill:sb1166:261": {
        "billNumber": "SB 1166",
        "billPrefix": "SB",
        "billSuffix": 1166,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to the use of automated traffic enforcement systems",
        "briefDescription": "This act prohibits political subdivisions and state agencies from using automated photo red light enforcement systems to enforce red light violations. (Section 304.286).",
        "lrNumber": "5700S.01I",
