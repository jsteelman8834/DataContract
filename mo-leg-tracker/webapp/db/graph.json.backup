      "bill:sb1139:261": {
        "billNumber": "SB 1139",
        "billPrefix": "SB",
        "billSuffix": 1139,
        "session": "261",
        "chamber": "senate",
        "title": "Reinstates the Presidential Preference Primary Election",
        "briefDescription": "This act reinstates the presidential preference primary election to be held on the second Tuesday in March of each year in which a presidential election is held.",
        "lrNumber": "4860S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
