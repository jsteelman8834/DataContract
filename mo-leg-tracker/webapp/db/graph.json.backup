        "createdAt": "2026-01-16T22:31:15.858Z",
        "updatedAt": "2026-01-19T20:21:52.427Z"
      },
      "bill:sb1231:261": {
        "billNumber": "SB 1231",
        "billPrefix": "SB",
        "billSuffix": 1231,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes an income tax deduction for certain research expenses",
        "briefDescription": "Federal law requires taxpayers to amortize the deduction for research and experimental expenses over a period of years. This act allows a taxpayer to deduct the full amount of such expenses for the taxpayer's state income taxes during the tax year in which they were incurred.",
        "lrNumber": "4495S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
