        "billSuffix": 1422,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies certain provisions relating to the Missouri Wine, Grape, and Spirits Board",
        "briefDescription": "This act renames the \"Missouri Wine and Grape Board\" to the \"Missouri Wine, Grape, and Spirits Board\".",
        "lrNumber": "5916S.01I",
        "currentStatus": "first_read",
