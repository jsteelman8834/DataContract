      "bill:sb1124:261": {
        "billNumber": "SB 1124",
        "billPrefix": "SB",
        "billSuffix": 1124,
        "session": "261",
        "chamber": "senate",
        "title": "Creates new provisions prohibiting the transmission of money to unauthorized aliens within the state of Missouri",
        "briefDescription": "This act creates new provisions that prohibit the transmission of money to unauthorized aliens within the state of Missouri by licensed money transmitters. Specifically, a licensee shall not initiate a foreign remittance transfer, as that term is defined in the act, unless the licensee has verified that the sender is not an unauthorized alien. A licensee shall pay a penalty equal to 25% of the United States dollar amount transferred, excluding any fees or charges imposed by the licensee, for any",
        "lrNumber": "4962S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:insurance_and_banking",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "335",
        "id": "bill:sb1124:261",
        "createdAt": "2026-01-16T22:24:10.463Z",
        "updatedAt": "2026-01-19T20:14:38.749Z"
      },
      "bill:sb1125:261": {
        "billNumber": "SB 1125",
        "billPrefix": "SB",
        "billSuffix": 1125,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Real Property Fraud Prevention Act",
        "briefDescription": "This act requires a county recorder of deeds to provide notice to a property owner of record of a parcel of real property that a general warranty deed or quitclaim deed that affects the ownership of such parcel has been submitted for recording.",
        "lrNumber": "4726S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:select_committee_on_property_taxes_and_the_state_tax_commission",
