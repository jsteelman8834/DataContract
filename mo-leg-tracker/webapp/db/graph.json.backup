      "bill:sb1549:261": {
        "billNumber": "SB 1549",
        "billPrefix": "SB",
        "billSuffix": 1549,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies requirements for promulgating administrative rules and posting of substantive policy statements by state agencies",
        "briefDescription": "This act requires that any rule promulgated by a state agency must be specifically authorized by a state statute.  An agency cannot rely on a general grant of rulemaking authority to supplement a specific grant of authority.",
        "lrNumber": "6460S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
