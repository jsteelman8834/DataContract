      "bill:sb1423:261": {
        "billNumber": "SB 1423",
        "billPrefix": "SB",
        "billSuffix": 1423,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to health care providers",
        "briefDescription": "This act modifies the definition of \"hospital\" for purposes of regulating the dispensation and distribution of controlled substances to include outpatient facilities owned and operated by a hospital.  A hospital may obtain a separate registration for the distribution or dispensation of controlled substances from the Department of Health and Senior Services for each outpatient facility owned or operated by the hospital in which behavioral health or substance abuse services are delivered.",
        "lrNumber": "5640S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
