        "createdAt": "2026-01-16T22:58:27.527Z",
        "updatedAt": "2026-01-19T20:41:14.689Z"
      },
      "bill:sb1520:261": {
        "billNumber": "SB 1520",
        "billPrefix": "SB",
        "billSuffix": 1520,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to enforcement of liens for delinquent payment for sewer service",
        "briefDescription": "Currently, a lien for delinquent payment for sewer service may be enforced by suit or foreclosure. The act provides that such lien may only be enforced by suit.",
        "lrNumber": "6491S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
