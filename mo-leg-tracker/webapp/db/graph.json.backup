        "billSuffix": 1138,
        "session": "261",
        "chamber": "senate",
        "title": "Exempts certain professions from income tax",
        "briefDescription": "This act establishes the \"Retaining MO Workers Act\".",
        "lrNumber": "4862S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
