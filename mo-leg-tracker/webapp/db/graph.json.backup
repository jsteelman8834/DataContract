      "bill:sb1182:261": {
        "billNumber": "SB 1182",
        "billPrefix": "SB",
        "billSuffix": 1182,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes counties to provide vehicle weight exemptions for certain vehicles",
        "briefDescription": "This act authorizes a county commission to allow any truck, tractor-trailer, or other combination engaged in transporting material or equipment to a construction site where economic activity occurs or will occur to operate with a weight not to exceed 22,400 pounds on one axle or a weight not to exceed 44,800 pounds on any tandem axle, provided that such vehicle shall not operate on the interstate highway system in excess of the weight limits imposed by federal statute and shall not exceed the wi",
        "lrNumber": "5400S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "150",
        "id": "bill:sb1182:261",
        "createdAt": "2026-01-16T22:28:03.193Z",
        "updatedAt": "2026-01-19T20:18:35.645Z"
      },
      "bill:sb1183:261": {
        "billNumber": "SB 1183",
        "billPrefix": "SB",
        "billSuffix": 1183,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to synthetic media",
        "briefDescription": "Under the act, a creator, as defined in the act, shall not, within 18 weeks of an election, distribute a synthetic media message that the creator knows or should have known is a deceptive and fraudulent deepfake, as defined in the act. These provisions shall not apply if the creator of the audio or visual media includes a certain disclosure statement, as described in the act.",
        "lrNumber": "4705S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "336",
        "id": "bill:sb1183:261",
        "createdAt": "2026-01-16T22:28:07.190Z",
        "updatedAt": "2026-01-19T20:18:37.657Z"
      },
      "bill:sb1184:261": {
        "billNumber": "SB 1184",
        "billPrefix": "SB",
        "billSuffix": 1184,
        "session": "261",
        "chamber": "senate",
        "title": "Requires the general assembly to approve proposed administrative rules with a fiscal note over $250,000",
        "briefDescription": "For any proposed administrative rule submitted by a state agency that will result in the expenditure of public funds by a state entity or political subdivision of greater than $250,000, or will result in a loss of income to an individual or business of greater than $250,000, this act requires the state agency to notify the Joint Committee on Administrative Rules.  The Committee may hold hearings on the proposed rule.  Such proposed rule shall not become effective until approved by the General As",
        "lrNumber": "5023S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "337",
        "id": "bill:sb1184:261",
        "createdAt": "2026-01-16T22:28:11.218Z",
        "updatedAt": "2026-01-19T20:18:39.656Z"
      },
      "bill:sb1185:261": {
        "billNumber": "SB 1185",
        "billPrefix": "SB",
        "billSuffix": 1185,
        "session": "261",
        "chamber": "senate",
        "title": "Moves school board elections to the November general election",
        "briefDescription": "This act moves the general municipal election day from the first Tuesday after the first Tuesday in April to the first Tuesday after the first Monday in November. Additionally, all bond and tax elections must be held on the first Tuesday after the first Monday in November of even-numbered years.",
        "lrNumber": "4679S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2027-01-01",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "338",
        "id": "bill:sb1185:261",
        "createdAt": "2026-01-16T22:28:15.234Z",
        "updatedAt": "2026-01-19T20:18:41.655Z"
      },
      "bill:sb1186:261": {
        "billNumber": "SB 1186",
        "billPrefix": "SB",
        "billSuffix": 1186,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to jury instructions for the offense of murder in the first degree",
        "briefDescription": "Under current law, if a jury is unable to agree upon the punishment for the offense of murder in the first degree, the court is to instruct the jury that the judge may decide upon a punishment of life imprisonment without eligibility for parole or a sentence of death.",
        "lrNumber": "4688S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "603",
        "id": "bill:sb1186:261",
        "createdAt": "2026-01-16T22:28:19.259Z",
        "updatedAt": "2026-01-19T20:18:43.656Z"
      },
      "bill:sb1187:261": {
        "billNumber": "SB 1187",
        "billPrefix": "SB",
        "billSuffix": 1187,
        "session": "261",
        "chamber": "senate",
        "title": "Regulates the use of marijuana in public places",
        "briefDescription": "This act creates the offense of consumption of marijuana in public spaces, which shall be a class B misdemeanor.",
        "lrNumber": "4814S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
