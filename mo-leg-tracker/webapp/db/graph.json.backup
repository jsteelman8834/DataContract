      "bill:sb1284:261": {
        "billNumber": "SB 1284",
        "billPrefix": "SB",
        "billSuffix": 1284,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies requirements for a dissolution of a public water supply district",
        "briefDescription": "Under the act, a petition for a dissolution of a public water supply district shall allege that an agreement for sale of the district's assets has been entered into by the board of directors contingent upon approval of the circuit court and voters.",
        "lrNumber": "4723S.01I",
