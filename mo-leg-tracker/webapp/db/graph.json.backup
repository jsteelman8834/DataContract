        "billPrefix": "SB",
        "billSuffix": 1170,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to compensation for wrongful convictions",
        "briefDescription": "This act creates provisions relating to compensation for the wrongfully convicted.",
