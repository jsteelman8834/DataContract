        "createdAt": "2026-01-16T22:57:23.366Z",
        "updatedAt": "2026-01-19T20:40:02.301Z"
      },
      "bill:sb1504:261": {
        "billNumber": "SB 1504",
        "billPrefix": "SB",
        "billSuffix": 1504,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies payments to ambulance providers",
        "briefDescription": "This act sets the minimum allowable reimbursement rate to an out-of-network ambulance provider for services provided to enrollees and limits co-payment, coinsurance, deductibles, and other cost sharing amounts to the in-network payment amount for covered services. Ambulance providers are prohibited from billing enrollees any additional amounts for paid covered services.",
        "lrNumber": "6485S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
