      "bill:sjr87:261": {
        "billNumber": "SJR 87",
        "billPrefix": "SJR",
        "billSuffix": 87,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to sheriffs",
        "briefDescription": "This constitutional amendment, if approved by the voters, provides that each county shall elect a sheriff for a term of four years by a majority of the qualified voters of the county. This constitutional amendment shall not apply to St. Louis City, St. Louis County, or St. Charles County.",
