        "createdAt": "2026-01-16T22:25:26.689Z",
        "updatedAt": "2026-01-19T20:15:57.154Z"
      },
      "bill:sb1144:261": {
        "billNumber": "SB 1144",
        "billPrefix": "SB",
        "billSuffix": 1144,
        "session": "261",
        "chamber": "senate",
        "title": "Changes the composition of the St. Charles City-County Library Board of Trustees",
        "briefDescription": "This act changes the composition of the St. Charles City-County Library Board of Trustees.  Currently, the board consists of nine members, with five members appointed by the St. Charles County Executive and four members appointed by the mayor of the city of St. Charles.  Beginning with appointments made after January 1, 2027, this act provides that the four city-appointed members shall be selected by the mayors of the four most populous cities in the county, as determined by the decennial census",
        "lrNumber": "4641S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
        "senateBillId": "366",
        "id": "bill:sb1144:261",
        "createdAt": "2026-01-16T22:25:30.687Z",
        "updatedAt": "2026-01-19T20:15:59.059Z"
      },
      "bill:sb1145:261": {
        "billNumber": "SB 1145",
        "billPrefix": "SB",
        "billSuffix": 1145,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to sales taxes for park purposes",
        "briefDescription": "Current law authorizes certain counties to levy a sales tax for funding a multi-county metropolitan park and recreation district, with fifty percent of such sales tax revenues to be returned to the home county for park purposes. This act provides that such park purposes may include certain storm water management projects, as described in the act.",
        "lrNumber": "4645S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
