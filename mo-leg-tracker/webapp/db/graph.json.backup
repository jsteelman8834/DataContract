        "createdAt": "2026-01-16T23:02:20.364Z",
        "updatedAt": "2026-01-19T20:44:51.490Z"
      },
      "bill:sjr68:261": {
        "billNumber": "SJR 68",
        "billPrefix": "SJR",
        "billSuffix": 68,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits the taxation of unrealized gains",
        "briefDescription": "This constitutional amendment, if approved by the voters, prohibits any taxes from being imposed on any unrealized gains accrued on any asset prior to the sale of such asset.",
        "lrNumber": "5188S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
