      "bill:sb1080:261": {
        "billNumber": "SB 1080",
        "billPrefix": "SB",
        "billSuffix": 1080,
        "session": "261",
        "chamber": "senate",
        "title": "Requires the State Highway Patrol to receive a specific appropriation from the General Assembly for any single vehicle purchase in excess of $500,000, rather than $100,000",
        "briefDescription": "Currently, the state highway patrol must receive a specific appropriation from the General Assembly for any single vehicle purchase in excess of $100,000.  This act increases the threshold to $500,000.",
        "lrNumber": "5537S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
