      "bill:sb1051:261": {
        "billNumber": "SB 1051",
        "billPrefix": "SB",
        "billSuffix": 1051,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to protections against discrimination in educational settings",
        "briefDescription": "This act requires all public schools, school districts, and public institutions of postsecondary education to treat discrimination motivated by antisemitism, as such term is defined in the act, in an identical manner to racially motivated discrimination.  Schools and institutions shall include antisemitism-related conduct and penalties in their codes of conduct for students, faculty, and employees, as provided in the act, and shall prohibit behaviors that disrupt normal educational activity or c",
        "lrNumber": "5611S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
