        "billPrefix": "SB",
        "billSuffix": 1285,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to taxation",
        "briefDescription": "Current law requires the Director of Revenue to annually publish the updated income brackets for the state income tax. This act requires such publication to be made on the Department's website.",
        "lrNumber": "5675S.01I",
