        "updatedAt": "2026-01-19T20:18:45.650Z"
      },
      "bill:sb1188:261": {
        "billNumber": "SB 1188",
        "billPrefix": "SB",
        "billSuffix": 1188,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to tax credits",
        "briefDescription": "This act modifies provisions relating to tax credits.",
        "lrNumber": "4418S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
