        "senateBillId": "57455",
        "id": "bill:sb1487:261",
        "createdAt": "2026-01-16T22:54:12.034Z",
        "updatedAt": "2026-01-19T20:38:50.018Z"
      },
      "bill:sb1488:261": {
        "billNumber": "SB 1488",
        "billPrefix": "SB",
        "billSuffix": 1488,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions regarding the right to own firearms",
        "briefDescription": "This act repeals the sections of law which were declared unconstitutional in United States v. Missouri, and replaces them with new sections.",
        "lrNumber": "6203S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
