        "billPrefix": "SB",
        "billSuffix": 1148,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals certain taxes imposed on the sale of bingo cards",
        "briefDescription": "Current law imposes a tax of 2% on the retail sales value charged for a bingo pull tab card sold in Missouri, and a tax of 0.2% on certain organizations conducting bingo in Missouri.  This act repeals such taxes.",
        "lrNumber": "5832S.01I",
