        "id": "bill:sb1016:261",
        "createdAt": "2026-01-16T22:16:43.863Z",
        "updatedAt": "2026-01-19T20:07:20.774Z"
      },
      "bill:sb1017:261": {
        "billNumber": "SB 1017",
        "billPrefix": "SB",
        "billSuffix": 1017,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a state sales tax exemption for food",
        "briefDescription": "Current law taxes retail sales of food, as defined in current law, at a rate of one percent. This act provides that retail sales of food shall be exempt from state sales taxes.",
        "lrNumber": "4583S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "563",
        "id": "bill:sb1017:261",
        "createdAt": "2026-01-16T22:16:47.860Z",
        "updatedAt": "2026-01-19T20:07:22.781Z"
      },
      "bill:sb1018:261": {
        "billNumber": "SB 1018",
        "billPrefix": "SB",
        "billSuffix": 1018,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a voluntary self-exclusion list for the purchase of firearms",
        "briefDescription": "This act authorizes a person to waive such person's right to purchase a firearm by submitting a request to the Department of Public Safety. The Department shall verify a person's identity prior to accepting the voluntary waiver. While such waiver is in effect, no person shall sell or otherwise transfer a firearm to a person who voluntarily waived the right to purchase a firearm.",
        "lrNumber": "5511S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "564",
        "id": "bill:sb1018:261",
        "createdAt": "2026-01-16T22:16:51.878Z",
        "updatedAt": "2026-01-19T20:07:24.787Z"
      },
      "bill:sb1019:261": {
        "billNumber": "SB 1019",
        "billPrefix": "SB",
        "billSuffix": 1019,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to hospital investments and service areas",
        "briefDescription": "This act modifies the investment authority of boards of trustees of municipal hospitals in third class cities and hospital district hospitals.  Current law permits investment of up to 25% of funds not required for operations of the hospital or other obligations.  This act permits investment of up to 50% of funds not required for operations or other obligations in a manner described in the act, with the remaining portion to be invested into any investment in which the Treasurer is allowed to inve",
        "lrNumber": "4774S.01I",
        "currentStatus": "referred",
