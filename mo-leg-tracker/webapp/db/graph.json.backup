        "updatedAt": "2026-01-19T20:45:34.906Z"
      },
      "bill:sjr74:261": {
        "billNumber": "SJR 74",
        "billPrefix": "SJR",
        "billSuffix": 74,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to income taxes",
        "briefDescription": "This constitutional amendment, if approved by the voters, provides that, in the event that the General Assembly reduces the rate of income tax for state purposes below the rate of 4.5%, every county in the state shall be authorized to impose an income tax on the residents of such county, provided that the total combined rate of such tax and the state income tax does not exceed 4.5%",
        "lrNumber": "3874S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "86",
        "id": "bill:sjr74:261",
        "createdAt": "2026-01-16T23:02:48.496Z",
        "updatedAt": "2026-01-19T20:45:36.891Z"
      },
      "bill:sjr75:261": {
        "billNumber": "SJR 75",
        "billPrefix": "SJR",
        "billSuffix": 75,
        "session": "261",
        "chamber": "senate",
        "title": "Places limits on increases of the assessment of certain properties",
        "briefDescription": "This constitutional amendment, if approved by the voters, provides that the assessed valuation for any residential real property located in a subdivision located adjacent to a subdivision receiving a tax abatement shall not be increased for the duration of time that the adjacent subdivision receives such abatement.",
        "lrNumber": "4341S.01I",
        "currentStatus": "first_read",
