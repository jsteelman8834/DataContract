        "billSuffix": 942,
        "session": "261",
        "chamber": "senate",
        "title": "Allows vehicles to exceed weight limits by up to 10% in certain circumstances",
        "briefDescription": "This act provides that vehicles may exceed the vehicle weight limits otherwise specified by law by up to 10% under certain circumstances.",
        "lrNumber": "4551S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
