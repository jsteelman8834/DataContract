        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions relating to adult cabaret performances, including the offense of engaging in an adult cabaret performance",
        "briefDescription": "This act defines \"adult cabaret performance\" in regards to provisions relating to restrictions on sexually oriented businesses.  Additionally, this act creates the offense of engaging in an adult cabaret performance if such performance is on public property or in a location where the performance could be viewed by a person who is not an adult.  Such offense shall be a class A misdemeanor for the first offense and a class E felony for any subsequent offense.",
        "lrNumber": "6066S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "52372",
        "id": "bill:sb1476:261",
        "createdAt": "2026-01-16T22:52:09.216Z",
        "updatedAt": "2026-01-19T20:38:07.849Z"
      },
      "bill:sb1477:261": {
        "billNumber": "SB 1477",
        "billPrefix": "SB",
        "billSuffix": 1477,
        "session": "261",
        "chamber": "senate",
        "title": "Provides that motorcycles may use any color auxiliary lighting, rather than only amber and white",
        "briefDescription": "This act provides that motorcycles may be equipped with and use auxiliary lighting of any color, rather than only amber and white.",
        "lrNumber": "6236S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
