        "updatedAt": "2026-01-19T20:39:24.141Z"
      },
      "bill:sb1495:261": {
        "billNumber": "SB 1495",
        "billPrefix": "SB",
        "billSuffix": 1495,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to delinquent property taxes",
        "briefDescription": "This act authorizes county collectors to waive all or part of the interest and penalties owed on delinquent taxes if, at the collector's discretion, good cause is shown.",
        "lrNumber": "4355S.01I",
