        "createdAt": "2026-01-16T22:43:38.413Z",
        "updatedAt": "2026-01-19T20:34:05.021Z"
      },
      "bill:sb1416:261": {
        "billNumber": "SB 1416",
        "billPrefix": "SB",
        "billSuffix": 1416,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the use of electronic communication devices while driving",
        "briefDescription": "Current law prohibits certain uses of electronic communication devices while operating a noncommercial motor vehicle or commercial motor vehicle on any highway or property open to the public for vehicular traffic in this state, and preempts the entire field of regulating the use of electronic communication devices by the operators of commercial and noncommercial motor vehicles. This act modifies such preemption provision by allowing local ordinances and regulations that do not conflict with prov",
        "lrNumber": "5865S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "6858",
        "id": "bill:sb1416:261",
        "createdAt": "2026-01-16T22:43:42.426Z",
        "updatedAt": "2026-01-19T20:34:07.030Z"
      },
      "bill:sb1417:261": {
        "billNumber": "SB 1417",
        "billPrefix": "SB",
        "billSuffix": 1417,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the length of supervision for certain social work supervisors",
        "briefDescription": "SB 1417 This act modifies the definitions of a \"qualified advanced macro supervisor,\" \"qualified baccalaureate supervisor,\" and \"qualified clinical supervisor\" to provide that such person is a licensed social worker who has practiced social work for which he or she is supervising the applicant for a minimum of three, instead of five, years.",
        "lrNumber": "5954S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "6859",
        "id": "bill:sb1417:261",
        "createdAt": "2026-01-16T22:43:46.431Z",
        "updatedAt": "2026-01-19T20:34:09.039Z"
      },
      "bill:sb1418:261": {
        "billNumber": "SB 1418",
        "billPrefix": "SB",
        "billSuffix": 1418,
        "session": "261",
        "chamber": "senate",
        "title": "Provides exemptions for records of certain criminal offenses from public access on statewide court automation systems",
        "briefDescription": "This act provides that any official court record pertaining to a case in which a person is charged with a felony, class A misdemeanor, violation for driving under the influence of drugs or alcohol, offense that can be enhanced to a class A misdemeanor or higher for subsequent violations, sexual offense, and any ordinance violation shall not be made available to a member of the public through a statewide court automation system. However, the official record may be made available through any state",
        "lrNumber": "5959S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "6860",
        "id": "bill:sb1418:261",
        "createdAt": "2026-01-16T22:43:50.448Z",
        "updatedAt": "2026-01-19T20:34:11.040Z"
      },
      "bill:sb1419:261": {
        "billNumber": "SB 1419",
        "billPrefix": "SB",
        "billSuffix": 1419,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the mailing of certain tax information",
        "briefDescription": "Current law requires a notice of tax deficiency to a taxpayer by certified or registered mail. This act instead requires such notice to be mailed by regular first class mail, or electronically at the taxpayer's request.",
        "lrNumber": "6025S.01I",
        "currentStatus": "first_read",
