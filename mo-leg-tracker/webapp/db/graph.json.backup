      "bill:sb1129:261": {
        "billNumber": "SB 1129",
        "billPrefix": "SB",
        "billSuffix": 1129,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to concealed carry permits",
        "briefDescription": "Under current law, a person issued a concealed carry permit shall carry the permit at all times the person is carrying a concealed firearm, and shall display such permit upon request from a peace officer.",
        "lrNumber": "3388S.01I",
        "currentStatus": "referred",
