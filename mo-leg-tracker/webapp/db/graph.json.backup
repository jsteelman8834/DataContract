      "bill:sb1172:261": {
        "billNumber": "SB 1172",
        "billPrefix": "SB",
        "billSuffix": 1172,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"Cronkite New Voices Act\" to protect the freedom of press in school-sponsored media",
        "briefDescription": "This act establishes the \"Cronkite New Voices Act\", which provides that in both public high schools and public institutions of higher education, a student journalist, as defined in the act, has the right to exercise freedom of speech and of the press in school-sponsored media.",
        "lrNumber": "4327S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
