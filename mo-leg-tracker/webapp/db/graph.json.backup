      "bill:sb1471:261": {
        "billNumber": "SB 1471",
        "billPrefix": "SB",
        "billSuffix": 1471,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"Act Against Abusive Website Access Litigation\"",
        "briefDescription": "This act creates the \"Act Against Abusive Website Access Litigation\". The Attorney General, on behalf of a class of residents of this state, or any resident of this state who is subject to litigation that alleges any website access violation may file a civil action against the party, attorney, or law firm that initiated such litigation for a determination as to whether such litigation alleging a website access violation is abusive litigation. In determining whether such litigation is abusive, th",
        "lrNumber": "6397S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
