      "bill:sb987:261": {
        "billNumber": "SB 987",
        "billPrefix": "SB",
        "billSuffix": 987,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to erroneous property classifications",
        "briefDescription": "Current law provides that a taxpayer shall be awarded costs and reasonable attorney's fees for any appeal of an assessor's classification of real property that is found by the State Tax Commission or a court of competent jurisdiction to be an erroneous classification. This act provides that any such decision shall include the recovery of such costs.",
        "lrNumber": "4601S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-14",
        "withdrawn": false,
        "senateBillId": "256",
        "id": "bill:sb987:261",
        "createdAt": "2026-01-16T22:14:47.461Z",
        "updatedAt": "2026-01-19T20:05:22.342Z"
      },
      "bill:sb988:261": {
        "billNumber": "SB 988",
        "billPrefix": "SB",
        "billSuffix": 988,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Dental and Dental Hygienist Compact",
        "briefDescription": "This act establishes the Dental and Dental Hygienist Compact (\"Compact\"), which facilitates the interstate practice of dentistry and dental hygiene and provides for dentists and dental hygienists licensed in a participating state the ability to practice in other participating states. The Compact sets forth the requirements to be met in order for a state to join and the requirements for a dentist or dental hygienist to obtain and exercise the ability to practice in other participating states.",
        "lrNumber": "4727S.01I",
        "currentStatus": "in_committee",
        "currentCommittee": "committee:senate:emerging_issues_and_professional_registration",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-20",
        "withdrawn": false,
        "senateBillId": "266",
        "id": "bill:sb988:261",
        "createdAt": "2026-01-16T22:14:51.476Z",
        "updatedAt": "2026-01-19T20:05:24.321Z"
      },
      "bill:sb989:261": {
        "billNumber": "SB 989",
        "billPrefix": "SB",
        "billSuffix": 989,
        "session": "261",
        "chamber": "senate",
        "title": "Creates new provisions relating to employee compensation",
        "briefDescription": "This act establishes new provisions relating to employee compensation that are identical to those implemented by Proposition A (2024) and repealed in 2025. Additionally, it creates new provisions providing for bereavement leave.",
        "lrNumber": "5015S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:general_laws",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "218",
        "id": "bill:sb989:261",
        "createdAt": "2026-01-16T22:14:55.482Z",
        "updatedAt": "2026-01-19T20:05:46.369Z"
      },
      "bill:sb990:261": {
        "billNumber": "SB 990",
        "billPrefix": "SB",
        "billSuffix": 990,
        "session": "261",
        "chamber": "senate",
        "title": "Requires motorcycle operators and passengers to wear protective headgear",
        "briefDescription": "Current law allows any qualified motorcycle operator who is aged 26 or older to operate a motorcycle or motortricycle without wearing protective headgear. This act repeals such provision and requires every person operating or riding as a passenger on a motorcycle or motortricycle to wear protective headgear.",
        "lrNumber": "4880S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "219",
        "id": "bill:sb990:261",
        "createdAt": "2026-01-16T22:14:59.535Z",
        "updatedAt": "2026-01-19T20:05:48.370Z"
      },
      "bill:sb991:261": {
        "billNumber": "SB 991",
        "billPrefix": "SB",
        "billSuffix": 991,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to interior designers",
        "briefDescription": "This act modifies the registration of interior designers from the Division of Professional Registration with advice and recommendations by the Interior Design Council to the licensing of interior designers from the Missouri Board for Architects, Professional Engineers, Professional Land Surveyors, Professional Landscape Architects, and Licensed Interior Designers (\"Board\"). The Board shall increase from fifteen members to seventeen members with the two new members being licensed interior designe",
        "lrNumber": "4845S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:emerging_issues_and_professional_registration",
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "220",
        "id": "bill:sb991:261",
        "createdAt": "2026-01-16T22:15:03.531Z",
        "updatedAt": "2026-01-19T20:05:50.523Z"
      },
      "bill:sb992:261": {
        "billNumber": "SB 992",
        "billPrefix": "SB",
        "billSuffix": 992,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals provisions relating to the statewide assessment system",
        "briefDescription": "This act repeals provisions of law requiring the State Board of Education to develop a statewide assessment system.  Instead, school districts shall use nationally norm-referenced assessments, rather than the Missouri Assessment Program, to test students' knowledge and skills.",
        "lrNumber": "4437S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:education",
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "312",
        "id": "bill:sb992:261",
        "createdAt": "2026-01-16T22:15:07.533Z",
        "updatedAt": "2026-01-19T20:05:52.392Z"
      },
      "bill:sb993:261": {
        "billNumber": "SB 993",
        "billPrefix": "SB",
        "billSuffix": 993,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to hemp businesses",
        "briefDescription": "This act creates licenses for hemp beverage manufacturers, hemp beverage wholesalers, and hemp beverage retailers.  No person, cooperative, or business holding any one of the three types of hemp beverage licenses can hold either of the other two types of hemp beverage licenses and shall not have a financial interest, either direct or indirect, in a person, cooperative or business holding any of the other two types of hemp beverage licenses.  However, a person, cooperative, or business may hold b",
        "lrNumber": "5195S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:emerging_issues_and_professional_registration",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "313",
        "id": "bill:sb993:261",
        "createdAt": "2026-01-16T22:15:11.556Z",
        "updatedAt": "2026-01-19T20:05:54.393Z"
      },
      "bill:sb994:261": {
        "billNumber": "SB 994",
        "billPrefix": "SB",
        "billSuffix": 994,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the filing of income tax returns",
        "briefDescription": "Current law provides that the date for filing income tax returns shall be the fifteenth day of the fourth month following the close of the taxpayer's taxable year. This act provides that such date shall be the date prescribed for the filing of federal tax returns. The act provides that if such date is changed for any reason, the date for filing state income tax returns shall also be changed to such date. (Section 143.511)",
        "lrNumber": "4828S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:economic_and_workforce_development",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "314",
        "id": "bill:sb994:261",
        "createdAt": "2026-01-16T22:15:15.555Z",
        "updatedAt": "2026-01-19T20:05:56.406Z"
      },
      "bill:sb995:261": {
        "billNumber": "SB 995",
        "billPrefix": "SB",
        "billSuffix": 995,
        "session": "261",
        "chamber": "senate",
        "title": "Provides that the Sheriff of the City of St. Louis shall be appointed by the judges of the 22nd Judicial Circuit, rather than elected",
        "briefDescription": "Currently, the sheriff of the City of St. Louis is elected. This act instead provides that a majority of the circuit and associate circuit judges of the 22nd Judicial Circuit, consisting of the City of St. Louis, shall appoint the sheriff. The sheriff is removable for cause by a majority of the judges pursuant to Missouri Supreme Court rules. The elected sheriff holding office on August 28, 2026, shall continue to hold office for the remainder of his or her term.",
        "lrNumber": "5487S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:local_government_elections_and_pensions",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "446",
        "id": "bill:sb995:261",
        "createdAt": "2026-01-16T22:15:19.566Z",
        "updatedAt": "2026-01-19T20:05:58.405Z"
