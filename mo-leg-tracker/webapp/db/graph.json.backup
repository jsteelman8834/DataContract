        "createdAt": "2026-01-16T22:57:51.460Z",
        "updatedAt": "2026-01-19T20:40:36.507Z"
      },
      "bill:sb1511:261": {
        "billNumber": "SB 1511",
        "billPrefix": "SB",
        "billSuffix": 1511,
        "session": "261",
        "chamber": "senate",
        "title": "Includes questions and responses related to the care and treatment of a patient in the patient record maintained by physicians",
        "briefDescription": "This act provides that the patient record maintained by a physician shall include questions asked by the patient, when requested by the patient to be recorded, relating to his or her care and treatment and the response of the physician to such questions.",
        "lrNumber": "3367S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
