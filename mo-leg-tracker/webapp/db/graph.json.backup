        "chamber": "senate",
        "title": "Establishes provisions relating to license reciprocity for physician assistants, including the Physician Assistant Licensure Compact",
        "briefDescription": "This act establishes provisions relating to licensure of physician assistants, including license reciprocity and the Physician Assistant Licensure Compact.",
        "lrNumber": "6140S.01I",
