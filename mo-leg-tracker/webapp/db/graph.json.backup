        "billSuffix": 1518,
        "session": "261",
        "chamber": "senate",
        "title": "Repeals enumerated requirements for employment as a deputy boiler inspector",
        "briefDescription": "This act repeals currently enumerated qualifications for employment as a deputy boiler inspector.",
        "lrNumber": "6430S.01I",
