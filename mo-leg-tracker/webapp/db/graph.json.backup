      "bill:sb1009:261": {
        "billNumber": "SB 1009",
        "billPrefix": "SB",
        "billSuffix": 1009,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the Clean Water Commission",
        "briefDescription": "Under the act, at least one member of the Clean Water Commission shall be knowledgeable concerning the needs of publicly owned wastewater treatment works.",
        "lrNumber": "4603S.01I",
