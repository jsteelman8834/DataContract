      "bill:sb899:261": {
        "billNumber": "SB 899",
        "billPrefix": "SB",
        "billSuffix": 899,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to abuse and neglect reporting, including a requirement to report companion animal abuse",
        "briefDescription": "This act requires animal control officers and animal humane investigators to be mandated reporters in cases of abuse and neglect of children, the elderly, and other vulnerable persons.  Additionally, animal control officers and animal humane investigators shall be required to receive one hour of training within the first 60 days of employment to recognize the signs of abuse or neglect in children, the elderly, and vulnerable persons.",
        "lrNumber": "4274S.01I",
