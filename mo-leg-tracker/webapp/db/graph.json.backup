        "billSuffix": 1156,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to insurance coverage for prescription insulin drugs",
        "briefDescription": "This act prohibits health benefit plans from imposing cost-sharing, as defined in the act, on an enrollee in excess of $30 per 30-day supply of a prescription insulin drug.",
        "lrNumber": "3850S.01I",
        "currentStatus": "referred",
