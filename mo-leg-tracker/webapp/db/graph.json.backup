        "billSuffix": 1064,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to tobacco product regulations",
        "briefDescription": "Under this act, the state's laws shall preempt any local laws, ordinances, orders, rules, or regulations enacted by a county, municipality, or other political subdivision of the state regulating the sale of tobacco products, alternative nicotine products, or vapor products.",
        "lrNumber": "4293S.01I",
