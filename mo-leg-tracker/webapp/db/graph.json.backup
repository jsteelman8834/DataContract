        "senateBillId": "622",
        "id": "bill:sb1207:261",
        "createdAt": "2026-01-16T22:29:43.525Z",
        "updatedAt": "2026-01-19T20:20:06.059Z"
      },
      "bill:sb1208:261": {
        "billNumber": "SB 1208",
        "billPrefix": "SB",
        "billSuffix": 1208,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions related to net metering",
        "briefDescription": "This act modifies provisions relating to sewage regulation.",
        "lrNumber": "5509S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "623",
        "id": "bill:sb1208:261",
        "createdAt": "2026-01-16T22:29:47.534Z",
        "updatedAt": "2026-01-19T20:20:08.052Z"
      },
      "bill:sb1209:261": {
        "billNumber": "SB 1209",
        "billPrefix": "SB",
        "billSuffix": 1209,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a tax credit for certain newspaper printing plants",
        "briefDescription": "For all tax years beginning on or after January 1, 2026, this act authorizes qualifying newspaper printing plants, as defined in the act, to claim a tax credit in an amount equal to fifty percent of the total compensation paid to pressroom and mailroom staff.",
        "lrNumber": "3836S.02I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "111",
        "id": "bill:sb1209:261",
        "createdAt": "2026-01-16T22:29:51.539Z",
        "updatedAt": "2026-01-19T20:20:30.139Z"
      },
      "bill:sb1210:261": {
        "billNumber": "SB 1210",
        "billPrefix": "SB",
        "billSuffix": 1210,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to battery recycling",
        "briefDescription": "The act creates the \"Lithium Battery Recycling and Safety Act\".",
        "lrNumber": "3831S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
