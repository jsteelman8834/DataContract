        "billSuffix": 1137,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the disclosure of vital records",
        "briefDescription": "This act repeals a provision of law permitting the Department of Health and Senior Services to disclose a listing of persons who are born or who die on a particular date upon a person's request.",
        "lrNumber": "4859S.01I",
