        "billPrefix": "SB",
        "billSuffix": 1061,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to firearms discrimination",
        "briefDescription": "This act provides that when a public entity enters into a contract with a company, as defined in the act, the company must have a written verification that it does not have a practice or policy that discriminates against a firearm entity or firearm trade association.",
        "lrNumber": "3383S.03I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:transportation_infrastructure_and_public_safety",
        "effectiveDate": "2026-08-28",
