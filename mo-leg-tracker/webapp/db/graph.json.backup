      "bill:sb1119:261": {
        "billNumber": "SB 1119",
        "billPrefix": "SB",
        "billSuffix": 1119,
        "session": "261",
        "chamber": "senate",
        "title": "Creates procedures for the appointment of commissioners to a convention called under Article V of the U.S. Constitution",
        "briefDescription": "This act creates procedures for the appointment of commissioners to a convention called under Article V of the U.S. Constitution.  Such commissioners shall be appointed by the General Assembly and the act creates a joint legislative committee to submit names to the General Assembly to be considered for appointment.  The joint legislative committee shall also submit instructions governing the duties of the commissioners at the convention to the General Assembly for its approval.",
        "lrNumber": "5009S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:rules_joint_rules_resolutions_and_ethics",
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-15",
        "withdrawn": false,
