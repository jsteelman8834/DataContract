      "bill:sb1058:261": {
        "billNumber": "SB 1058",
        "billPrefix": "SB",
        "billSuffix": 1058,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the classification of certain plants",
        "briefDescription": "This act provides that helianthus annuus shall not be considered an agricultural crop for the purposes of chapter 89 relating to local planning and zoning.",
        "lrNumber": "4357S.04I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:judiciary_and_civil_and_criminal_jurisprudence",
