      "bill:sb1089:261": {
        "billNumber": "SB 1089",
        "billPrefix": "SB",
        "billSuffix": 1089,
        "session": "261",
        "chamber": "senate",
        "title": "Requires health benefit plans providing for maternity benefits to cover a home blood pressure monitoring device and associated services for pregnant and postpartum women",
        "briefDescription": "This act provides that health benefit plans providing for maternity benefits shall provide coverage for a home blood pressure monitoring device and home blood pressure monitoring device services, as defined in the act, for pregnant and postpartum women.",
        "lrNumber": "3853S.01I",
        "currentStatus": "referred",
        "currentCommittee": "committee:senate:insurance_and_banking",
        "effectiveDate": "2026-08-28",
