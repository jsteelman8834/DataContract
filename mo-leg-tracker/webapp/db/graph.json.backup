      "bill:sb997:261": {
        "billNumber": "SB 997",
        "billPrefix": "SB",
        "billSuffix": 997,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies the offense of murder in the second degree to include when a person delivered or distributes fentanyl to another person where death results from such use",
        "briefDescription": "This act provides that the offense of murder in the second degree shall includes when a person delivers or distributes fentanyl or any analogue thereof to another person where death results from the use of fentanyl or an analogue thereof.",
        "lrNumber": "5486S.01I",
