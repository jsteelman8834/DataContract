        "billPrefix": "SB",
        "billSuffix": 1483,
        "session": "261",
        "chamber": "senate",
        "title": "Creates, repeals, and modifies provisions relating to elementary and secondary schools",
        "briefDescription": "This act creates, repeals, and modifies provisions relating to elementary and secondary schools.",
        "lrNumber": "5947S.01I",
