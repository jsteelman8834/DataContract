        "billSuffix": 1468,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to civil jurisprudence",
        "briefDescription": "This act modifies provisions relating to civil jurisprudence, including income and principal of endowed care trust funds, no-contest clauses in trust instruments, Missouri Uniform Fiduciary Income and Principal Act, property exempt from attachment and execution in bankruptcy, and awards of attorney's fees in agency proceedings.",
        "lrNumber": "6242S.01I",
