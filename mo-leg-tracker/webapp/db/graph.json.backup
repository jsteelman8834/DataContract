      "bill:sb1005:261": {
        "billNumber": "SB 1005",
        "billPrefix": "SB",
        "billSuffix": 1005,
        "session": "261",
        "chamber": "senate",
        "title": "Creates a provision relating to pesticide labeling requirements",
        "briefDescription": "Under the act, any pesticide registered by certain federal agencies or a pesticide label consistent with certain federal pesticide labeling requirements shall satisfy any warning label requirement regarding cancer under any other provision of current law.",
        "lrNumber": "5674S.01I",
        "currentStatus": "referred",
