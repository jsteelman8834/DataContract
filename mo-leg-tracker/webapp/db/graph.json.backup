      "bill:sb1279:261": {
        "billNumber": "SB 1279",
        "billPrefix": "SB",
        "billSuffix": 1279,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies an income tax deduction for contributions to 529 savings accounts",
        "briefDescription": "Current law authorizes an income tax deduction for contributions made to a 529 savings account, with such deduction limited to $8,000 for single filers and $16,000 for married filing combined filers. This act removes the limits such that 100% of such contributions shall be deductible.",
        "lrNumber": "5303S.01I",
