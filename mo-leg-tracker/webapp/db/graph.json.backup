        "createdAt": "2026-01-16T22:32:00.021Z",
        "updatedAt": "2026-01-19T20:22:34.566Z"
      },
      "bill:sb1242:261": {
        "billNumber": "SB 1242",
        "billPrefix": "SB",
        "billSuffix": 1242,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the Missouri Crime Victims Fund",
        "briefDescription": "This act establishes the \"Missouri Crime Victims Fund\", which shall consist of moneys appropriated by the General Assembly. Moneys in the fund shall be disbursed to entitlement jurisdictions, eligible entities, or local governmental entities that are eligible for victim assistance grants under the federal Victims of Crime Act.",
        "lrNumber": "5181S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "124",
        "id": "bill:sb1242:261",
        "createdAt": "2026-01-16T22:32:04.023Z",
        "updatedAt": "2026-01-19T20:22:36.567Z"
      },
      "bill:sb1243:261": {
        "billNumber": "SB 1243",
        "billPrefix": "SB",
        "billSuffix": 1243,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies Supreme Court Rules on conditions of release from custody in criminal proceedings",
        "briefDescription": "This act amends Supreme Court Rule 33.01 relating to conditions of release from custody in criminal proceedings. Currently, when considering the least restrictive condition for release, the court shall first consider non-monetary conditions and may only consider monetary conditions if the non-monetary conditions alone will not secure the appearance of the defendant or the safety of the community or certain persons. After considering the defendant's ability to pay, a monetary condition fixed at m",
        "lrNumber": "4489S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2027-01-01",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "233",
        "id": "bill:sb1243:261",
        "createdAt": "2026-01-16T22:32:08.048Z",
        "updatedAt": "2026-01-19T20:22:38.568Z"
      },
      "bill:sb1244:261": {
        "billNumber": "SB 1244",
        "billPrefix": "SB",
        "billSuffix": 1244,
        "session": "261",
        "chamber": "senate",
        "title": "Prohibits state agencies from using the term \"West Bank\" in official government materials and instead requires the area to be referred to as Judea and Samaria",
        "briefDescription": "This act requires a state agency to refer to Judea and Samaria in any official government material and to not use the term \"West Bank\".  A state agency shall not use state moneys to create any official government material that refers to Judea and Samaria as \"West Bank\".  The act authorizes the director of a state agency to waive the provisions of the act if it is in the best interests of the state and notice is provided to the President Pro Tem of the Senate and the Speaker of the House of Repre",
        "lrNumber": "5345S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "587",
        "id": "bill:sb1244:261",
        "createdAt": "2026-01-16T22:32:12.064Z",
        "updatedAt": "2026-01-19T20:22:40.576Z"
      },
      "bill:sb1245:261": {
        "billNumber": "SB 1245",
        "billPrefix": "SB",
        "billSuffix": 1245,
        "session": "261",
        "chamber": "senate",
        "title": "Creates a preference for veterans in the awarding of public contracts",
        "briefDescription": "This act creates new provisions establishing a preference in state contracts for certain military veteran-owned enterprise.",
        "lrNumber": "5043S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
