      "bill:sb1347:261": {
        "billNumber": "SB 1347",
        "billPrefix": "SB",
        "billSuffix": 1347,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the Supplemental Nutrition Assistance Program",
        "briefDescription": "Under this act, the Director of the Department of Social Services shall request a waiver from the U.S. Department of Agriculture to exclude candy, prepared desserts, and certain beverages from the definition of eligible Supplement Nutrition Assistance Program (SNAP) foods.  If the waiver is granted, then the Director shall prohibit the purchase of such foods with SNAP benefits.  If the waiver is not granted, then the Director shall annually apply for the waiver until it is granted.",
        "lrNumber": "4251S.01I",
