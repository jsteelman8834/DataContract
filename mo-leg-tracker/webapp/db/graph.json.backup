        "updatedAt": "2026-01-19T20:40:08.315Z"
      },
      "bill:sb1507:261": {
        "billNumber": "SB 1507",
        "billPrefix": "SB",
        "billSuffix": 1507,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to child custody",
        "briefDescription": "Under this act, the obligation of a parent ordered to pay child support shall abate, in whole or in part, if the other parent has permanently transferred custody of the child to a third party without first obtaining court approval.",
        "lrNumber": "3373S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "74585",
