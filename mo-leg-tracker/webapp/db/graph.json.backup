        "createdAt": "2026-01-16T22:44:38.625Z",
        "updatedAt": "2026-01-19T20:35:15.259Z"
      },
      "bill:sb1431:261": {
        "billNumber": "SB 1431",
        "billPrefix": "SB",
        "billSuffix": 1431,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes the \"Missouri Building Codes Act\"",
        "briefDescription": "This act establishes the \"Missouri Building Codes Act\".",
        "lrNumber": "5985S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19768",
        "id": "bill:sb1431:261",
        "createdAt": "2026-01-16T22:44:42.682Z",
        "updatedAt": "2026-01-19T20:35:17.259Z"
      },
      "bill:sb1432:261": {
        "billNumber": "SB 1432",
        "billPrefix": "SB",
        "billSuffix": 1432,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the Missouri Gaming Commission",
        "briefDescription": "Current law imposes an admission fee of $2 for each person embarking on an excursion gambling boat. This act authorizes the Missouri Gaming Commission to annually adjust such fee for inflation. (Section 313.805 and 313.820)",
        "lrNumber": "6015S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19770",
        "id": "bill:sb1432:261",
        "createdAt": "2026-01-16T22:44:46.693Z",
        "updatedAt": "2026-01-19T20:35:19.261Z"
      },
      "bill:sb1433:261": {
        "billNumber": "SB 1433",
        "billPrefix": "SB",
        "billSuffix": 1433,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a sales tax exemption for diabetic supplies",
        "briefDescription": "This act authorizes a sales tax exemption for the sale of all diabetic supplies, as defined in the act.",
        "lrNumber": "6014S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19774",
        "id": "bill:sb1433:261",
        "createdAt": "2026-01-16T22:44:50.680Z",
        "updatedAt": "2026-01-19T20:35:21.268Z"
      },
      "bill:sb1434:261": {
        "billNumber": "SB 1434",
        "billPrefix": "SB",
        "billSuffix": 1434,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a tax credit for certain firearm safety training courses",
        "briefDescription": "This act authorizes a tax credit for one hundred percent of the costs incurred by a taxpayer for enrolling the taxpayer's qualified youth in a qualified firearm safety course, as such terms are defined in the act. No tax credit shall exceed $100 per eligible youth per tax year. Tax credits authorized by the act shall be refundable, and shall not be transferred, sold, or assigned.",
        "lrNumber": "6023S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19775",
        "id": "bill:sb1434:261",
        "createdAt": "2026-01-16T22:44:54.732Z",
        "updatedAt": "2026-01-19T20:35:23.281Z"
      },
      "bill:sb1435:261": {
        "billNumber": "SB 1435",
        "billPrefix": "SB",
        "billSuffix": 1435,
        "session": "261",
        "chamber": "senate",
        "title": "Increases the size of the Labor and Industrial Relations Commission from 3 to 5 members",
        "briefDescription": "This act increases the membership of the Labor and Industrial Relations Commission from 3 members to 5 members.",
        "lrNumber": "6059S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19776",
        "id": "bill:sb1435:261",
        "createdAt": "2026-01-16T22:44:58.704Z",
        "updatedAt": "2026-01-19T20:35:25.292Z"
      },
      "bill:sb1436:261": {
        "billNumber": "SB 1436",
        "billPrefix": "SB",
        "billSuffix": 1436,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to gas safety requirements in certain buildings",
        "briefDescription": "The act provides that all covered buildings, as defined in the act, shall have at least one fuel gas alarm in each room containing a gas appliance in accordance with the fuel gas alarm manufacturer's instructions and safety standards, as described in the act.",
        "lrNumber": "6214S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19773",
        "id": "bill:sb1436:261",
        "createdAt": "2026-01-16T22:45:02.714Z",
        "updatedAt": "2026-01-19T20:35:27.318Z"
      },
      "bill:sb1437:261": {
        "billNumber": "SB 1437",
        "billPrefix": "SB",
        "billSuffix": 1437,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to repeat offenders",
        "briefDescription": "This act modifies and creates provisions relating to charging and sentencing repeat offenders.",
        "lrNumber": "5971S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19779",
        "id": "bill:sb1437:261",
        "createdAt": "2026-01-16T22:45:06.733Z",
        "updatedAt": "2026-01-19T20:35:29.309Z"
      },
      "bill:sb1438:261": {
        "billNumber": "SB 1438",
        "billPrefix": "SB",
        "billSuffix": 1438,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions regarding motor vehicle liability insurance",
        "briefDescription": "This act modifies the required amount of motor vehicle liability insurance.  The required amount of coverage for bodily injury or death is increased from $25,000 to $50,000 for one person, and from $50,000 to $100,000 for bodily injury or death to two or more persons in any one accident, and from $25,000 to $50,000 for injury to or destruction of property of others in any one accident.  Currently, any underinsured motor vehicle coverage with less than two times the limits for bodily injury or de",
        "lrNumber": "6083S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19780",
        "id": "bill:sb1438:261",
        "createdAt": "2026-01-16T22:45:10.750Z",
        "updatedAt": "2026-01-19T20:35:31.301Z"
      },
      "bill:sb1439:261": {
        "billNumber": "SB 1439",
        "billPrefix": "SB",
        "billSuffix": 1439,
        "session": "261",
        "chamber": "senate",
        "title": "Creates the \"Missouri Entrepreneurial Freedom Restoration Act\"",
        "briefDescription": "This act creates the \"Missouri Entrepreneurial Freedom Restoration Act\".  The act provides that the right to earn a living in the businesses, professions, occupations, and trades of life is a fundamental right.  State and local governments shall not burden a person's exercise of their right to earn a living. Governmental restrictions that burden the right to earn a living shall make the governmental body liable for legal and equitable relief.  Government restrictions that burden the right to ear",
        "lrNumber": "5911S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19781",
        "id": "bill:sb1439:261",
        "createdAt": "2026-01-16T22:45:28.071Z",
        "updatedAt": "2026-01-19T20:35:53.440Z"
      },
      "bill:sb1440:261": {
        "billNumber": "SB 1440",
        "billPrefix": "SB",
        "billSuffix": 1440,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies an income tax deduction for contributions to 529 savings accounts",
        "briefDescription": "Current law authorizes an income tax deduction for contributions made to the Missouri Higher Education Deposit Program, the Missouri Education Program, or to any other qualified tuition program established under 26 U.S.C. Section 529. For all tax years beginning on or after January 1, 2026, this act removes references to other federal 529 qualified tuition programs so that contributions made to such programs in other states shall not qualify for a Missouri income tax deduction.",
        "lrNumber": "5848S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19786",
        "id": "bill:sb1440:261",
        "createdAt": "2026-01-16T22:45:45.174Z",
        "updatedAt": "2026-01-19T20:35:55.388Z"
      },
      "bill:sb1441:261": {
        "billNumber": "SB 1441",
        "billPrefix": "SB",
        "billSuffix": 1441,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions regarding motor vehicle safety inspections",
        "briefDescription": "This act provides that the Department of Revenue shall retain vehicle odometer information for certain vehicles that are \"model year 2013 or newer\" rather than \"ten years of age or less\" with regard to the requirement of such vehicles to have motor vehicle safety inspections.",
        "lrNumber": "6118S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19787",
        "id": "bill:sb1441:261",
        "createdAt": "2026-01-16T22:46:02.282Z",
        "updatedAt": "2026-01-19T20:35:57.395Z"
      },
      "bill:sb1442:261": {
        "billNumber": "SB 1442",
        "billPrefix": "SB",
        "billSuffix": 1442,
        "session": "261",
        "chamber": "senate",
        "title": "Creates, repeals, and modifies provisions relating to literacy of elementary school students",
        "briefDescription": "This act creates, repeals, and modifies provisions relating to literacy of elementary school students.",
        "lrNumber": "6063S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19788",
        "id": "bill:sb1442:261",
        "createdAt": "2026-01-16T22:46:19.498Z",
        "updatedAt": "2026-01-19T20:35:59.396Z"
      },
      "bill:sb1443:261": {
        "billNumber": "SB 1443",
        "billPrefix": "SB",
        "billSuffix": 1443,
        "session": "261",
        "chamber": "senate",
        "title": "Authorizes a tax credit for certain capital investments",
        "briefDescription": "The Missouri Works program is currently authorized to provide various incentives for the creation and retention of new and existing jobs. This act authorizes the Department of Economic Development to issue tax credits to qualified companies that expend at least $50 million in new capital investments for a project within two years of submitting a notice of intent with the Department.",
        "lrNumber": "5936S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19778",
        "id": "bill:sb1443:261",
        "createdAt": "2026-01-16T22:46:36.547Z",
        "updatedAt": "2026-01-19T20:36:01.404Z"
      },
      "bill:sb1444:261": {
        "billNumber": "SB 1444",
        "billPrefix": "SB",
        "billSuffix": 1444,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to artificial intelligence in mental health",
        "briefDescription": "The act provides that no person or entity that develops or deploys artificial intelligence (AI) shall advertise or represent to the public that the AI is or is able to act as a mental health professional or is capable of providing therapy services.",
        "lrNumber": "5255S.03I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19771",
        "id": "bill:sb1444:261",
        "createdAt": "2026-01-16T22:46:53.442Z",
        "updatedAt": "2026-01-19T20:36:03.426Z"
      },
      "bill:sb1445:261": {
        "billNumber": "SB 1445",
        "billPrefix": "SB",
        "billSuffix": 1445,
        "session": "261",
        "chamber": "senate",
        "title": "Provides that certified registered nurse anesthetists may select, issue orders for, and administer certain controlled substances",
        "briefDescription": "This act provides that a certified registered nurse anesthetist (\"CRNA\") may select, issue orders for, and administer certain controlled substances for and during the course of providing anesthesia care to a patient in a licensed facility pursuant to state law. This act shall not be construed as authorizing a CRNA to prescribe such controlled substances and a CRNA shall not be required to obtain a certificate of controlled substance prescriptive authority from the Board of Nursing in order to ex",
        "lrNumber": "4989S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19772",
        "id": "bill:sb1445:261",
        "createdAt": "2026-01-16T22:46:57.395Z",
        "updatedAt": "2026-01-19T20:36:05.428Z"
      },
      "bill:sb1446:261": {
        "billNumber": "SB 1446",
        "billPrefix": "SB",
        "billSuffix": 1446,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to special elections to fill vacancies in the General Assembly",
        "briefDescription": "Current law provides that the Governor shall, without delay, issue a writ of election to fill any vacancy in the General Assembly upon receipt of any resignation or notice of vacancy, or if satisfied of the death of any member of either house, during the recess. This act requires such special election to be held at least fifty days but not more than six months after receipt of the resignation or notice of vacancy.",
        "lrNumber": "6058S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19777",
        "id": "bill:sb1446:261",
        "createdAt": "2026-01-16T22:47:01.370Z",
        "updatedAt": "2026-01-19T20:36:07.444Z"
      },
      "bill:sb1447:261": {
        "billNumber": "SB 1447",
        "billPrefix": "SB",
        "billSuffix": 1447,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to health care provider participation in health insurance plans",
        "briefDescription": "This act creates the \"Patients First Act\", which directs the Department of Commerce and Insurance to implement and enforce certain provisions of the federal Public Health Service Act.  Insurers shall not discriminate with respect to participation under the plan or coverage against any health care provider who is acting within the scope of that provider's license or certification under state law.",
        "lrNumber": "5951S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19782",
        "id": "bill:sb1447:261",
        "createdAt": "2026-01-16T22:47:05.391Z",
        "updatedAt": "2026-01-19T20:36:09.445Z"
      },
      "bill:sb1448:261": {
        "billNumber": "SB 1448",
        "billPrefix": "SB",
        "billSuffix": 1448,
        "session": "261",
        "chamber": "senate",
        "title": "Creates provisions relating to cost-sharing under health benefit plans",
        "briefDescription": "This act provides that when calculating an enrollee's overall contribution to an out-of-pocket max or any cost-sharing requirement under a health benefit plan, a health carrier or pharmacy benefits manager shall include any amounts paid by the enrollee or paid on behalf of the enrollee for any medication for which a generic substitute is not available.",
        "lrNumber": "5948S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19783",
        "id": "bill:sb1448:261",
        "createdAt": "2026-01-16T22:47:22.640Z",
        "updatedAt": "2026-01-19T20:36:11.446Z"
      },
      "bill:sb1449:261": {
        "billNumber": "SB 1449",
        "billPrefix": "SB",
        "billSuffix": 1449,
        "session": "261",
        "chamber": "senate",
        "title": "Enacts provisions relating to insurance coverage of alternatives to opioid drugs",
        "briefDescription": "This act provides that an enrollee's health benefit plan shall not deny coverage of a nonopioid prescription drug in favor of an opioid drug, require the enrollee to try an opioid drug before covering the nonopioid prescription drug, or require a higher level of cost-sharing for a nonopioid prescription drug than for an opioid drug.",
        "lrNumber": "5950S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "19784",
        "id": "bill:sb1449:261",
        "createdAt": "2026-01-16T22:47:39.763Z",
        "updatedAt": "2026-01-19T20:36:33.518Z"
      },
      "bill:sb1450:261": {
        "billNumber": "SB 1450",
        "billPrefix": "SB",
        "billSuffix": 1450,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions regarding the State Legal Expense Fund",
        "briefDescription": "This act provides that the State Legal Expense Fund shall be used to pay claims or final judgments against any entity, including its members, officers, or employees, that provides foster care case management services or residential services under a contract with the state.",
        "lrNumber": "6077S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
