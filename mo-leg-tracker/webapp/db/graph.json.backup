        "createdAt": "2026-01-16T22:42:46.229Z",
        "updatedAt": "2026-01-19T20:33:18.847Z"
      },
      "bill:sb1403:261": {
        "billNumber": "SB 1403",
        "billPrefix": "SB",
        "billSuffix": 1403,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to security of the state capitol",
        "briefDescription": "This act provides that the Commissioner of the Office of Administration shall provide state capitol access keys or key cards to spouses and children of members of the General Assembly upon written request of the member.",
        "lrNumber": "5191S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": "2026-08-28",
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
