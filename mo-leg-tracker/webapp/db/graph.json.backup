      "bill:sjr65:261": {
        "billNumber": "SJR 65",
        "billPrefix": "SJR",
        "billSuffix": 65,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to initiative petitions",
        "briefDescription": "Under current law, an initiative petition proposing a constitutional amendment must contain a single subject and matters properly connected therewith. This constitutional amendment, if approved by the voters, would additionally stipulate that an initiative petition proposing a constitutional amendment contains a single subject only if it does not extend beyond one sole purpose and only contains additions or changes that are necessary to effectuate a single legislative change.",
        "lrNumber": "3842S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "77",
        "id": "bill:sjr65:261",
        "createdAt": "2026-01-16T23:02:12.715Z",
        "updatedAt": "2026-01-19T20:44:47.537Z"
      },
      "bill:sjr66:261": {
        "billNumber": "SJR 66",
        "billPrefix": "SJR",
        "billSuffix": 66,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to property taxes",
        "briefDescription": "This constitutional amendment, if approved by the voters, provides that the amount by which the tax liability actually owed on real property may increase over the tax liability owed on such property during the previous year may be limited by law. Any limits authorized pursuant to this amendment may include limits on the actual tax liability owed or limits on increases made to the assessed value of such property.",
        "lrNumber": "3846S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "78",
        "id": "bill:sjr66:261",
        "createdAt": "2026-01-16T23:02:16.345Z",
        "updatedAt": "2026-01-19T20:44:49.488Z"
      },
      "bill:sjr67:261": {
        "billNumber": "SJR 67",
        "billPrefix": "SJR",
        "billSuffix": 67,
        "session": "261",
        "chamber": "senate",
        "title": "Provides that the Director of the Department of Transportation shall be appointed by the Governor",
        "briefDescription": "This constitutional amendment, subject to voter approval,  specifies that the Director of the Department of Transportation shall be appointed by the Governor with the advice and consent of the Senate, with qualifications to be fixed by law, and that the Highways and Transportation Commission shall advise the Governor regarding transportation matters and the Department of Transportation.",
        "lrNumber": "5650S.01I",
        "currentStatus": "first_read",
        "currentCommittee": null,
        "effectiveDate": null,
        "introducedDate": null,
        "lastActionDate": "2026-01-07",
        "withdrawn": false,
        "senateBillId": "519",
