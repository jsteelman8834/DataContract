        "lastActionDate": "2026-01-08",
        "withdrawn": false,
        "senateBillId": "290",
        "id": "bill:sb999:261",
        "createdAt": "2026-01-16T22:15:35.619Z",
        "updatedAt": "2026-01-19T20:06:26.817Z"
