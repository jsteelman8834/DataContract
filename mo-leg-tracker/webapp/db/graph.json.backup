      "bill:sb1079:261": {
        "billNumber": "SB 1079",
        "billPrefix": "SB",
        "billSuffix": 1079,
        "session": "261",
        "chamber": "senate",
        "title": "Modifies provisions relating to the Show MO tax credit",
        "briefDescription": "Current law authorizes a tax credit for certain motion media production projects, with $8 million per year allowed for film production, and $8 million per year allowed for series production. This act provides that, for all tax years beginning on or after January 1, 2027, a total of $16 million per year may be authorized with no specific limits for either film or series production.",
        "lrNumber": "5522S.01I",
        "currentStatus": "referred",
