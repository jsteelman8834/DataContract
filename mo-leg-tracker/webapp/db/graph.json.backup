        "billPrefix": "SB",
        "billSuffix": 1136,
        "session": "261",
        "chamber": "senate",
        "title": "Establishes provisions relating to the reconsideration of materials in a public library or public school library",
        "briefDescription": "This act establishes provisions relating to the reconsideration of materials in a public library or public school library.",
        "lrNumber": "4735S.01I",
