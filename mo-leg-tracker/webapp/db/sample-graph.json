    "summaries": {
      "summary:sb834:261:ai": {
        "id": "summary:sb834:261:ai",
        "billId": "bill:sb834:261",
        "versionId": "version:4894S.01I",
        "summaryType": "ai_generated",
        "plainLanguage": "This bill sets rules for when banks modify home loans. If your mortgage terms change (like interest rate or payment amount), the bank keeps its legal claim on your house. The bank doesn't have to file new paperwork at the courthouse for every change. This protects both homeowners and banks during loan modifications.",
        "technicalSummary": "Establishes the Uniform Mortgage Modification Act. Modified mortgages continue securing underlying obligations. Modifications do not affect mortgage priority or lien position regardless of public recording. Modifications excluded from novation classification. Supersedes federal E-SIGN Act provisions with limited exceptions.",
        "keyProvisions": [
          "Modified mortgages maintain priority status",
          "No recording requirement for modifications",
          "Lien position preserved regardless of modification terms",
          "Exemption from novation rules"
        ],
        "affectedStatutes": [
          "443.005",
          "443.010"
        ],
        "pdfUrl": null,
        "createdAt": "2026-01-16T04:30:00Z"
