{
  "name": "mo-leg-sync",
  "version": "1.0.0",
  "description": "Missouri Legislative Data Sync - Automated data ingestion from official sources",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node index.ts",
    "sync:full": "ts-node index.ts full",
    "sync:incremental": "ts-node index.ts incremental",
    "sync:bill": "ts-node index.ts bill",
    "sync:status": "ts-node index.ts status",
    "sync:text": "ts-node sync-bill-text.ts",
    "sync:text:status": "ts-node sync-bill-text.ts status",
    "sync:validate": "ts-node scripts/validate.ts",
    "scheduler:start": "ts-node -e \"require('./scheduler').runStandalone()\"",
    "lint": "eslint . --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.0.0",
    "cheerio": "^1.0.0-rc.12",
    "fast-xml-parser": "^4.3.2",
    "gpt-tokenizer": "^2.1.0",
    "node-cron": "^3.0.0",
    "pdf-parse": "^1.1.1",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT"
}
